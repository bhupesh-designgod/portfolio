---
/* The playground card.
 *
 * A picture on a drifting gradient, standing on a reflective floor. Hover it and
 * the card dissolves, pixel by pixel, into the word PLAYGROUND. Click it and you
 * are in the playground.
 *
 * The transition is the react-bits PixelTransition mechanic, read from the
 * source (react-bits, public/r/PixelTransition-JS-CSS.json) rather than guessed:
 *
 *   1. a gridSize x gridSize grid of absolutely positioned pixels, hidden
 *   2. on enter they are switched ON one at a time in a random order, over
 *      animationStepDuration
 *   3. at that point the second layer is swapped in underneath them
 *   4. they are switched OFF again, in a *second, different* random order
 *
 * The two shuffles matter. Reusing one order makes the pixels uncover in the
 * same sequence they covered, which reads as a wipe rather than a dissolve.
 *
 * Theirs is GSAP toggling `display`; this is the Web Animations API toggling
 * opacity over one millisecond, which is the same hard on/off without the
 * dependency. Their default step is 0.3s and grid is 7x7; this is 0.3s over
 * 8x11, because the card is portrait and square pixels want a portrait grid.
 */
interface Props {
  src?: string;
  alt?: string;
  href?: string;
  label?: string;
}

const {
  src = '/assets/playground/thumb-cat.webp',
  alt = '',
  href = '/playground',
  label = 'Playground',
} = Astro.props;

/* 8 x 11 is 0.727, which is as close to the card's 0.72 as whole pixels get. */
const COLS = 8;
const ROWS = 11;
const CELLS = Array.from({ length: COLS * ROWS }, (_, i) => ({
  x: (i % COLS) * (100 / COLS),
  y: Math.floor(i / COLS) * (100 / ROWS),
}));
---

<section class="pg" id="playground">
  <div class="pg__wrap">
    <div class="pg__intro">
      <h2 class="pg__title">The playground</h2>
      <p class="pg__lead">
        Side projects, motion studies and things built for the fun of it. None of
        them need a case study. All of them are in one place.
      </p>
    </div>

    <div class="pg__stage">
      <a class="pg__card" href={href} data-pg-card>
        {/* Layer 1: the picture. */}
        <span class="pg__pic">
          <span class="pg__field" aria-hidden="true"><i></i><i></i><i></i></span>
          <img
            class="pg__art"
            src={src}
            alt={alt}
            width="684"
            height="799"
            loading="lazy"
            decoding="async"
          />
        </span>

        {/* Layer 2, revealed by the dissolve. Inert until then, so a pointer
            never lands on it and a screen reader never reads the word twice. */}
        <span class="pg__word" data-pg-word aria-hidden="true">{label}</span>

        {/* The pixels sit over both. */}
        <span class="pg__pixels" data-pg-pixels aria-hidden="true">
          {
            CELLS.map((c) => (
              <i style={`left:${c.x}%;top:${c.y}%;width:${100 / COLS}%;height:${100 / ROWS}%`} />
            ))
          }
        </span>
      </a>

      {/* The floor. The picture again, flipped and compressed, fading as it
          recedes. Hidden from the accessibility tree: it is the same content
          twice and a screen reader should meet it once. */}
      <div class="pg__floor" aria-hidden="true">
        <div class="pg__mirror">
          <span class="pg__pic">
            <span class="pg__field"><i></i><i></i><i></i></span>
            <img class="pg__art" src={src} alt="" width="684" height="799"
              loading="lazy" decoding="async" />
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const card = document.querySelector<HTMLElement>('[data-pg-card]');
  const pixels = card
    ? Array.from(card.querySelectorAll<HTMLElement>('[data-pg-pixels] i'))
    : [];

  if (card && pixels.length) {
    /* react-bits' animationStepDuration. The whole thing is twice this: cover,
       swap, uncover. */
    const STEP = 300;
    const EACH = STEP / pixels.length;

    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let on = false;
    let swap = 0;

    /* Fisher-Yates. Called twice per run so the cover order and the uncover
       order are independent — the point of the effect. */
    const shuffled = () => {
      const a = pixels.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    function run(reveal: boolean) {
      on = reveal;
      window.clearTimeout(swap);
      for (const p of pixels) for (const a of p.getAnimations()) a.cancel();

      if (still) {
        card!.dataset.on = String(reveal);
        return;
      }

      /* One millisecond, so each pixel is a hard on and off rather than a fade.
         That is what makes it read as pixels and not as a blur. */
      shuffled().forEach((p, i) =>
        p.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 1,
          delay: i * EACH,
          fill: 'forwards',
        }),
      );

      /* Swapped while every pixel is covering it, which is the whole trick. */
      swap = window.setTimeout(() => {
        card!.dataset.on = String(reveal);
      }, STEP);

      shuffled().forEach((p, i) =>
        p.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 1,
          delay: STEP + i * EACH,
          fill: 'forwards',
        }),
      );
    }

    /* Pointer, and keyboard focus, the way the source does it. */
    card.addEventListener('pointerenter', () => {
      if (!on) run(true);
    });
    card.addEventListener('pointerleave', () => {
      if (on) run(false);
    });
    card.addEventListener('focus', () => {
      if (!on) run(true);
    });
    card.addEventListener('blur', () => {
      if (on) run(false);
    });
  }
</script>

<style>
  .pg {
    position: relative;
    z-index: 3;
    background: #fff;
    padding: 104px 8% 116px;
    color: #0b0d12;
  }
  .pg__wrap {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 56px;
  }

  .pg__title {
    margin: 0;
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: 1px;
  }
  .pg__lead {
    max-width: 46ch;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.62;
    color: #4a4f5c;
  }

  /* -------------------------------- the card ------------------------------- */
  .pg__stage {
    position: relative;
    width: 330px;
  }
  .pg__card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 0.72 / 1;
    overflow: hidden;
    border-radius: 12px;
    background: #fbf7f9;
    text-decoration: none;
    box-shadow: 0 26px 60px rgba(20, 28, 56, 0.15);
  }
  .pg__card:focus-visible {
    outline: 2px solid var(--blue-500);
    outline-offset: 6px;
  }

  .pg__pic {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
  }
  /* Both layers are always present and one of them is simply not displayed, so
     the swap at the midpoint costs no layout and cannot flash. */
  .pg__card[data-on='true'] .pg__pic {
    display: none;
  }

  /* ------------------------------ the gradient ----------------------------- */
  .pg__field {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #fdf6f8 0%, #f7f2fb 55%, #eef3fe 100%);
  }
  .pg__field i {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(38px);
    will-change: transform;
  }
  .pg__field i:nth-child(1) {
    width: 78%;
    height: 62%;
    left: -14%;
    top: -8%;
    background: radial-gradient(closest-side, rgba(255, 176, 200, 0.85), transparent);
    animation: pg-drift-a 21s ease-in-out infinite alternate;
  }
  .pg__field i:nth-child(2) {
    width: 86%;
    height: 58%;
    right: -20%;
    top: 24%;
    background: radial-gradient(closest-side, rgba(255, 205, 168, 0.8), transparent);
    animation: pg-drift-b 27s ease-in-out infinite alternate;
  }
  .pg__field i:nth-child(3) {
    width: 92%;
    height: 60%;
    left: -10%;
    bottom: -14%;
    background: radial-gradient(closest-side, rgba(178, 200, 255, 0.75), transparent);
    animation: pg-drift-c 33s ease-in-out infinite alternate;
  }

  @keyframes pg-drift-a {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(22%, 26%) scale(1.18); }
  }
  @keyframes pg-drift-b {
    from { transform: translate(0, 0) scale(1.1); }
    to { transform: translate(-26%, 18%) scale(0.9); }
  }
  @keyframes pg-drift-c {
    from { transform: translate(0, 0) scale(0.95); }
    to { transform: translate(18%, -22%) scale(1.22); }
  }

  .pg__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }

  /* --------------------------- the revealed word --------------------------- */
  .pg__word {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    place-content: center;
    padding: 0 8%;
    background: var(--blue-500);
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 54px;
    line-height: 0.94;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
    color: #fff;
  }
  .pg__card[data-on='true'] .pg__word {
    display: grid;
  }

  /* ------------------------------- the pixels ------------------------------ */
  .pg__pixels {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .pg__pixels i {
    position: absolute;
    display: block;
    opacity: 0;
    background: var(--blue-500);
  }

  /* -------------------------------- the floor ------------------------------ */
  .pg__floor {
    /* 0.72 wide against 0.40 of the card's height: the compression you get
       looking at a floor from standing height. */
    aspect-ratio: 0.72 / 0.4;
    overflow: hidden;
    filter: blur(2px);
    opacity: 0.62;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    pointer-events: none;
  }
  /* Flipped about its own top edge and squashed to 40%, so the top of the
     reflection is the bottom of the card, which is where the two meet.

     The translate is load-bearing and easy to miss. Transforms apply
     right-to-left: translateY(-100%) lifts the element by its own height so it
     sits entirely above the origin, and scaleY(-0.4) then maps it back down into
     the box. Without it the flip throws the content above the origin, where the
     floor's overflow: hidden clips every pixel and the reflection is absent. */
  .pg__mirror {
    position: relative;
    width: 100%;
    aspect-ratio: 0.72 / 1;
    transform: scaleY(-0.4) translateY(-100%);
    transform-origin: 50% 0;
  }
  /* The floor keeps showing the picture. It is a reflection of the card as it
     stands, not of what the pointer is doing to it. */
  .pg__mirror .pg__pic {
    display: block;
  }

  @media (max-width: 900px) {
    .pg {
      padding: 72px 6% 88px;
    }
    .pg__wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .pg__title {
      font-size: 44px;
    }
    .pg__stage {
      width: min(100%, 330px);
      margin: 34px auto 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg__field i {
      animation: none;
    }
  }
</style>
