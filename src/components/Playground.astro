---
/* The playground door.
 *
 * One doorway on the right, showing a reel of side work through it, standing on
 * a reflective floor. Click it and you are in the playground.
 *
 * The reference for this is the pmndrs image-gallery demo, which is
 * react-three-fiber with a MeshReflectorMaterial floor. That is the right tool
 * when the camera moves and the geometry is real. Here the door faces the camera
 * and never turns, so the whole effect is a rectangle, a mirrored copy of the
 * same frames, and a gradient — which the DOM does for about two kilobytes
 * instead of putting React, three and drei on a page that currently ships almost
 * no JavaScript. Same picture, and the video stays a real <video> element the
 * browser can decode in hardware rather than a texture uploaded every frame.
 *
 * The reflection is drawn rather than faked with a second <video>: one decode,
 * one small canvas, flipped in the draw call. Two video elements pointing at the
 * same file is two decodes, which on a phone is the difference between free and
 * noticeable.
 */
interface Props {
  /** The reel shown through the door. Swap the file, keep the path. */
  src?: string;
  href?: string;
}

const { src = '/assets/playground/reel.mp4', href = '/playground' } = Astro.props;
---

<section class="pg" id="playground">
  <div class="pg__wrap">
    <div class="pg__intro">
      <h2 class="pg__title">The playground</h2>
      <p class="pg__lead">
        Side projects, motion studies and things built for the fun of it. None of
        them need a case study. All of them are in one place.
      </p>
    </div>

    <div class="pg__stage">
      {/* The light itself. Two soft fields rather than an outline: one behind
          the doorway spilling onto the wall, one pooling on the floor in front
          of it. Both are blurred blobs, not copies of the door's shape, because
          anything that traces the edge reads as a border however soft it is. */}
      <span class="pg__bloom" aria-hidden="true"></span>
      <span class="pg__pool" aria-hidden="true"></span>

      <a class="pg__door" href={href} data-pg-door>
        {/* Behind the video, so the door is a door even before the file loads
            or if autoplay is refused. */}
        <span class="pg__ground" aria-hidden="true"></span>

        <video
          class="pg__reel"
          data-pg-video
          src={src}
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"></video>

        {/* The wash. Idle it is invisible; on hover the doorway fills with
            light, which is the whole metaphor and also what makes the label
            readable without a scrim sitting over the reel the rest of the time. */}
        <span class="pg__wash" aria-hidden="true"></span>

        <span class="pg__label">
          <span>Enter playground</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h13M12.5 6.5 19 12l-6.5 5.5"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>

      {/* The floor. A mirrored, foreshortened copy of what the door is showing,
          fading out as it recedes. */}
      <canvas class="pg__floor" data-pg-floor aria-hidden="true"></canvas>
    </div>
  </div>
</section>

<script>
  const door = document.querySelector<HTMLElement>('[data-pg-door]');
  const video = document.querySelector<HTMLVideoElement>('[data-pg-video]');
  const floor = document.querySelector<HTMLCanvasElement>('[data-pg-floor]');

  if (door && video && floor) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = floor.getContext('2d', { alpha: true });

    /* The bitmap is deliberately small. It is blurred and faded to about half
       opacity, so resolution past this buys nothing and costs a draw. */
    const W = 240;
    let H = 150;
    let raf = 0;
    let onScreen = false;

    function size() {
      const r = door!.getBoundingClientRect();
      if (!r.width) return;
      H = Math.round(W * (r.height / r.width));
      if (floor!.width !== W || floor!.height !== H) {
        floor!.width = W;
        floor!.height = H;
      }
    }

    /* Matches the door's `object-fit: cover` crop, so the reflection lines up
       with what is actually visible through the doorway rather than with the
       whole frame. A reflection of a different crop is the thing that makes
       these look wrong. */
    function draw() {
      if (!ctx || !video!.videoWidth) return;
      const vw = video!.videoWidth;
      const vh = video!.videoHeight;
      const scale = Math.max(W / vw, H / vh);
      const sw = W / scale;
      const sh = H / scale;
      const sx = (vw - sw) / 2;
      const sy = (vh - sh) / 2;

      ctx.save();
      ctx.clearRect(0, 0, W, H);
      /* Flip in the draw rather than in CSS: the element stays upright, so the
         mask and the blur below read top-to-bottom like the floor does. */
      ctx.translate(0, H);
      ctx.scale(1, -1);
      ctx.drawImage(video!, sx, sy, sw, sh, 0, 0, W, H);
      ctx.restore();
    }

    const tick = () => {
      if (!onScreen || video!.paused) {
        raf = 0;
        return;
      }
      draw();
      raf = requestAnimationFrame(tick);
    };
    const run = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    /* Nothing decodes or draws until the door is actually on screen. This sits
       in the middle of a long page and most visits never reach it. */
    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen) {
          size();
          if (!still) video!.play().then(run).catch(() => {
            /* Autoplay refused. The door keeps its gradient and the floor stays
               empty, which is a quiet door rather than a broken one. */
          });
          else {
            /* Reduced motion: one frame, held. The reflection is still correct,
               it just does not move. */
            video!.currentTime = 0.1;
            video!.addEventListener('seeked', draw, { once: true });
          }
        } else {
          video!.pause();
        }
      },
      { rootMargin: '200px' },
    ).observe(door);

    video.addEventListener('play', run);
    video.addEventListener('loadedmetadata', () => {
      size();
      draw();
    });
    window.addEventListener('resize', () => {
      size();
      draw();
    });
  }
</script>

<style>
  .pg {
    position: relative;
    z-index: 3;
    background: #fff;
    padding: 104px 8% 116px;
    color: #0b0d12;
    /* The bloom is wider than the door on purpose and the door sits against the
       right edge, so it runs past the viewport and was widening the page by up
       to 100px — a horizontal scrollbar on every breakpoint. `clip` rather than
       `hidden`: hidden makes this a scroll container, which would also crop the
       door's shadow vertically. */
    overflow-x: clip;
  }
  .pg__wrap {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 56px;
  }

  .pg__title {
    margin: 0;
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: 1px;
  }
  .pg__lead {
    max-width: 46ch;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.62;
    color: #4a4f5c;
  }

  /* -------------------------------- the door ------------------------------- */
  .pg__stage {
    /* The door and its reflection are one object; the stage is what keeps them
       joined when the column resizes, and what the light is positioned against. */
    position: relative;
    width: 330px;
  }

  /* Light on the wall. Deliberately wider and shorter than the door and pushed
     well past its edges, so what you see is a field of light with a doorway in
     it rather than a halo tracing a shape. */
  .pg__bloom {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 190%;
    height: 120%;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(214, 230, 255, 0.95),
      rgba(150, 190, 255, 0.5) 42%,
      rgba(0, 89, 255, 0.16) 68%,
      transparent 82%
    );
    filter: blur(34px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
  }

  /* And on the floor, where the doorway meets it. Flattened hard, because light
     falling on a floor you are looking across is an ellipse, not a circle. */
  .pg__pool {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 150%;
    height: 30%;
    translate: -50% -14%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(224, 236, 255, 0.9),
      rgba(120, 170, 255, 0.34) 46%,
      transparent 76%
    );
    filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.55s ease;
  }

  .pg__door {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 0.72 / 1;
    overflow: hidden;
    /* A doorway, so the top corners are rounder than the bottom ones — the
       bottom of a door meets the floor square. */
    border-radius: 165px 165px 12px 12px;
    /* No border. An opening in a wall has no stroke around it; the only thing
       that defines its edge is the difference between what is behind it and
       what is through it. */
    background: #0b0d12;
    text-decoration: none;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s ease;
    box-shadow: 0 26px 60px rgba(20, 28, 56, 0.15);
  }

  .pg__ground {
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, #1b2036, #0b0d12 62%, #05070f);
  }

  .pg__reel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Held back a little so the label stays readable over a bright frame, and
       so the door reads as a view through rather than a screen. */
    opacity: 0.82;
  }

  /* The interior when the door opens. A gradient with a bright core rather than
     flat white: light has a source, and a flat fill reads as a card that changed
     colour instead of a doorway that lit up. */
  .pg__wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      74% 58% at 50% 62%,
      #ffffff 0%,
      #f4f8ff 58%,
      #e6eeff 100%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .pg__label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', 'Nunito', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #fff;
    transition: color 0.42s ease, gap 0.35s ease;
  }
  .pg__label svg {
    width: 17px;
    height: 17px;
  }

  /* Hover: the doorway opens and light comes out of it. Nothing traces the
     edge — the shadow softens because a lit object casts less of one, and the
     light fields either side do the rest. */
  .pg__stage:has(.pg__door:hover) .pg__bloom,
  .pg__stage:has(.pg__door:focus-visible) .pg__bloom,
  .pg__stage:has(.pg__door:hover) .pg__pool,
  .pg__stage:has(.pg__door:focus-visible) .pg__pool {
    opacity: 1;
  }

  .pg__door:hover,
  .pg__door:focus-visible {
    transform: translateY(-5px);
    box-shadow: 0 30px 64px rgba(90, 140, 220, 0.2);
  }
  .pg__door:hover .pg__wash,
  .pg__door:focus-visible .pg__wash {
    opacity: 0.96;
  }
  .pg__door:hover .pg__label,
  .pg__door:focus-visible .pg__label {
    color: var(--blue-500);
    gap: 12px;
  }
  .pg__door:focus-visible {
    outline: 2px solid var(--blue-500);
    outline-offset: 8px;
  }

  /* -------------------------------- the floor ------------------------------ */
  .pg__floor {
    display: block;
    width: 100%;
    /* Foreshortened by aspect-ratio, not by a percentage height. A percentage
       height against a parent of auto height is indeterminate, so the canvas
       fell back to its bitmap's aspect and rendered a full second door hanging
       upside down instead of a floor.

       0.72 wide by 1 tall is the door; this is the same width against 0.40 of
       that height, which is the compression you get looking at a floor from
       standing height. */
    aspect-ratio: 0.72 / 0.4;
    /* Touching, because a reflection starts where the object meets the floor. */
    margin-top: 0;
    filter: blur(2.5px);
    opacity: 0.5;
    /* Fades as it recedes, and never quite reaches the bottom of its box. */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    transition: opacity 0.45s ease;
    pointer-events: none;
  }
  /* The reflection is of a dark reel. Once the doorway is lit there is nothing
     dark left to mirror, so the drawn frames fade out and the light pool takes
     over as what the floor is showing. */
  .pg__stage:has(.pg__door:hover) .pg__floor,
  .pg__stage:has(.pg__door:focus-visible) .pg__floor {
    opacity: 0.1;
  }

  @media (max-width: 900px) {
    .pg {
      padding: 72px 6% 88px;
    }
    .pg__wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .pg__title {
      font-size: 44px;
    }
    .pg__stage {
      width: min(100%, 330px);
      margin: 34px auto 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg__door,
    .pg__wash,
    .pg__label,
    .pg__floor,
    .pg__bloom,
    .pg__pool {
      transition: none;
    }
    .pg__door:hover,
    .pg__door:focus-visible {
      transform: none;
    }
  }
</style>
