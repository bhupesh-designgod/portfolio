---
/* The playground door.
 *
 * One doorway on the right: a picture floating on a slowly drifting gradient,
 * standing on a reflective floor. Click it and you are in the playground.
 *
 * The hover is the pmndrs image-gallery interaction (examples/image-gallery,
 * the Frame component). There the coloured mat is a fixed size and the picture
 * scales down inside it, so the mat thickens from underneath rather than a ring
 * growing outward:
 *
 *   image scale   rest 0.85 x 0.9  ->  hover 0.7225 x 0.8145
 *   frame (mat)   fixed at 0.9 x 0.93
 *   frame colour  white -> orange
 *
 * Against the mat rather than the outer frame that is 0.944 x 0.968 at rest and
 * 0.803 x 0.876 on hover, which is what the transforms below use. Orange is the
 * primary blue here, and white is the page, so at rest the mat is invisible and
 * the door has no border.
 *
 * The reflection is a plain DOM copy rather than the canvas this used while the
 * door held a video. Nothing in the picture moves per frame any more, so a
 * mirrored duplicate costs one image the browser has already decoded and no
 * requestAnimationFrame at all. The markup is written out twice rather than
 * shared, because Astro frontmatter is TypeScript and cannot hold markup.
 */
interface Props {
  /** The picture in the doorway. */
  src?: string;
  alt?: string;
  href?: string;
}

const {
  src = '/assets/playground/thumb.webp',
  alt = '',
  href = '/playground',
} = Astro.props;
---

<section class="pg" id="playground">
  <div class="pg__wrap">
    <div class="pg__intro">
      <h2 class="pg__title">The playground</h2>
      <p class="pg__lead">
        Side projects, motion studies and things built for the fun of it. None of
        them need a case study. All of them are in one place.
      </p>
    </div>

    <div class="pg__stage">
      <a class="pg__door" href={href}>
        <span class="pg__pic">
          <span class="pg__field" aria-hidden="true"><i></i><i></i><i></i></span>
          <img
            class="pg__art"
            src={src}
            alt={alt}
            width="900"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </span>

        <span class="pg__label">
          <span>Enter playground</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M5 12h13M12.5 6.5 19 12l-6.5 5.5"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>

      {/* The floor. The same picture, flipped and compressed, fading as it
          recedes. Hidden from the accessibility tree: it is the same content
          twice and a screen reader should meet it once. */}
      <div class="pg__floor" aria-hidden="true">
        <div class="pg__mirror">
          <span class="pg__pic">
            <span class="pg__field"><i></i><i></i><i></i></span>
            <img class="pg__art" src={src} alt="" width="900" height="1080"
              loading="lazy" decoding="async" />
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pg {
    position: relative;
    z-index: 3;
    background: #fff;
    padding: 104px 8% 116px;
    color: #0b0d12;
  }
  .pg__wrap {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 56px;
  }

  .pg__title {
    margin: 0;
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: 1px;
  }
  .pg__lead {
    max-width: 46ch;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.62;
    color: #4a4f5c;
  }

  /* -------------------------------- the door ------------------------------- */
  .pg__stage {
    position: relative;
    width: 330px;
  }

  /* The door is the mat. The picture inside it is what moves. */
  .pg__door {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 0.72 / 1;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    text-decoration: none;
    box-shadow: 0 26px 60px rgba(20, 28, 56, 0.15);
    /* maath's damp at smoothTime 0.1 is quick and does not overshoot. */
    transition: background-color 0.28s ease;
  }
  .pg__door:hover,
  .pg__door:focus-visible {
    background: var(--blue-500);
  }
  /* The mat is the focus ring; a second outline would double it up. */
  .pg__door:focus-visible {
    outline: none;
  }

  .pg__pic {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
    background: #fbf7f9;
    transform: scale(0.944, 0.968);
    transform-origin: 50% 50%;
    transition: transform 0.28s ease;
  }
  .pg__door:hover .pg__pic,
  .pg__door:focus-visible .pg__pic {
    transform: scale(0.803, 0.876);
  }

  /* ------------------------------ the gradient -----------------------------
     Three soft blobs drifting over a pale ground, each on its own long, uneven
     duration so the field never repeats on a beat you can spot. Animated with
     transform rather than background-position, which keeps it on the compositor
     instead of repainting a gradient every frame. */
  .pg__field {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #fdf6f8 0%, #f7f2fb 55%, #eef3fe 100%);
  }
  .pg__field i {
    position: absolute;
    display: block;
    border-radius: 50%;
    filter: blur(38px);
    will-change: transform;
  }
  .pg__field i:nth-child(1) {
    width: 78%;
    height: 62%;
    left: -14%;
    top: -8%;
    background: radial-gradient(closest-side, rgba(255, 176, 200, 0.85), transparent);
    animation: pg-drift-a 21s ease-in-out infinite alternate;
  }
  .pg__field i:nth-child(2) {
    width: 86%;
    height: 58%;
    right: -20%;
    top: 24%;
    background: radial-gradient(closest-side, rgba(255, 205, 168, 0.8), transparent);
    animation: pg-drift-b 27s ease-in-out infinite alternate;
  }
  .pg__field i:nth-child(3) {
    width: 92%;
    height: 60%;
    left: -10%;
    bottom: -14%;
    background: radial-gradient(closest-side, rgba(178, 200, 255, 0.75), transparent);
    animation: pg-drift-c 33s ease-in-out infinite alternate;
  }

  @keyframes pg-drift-a {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(22%, 26%) scale(1.18); }
  }
  @keyframes pg-drift-b {
    from { transform: translate(0, 0) scale(1.1); }
    to { transform: translate(-26%, 18%) scale(0.9); }
  }
  @keyframes pg-drift-c {
    from { transform: translate(0, 0) scale(0.95); }
    to { transform: translate(18%, -22%) scale(1.22); }
  }

  .pg__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* contain, not cover: it is a cut-out with transparency, and cropping it
       would take the petals off. */
    object-fit: contain;
    object-position: 50% 54%;
    padding: 7% 8%;
    box-sizing: border-box;
  }

  /* Dark, because the ground behind it is pale now. */
  .pg__label {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Inter', 'Nunito', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: #0b0d12;
  }
  .pg__label svg {
    width: 17px;
    height: 17px;
  }

  /* -------------------------------- the floor ------------------------------ */
  .pg__floor {
    /* 0.72 wide against 0.40 of the door's height: the compression you get
       looking at a floor from standing height. */
    aspect-ratio: 0.72 / 0.4;
    overflow: hidden;
    filter: blur(2px);
    /* Higher than it was with the video. That content was dark and read against
       white at 40%; a pale gradient at 40% is white on white. */
    opacity: 0.62;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 34%, transparent 82%);
    pointer-events: none;
  }
  /* Flipped about its own top edge and squashed to 40%, so the top of the
     reflection is the bottom of the door, which is where the two meet.
     
     The translate is load-bearing and easy to miss. Transforms apply
     right-to-left: translateY(-100%) lifts the element by its own height so it
     sits entirely above the origin, and scaleY(-0.4) then maps it back down
     into the box. Without it the flip throws the content above the origin,
     where the floor's overflow: hidden clips every pixel of it and the
     reflection is simply absent. */
  .pg__mirror {
    position: relative;
    width: 100%;
    aspect-ratio: 0.72 / 1;
    transform: scaleY(-0.4) translateY(-100%);
    transform-origin: 50% 0;
  }
  .pg__mirror .pg__pic {
    /* Held at the resting scale. The floor does not answer the hover, and
       matching it would mean the reflection moving while the door does. */
    transform: scale(0.944, 0.968);
  }

  @media (max-width: 900px) {
    .pg {
      padding: 72px 6% 88px;
    }
    .pg__wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .pg__title {
      font-size: 44px;
    }
    .pg__stage {
      width: min(100%, 330px);
      margin: 34px auto 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pg__door,
    .pg__pic,
    .pg__label {
      transition: none;
    }
    .pg__field i {
      animation: none;
    }
  }
</style>
