---
/* The case study hero's field.

   The same shader as the footer — the Velaris port in Footer.astro — with the
   project's accent fed in as the palette. The footer's version is what the
   whole site's motion is tuned around, so the hero borrows it rather than
   inventing a second kind of movement; what changes is only the colours,
   which come from the page's own `data-accent` tokens so a case study is
   re-themed by that one attribute and nothing else.

   Falls back to the CSS gradient field underneath it: the canvas starts
   transparent and only fades in once the first frame has drawn, so a browser
   without WebGL, or a GPU that refuses the context, never shows a hole.

   Cost control: the drawing buffer is capped at 1.25x DPR and 0.8 of the CSS
   size (the field is soft by design, so the upscale is invisible), the loop
   pauses while the hero is off screen or the tab is hidden, and reduced
   motion renders exactly one frame and stops. */
---

<canvas class="cs-field" data-cs-field aria-hidden="true"></canvas>

<script>
  const vert = `
    attribute vec2 position;
    varying vec2 vUv;
    void main() {
      vUv = position * 0.5 + 0.5;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  /* Footer.astro's fragment shader, with one addition: `u_amp` scales how far
     each colour is allowed to mix over the ground. The footer runs it at 1.0
     on a bright blue; the hero runs it lower on near-black so a white
     headline keeps its contrast over the brightest fold. */
  const frag = `
    precision highp float;
    varying vec2 vUv;

    uniform vec2  u_resolution;
    uniform float u_time;
    uniform float u_grain;
    uniform vec3  u_colors[4];
    uniform vec3  u_bg;
    uniform float u_floor;
    uniform float u_amp;

    vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }

    float snoise(vec2 v){
      const vec4 C = vec4(0.211324865405187, 0.366025403784439,
               -0.577350269189626, 0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy) );
      vec2 x0 = v -   i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod(i, 289.0);
      vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 ))
      + i.x + vec3(0.0, i1.x, 1.0 ));
      vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy),
        dot(x12.zw,x12.zw)), 0.0);
      m = m*m ;
      m = m*m ;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    void main() {
      vec2 uv = vUv;
      float ratio = u_resolution.x / u_resolution.y;
      vec2 p = uv - 0.5;
      p.x *= ratio;

      float t = u_time * 0.1;

      float n1 = snoise(p * 0.4 + vec2(t * 0.2, -t * 0.3));
      float n2 = snoise(p * 0.55 + vec2(-t * 0.15, t * 0.25) + n1 * 0.25);
      float n3 = snoise(p * 0.75 + vec2(t * 0.1, -t * 0.2) + n2 * 0.2);

      vec3 col = u_bg;

      float dist = length(p) * 1.5;
      float vignette = 1.0 - smoothstep(0.4, 2.0, dist);

      col = mix(col, u_colors[0], smoothstep(-0.2, 0.5, n1) * 0.85 * u_amp);
      col = mix(col, u_colors[1], smoothstep(-0.1, 0.6, n2) * 0.7 * u_amp);
      col = mix(col, u_colors[2], smoothstep(-0.3, 0.4, n3) * 0.6 * u_amp);
      col = mix(col, u_colors[3], smoothstep(0.0, 0.7, n1 * n2) * 0.5);

      float glow = smoothstep(0.8, 0.0, dist) * 0.3 * u_amp;
      col += u_colors[1] * glow;

      col = mix(col * u_floor, col, vignette);

      float grain = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453 + u_time);
      col += (grain - 0.5) * u_grain * 0.1;

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const hexToRgb = (hex: string): [number, number, number] => {
    const h = hex.trim().replace('#', '');
    const f = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    return [
      parseInt(f.slice(0, 2), 16) / 255,
      parseInt(f.slice(2, 4), 16) / 255,
      parseInt(f.slice(4, 6), 16) / 255,
    ];
  };

  document.querySelectorAll<HTMLCanvasElement>('[data-cs-field]').forEach((canvas) => {
    const hero = canvas.closest<HTMLElement>('.cs-hero');
    const themed = canvas.closest<HTMLElement>('[data-accent]') ?? document.body;
    if (!hero) return;

    /* State on the element, so a field that never lit up can be diagnosed
       from the inspector rather than by reading this file. */
    const state = (v: string) => canvas.setAttribute('data-state', v);

    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
    if (!gl) { state('no-gl'); return; }

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.warn('[cs-field]', gl.getShaderInfoLog(sh));
        state('shader-fail');
        return null;
      }
      return sh;
    };
    const vs = compile(gl.VERTEX_SHADER, vert);
    const fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return;

    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.warn('[cs-field]', gl.getProgramInfoLog(program));
      state('link-fail');
      return;
    }
    gl.useProgram(program);

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const pos = gl.getAttribLocation(program, 'position');
    gl.enableVertexAttribArray(pos);
    gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(program, 'u_resolution');
    const uTime = gl.getUniformLocation(program, 'u_time');

    /* The palette, from the page's accent tokens (global.css, `[data-accent]`):

         bg        --cs-g2   the hero's dark ground
         colors[0] --a-hi    light highlights
         colors[1] --a-500   the accent itself, and the centre glow
         colors[2] --a-deep  the deeper fold of the same hue
         colors[3] --cs-g3   the ground it darkens back into            */
    const cs = getComputedStyle(themed);
    const tok = (name: string, fallback: string) => cs.getPropertyValue(name).trim() || fallback;
    const BG = tok('--cs-g2', '#070709');
    const COLORS = [
      tok('--a-hi', '#ffd979'),
      tok('--a-500', '#f6b41c'),
      tok('--a-deep', '#b8820a'),
      tok('--cs-g3', '#0e0b07'),
    ];
    /* Gold is far lighter than the other accents, so the same amplitude that
       reads as a moody wash in violet reads as mustard here. */
    const accent = themed.getAttribute('data-accent') || 'gold';
    const AMP = accent === 'gold' ? 0.5 : 0.68;
    const SPEED = 2.0;
    const GRAIN = 0.3;
    const VIGNETTE_FLOOR = 0.45;

    gl.uniform1f(gl.getUniformLocation(program, 'u_grain'), GRAIN);
    gl.uniform1f(gl.getUniformLocation(program, 'u_floor'), VIGNETTE_FLOOR);
    gl.uniform1f(gl.getUniformLocation(program, 'u_amp'), AMP);
    gl.uniform3f(gl.getUniformLocation(program, 'u_bg'), ...hexToRgb(BG));
    gl.uniform3fv(gl.getUniformLocation(program, 'u_colors'), new Float32Array(COLORS.flatMap(hexToRgb)));

    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let raf = 0;
    let live = false;
    let inView = true;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.25) * 0.8;
      const w = Math.round(canvas.clientWidth * dpr);
      const h = Math.round(canvas.clientHeight * dpr);
      if (!w || !h || (canvas.width === w && canvas.height === h)) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
    };

    const draw = (t: number) => {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, t * 0.001 * SPEED);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!live) {
        live = true;
        canvas.classList.add('is-on');
        state('on');
      }
    };

    const frame = (t: number) => {
      raf = requestAnimationFrame(frame);
      draw(t);
    };
    const start = () => { if (!raf && !still) raf = requestAnimationFrame(frame); };
    const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };

    new ResizeObserver(() => {
      resize();
      if (!raf) draw(performance.now());
    }).observe(canvas);

    resize();
    /* First frame drawn synchronously rather than waiting for rAF: a tab
       opened in the background has no animation frames until it is shown,
       and a hero with no field in it is the wrong thing to show then. */
    draw(performance.now());
    start();

    new IntersectionObserver((entries) => {
      for (const e of entries) {
        inView = e.isIntersecting;
        if (inView) start();
        else stop();
      }
    }, { rootMargin: '100px' }).observe(hero);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (inView) start();
    });
  });
</script>
