---
/* Ripple simulation. Mountable more than once — each canvas runs its own
 * independent field and reads its own intensity/colour from data attributes.
 *
 * This is a real height-field wave simulation, not a drawn trail: two float
 * textures ping-pong a discrete wave equation
 *
 *     h(t+1) = 2h(t) - h(t-1) + c^2 * laplacian(h)
 *
 * The pointer injects a gaussian impulse; from there the physics carries it
 * outward, reflects off the edges, and decays. Rendering shades the surface
 * from its slope, so crests catch light and troughs darken.
 */

interface Props {
  class?: string;
  /** Shading intensity. The single dial for how present the effect is. */
  gain?: number;
  /** Colour where the surface tilts toward the light. */
  crest?: string;
  /** Colour where it tilts away. */
  trough?: string;
  /** Cap on impulse size, however fast the pointer moves. */
  maxStrength?: number;
}

const {
  class: className = '',
  gain = 0.3,
  crest = '#ffffff',
  trough = '#05123f',
  maxStrength = 0.055,
} = Astro.props;
---

<canvas
  class={`water ${className}`}
  data-water
  data-gain={gain}
  data-crest={crest}
  data-trough={trough}
  data-max-strength={maxStrength}
  aria-hidden="true"></canvas>

<script>
  const VERT = `#version 300 es
in vec2 a_pos;
out vec2 v_uv;
void main() {
  v_uv = a_pos * 0.5 + 0.5;
  gl_Position = vec4(a_pos, 0.0, 1.0);
}`;

  // r = height now, g = height last step
  const SIM = `#version 300 es
precision highp float;
in vec2 v_uv;
out vec4 outColor;
uniform sampler2D u_state;
uniform vec2  u_texel;
uniform vec2  u_mouse;
uniform float u_strength;
uniform float u_radius;

void main() {
  vec2 s = texture(u_state, v_uv).rg;
  float c = s.r;
  float p = s.g;

  float l = texture(u_state, v_uv - vec2(u_texel.x, 0.0)).r;
  float r = texture(u_state, v_uv + vec2(u_texel.x, 0.0)).r;
  float u = texture(u_state, v_uv + vec2(0.0, u_texel.y)).r;
  float d = texture(u_state, v_uv - vec2(0.0, u_texel.y)).r;

  float lap = (l + r + u + d) - 4.0 * c;

  // Verlet step of the wave equation, then damping so ripples die out
  float h = (2.0 * c - p) + lap * 0.28;
  h *= 0.9825;

  float dist = distance(v_uv, u_mouse);
  h += u_strength * exp(-(dist * dist) / (u_radius * u_radius));

  outColor = vec4(h, c, 0.0, 1.0);
}`;

  // Shade from surface slope: crests toward the light, troughs away
  const DRAW = `#version 300 es
precision highp float;
in vec2 v_uv;
out vec4 outColor;
uniform sampler2D u_state;
uniform vec2  u_texel;
uniform float u_gain;
uniform vec3  u_crest;
uniform vec3  u_trough;

void main() {
  float l = texture(u_state, v_uv - vec2(u_texel.x, 0.0)).r;
  float r = texture(u_state, v_uv + vec2(u_texel.x, 0.0)).r;
  float u = texture(u_state, v_uv + vec2(0.0, u_texel.y)).r;
  float d = texture(u_state, v_uv - vec2(0.0, u_texel.y)).r;

  vec3 n = normalize(vec3(-(r - l) * 46.0, -(u - d) * 46.0, 1.0));
  vec3 lightDir = normalize(vec3(-0.42, 0.58, 0.70));

  float shade = dot(n, lightDir) - 0.70;   // 0 on flat water
  float v = shade * u_gain;

  float a = clamp(abs(v), 0.0, 1.0);
  vec3 col = v > 0.0 ? u_crest : u_trough;

  outColor = vec4(col * a, a);             // premultiplied
}`;

  const hexToRgb = (hex: string): [number, number, number] => {
    const s = hex.replace('#', '');
    const f = s.length === 3 ? s.split('').map((c) => c + c).join('') : s;
    return [
      parseInt(f.slice(0, 2), 16) / 255,
      parseInt(f.slice(2, 4), 16) / 255,
      parseInt(f.slice(4, 6), 16) / 255,
    ];
  };

  function initWater(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl2', {
      alpha: true,
      antialias: false,
      premultipliedAlpha: true,
      depth: false,
    });
    if (!gl || !gl.getExtension('EXT_color_buffer_float')) return;

    const gain = Number(canvas.dataset.gain ?? 0.3);
    const crest = hexToRgb(canvas.dataset.crest ?? '#ffffff');
    const trough = hexToRgb(canvas.dataset.trough ?? '#05123f');
    const maxStrength = Number(canvas.dataset.maxStrength ?? 0.055);

    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        throw new Error(gl.getShaderInfoLog(sh) || 'compile failed');
      }
      return sh;
    };

    const link = (fsrc: string) => {
      const p = gl.createProgram()!;
      gl.attachShader(p, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fsrc));
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
        throw new Error(gl.getProgramInfoLog(p) || 'link failed');
      }
      return p;
    };

    const simProg = link(SIM);
    const drawProg = link(DRAW);

    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
      gl.STATIC_DRAW,
    );
    for (const p of [simProg, drawProg]) {
      const loc = gl.getAttribLocation(p, 'a_pos');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    }

    const U = {
      simState: gl.getUniformLocation(simProg, 'u_state'),
      simTexel: gl.getUniformLocation(simProg, 'u_texel'),
      simMouse: gl.getUniformLocation(simProg, 'u_mouse'),
      simStrength: gl.getUniformLocation(simProg, 'u_strength'),
      simRadius: gl.getUniformLocation(simProg, 'u_radius'),
      drawState: gl.getUniformLocation(drawProg, 'u_state'),
      drawTexel: gl.getUniformLocation(drawProg, 'u_texel'),
      drawGain: gl.getUniformLocation(drawProg, 'u_gain'),
      drawCrest: gl.getUniformLocation(drawProg, 'u_crest'),
      drawTrough: gl.getUniformLocation(drawProg, 'u_trough'),
    };

    type Target = { tex: WebGLTexture; fbo: WebGLFramebuffer };
    let targets: Target[] = [];
    let simW = 0;
    let simH = 0;
    let cw = 0;
    let ch = 0;

    function makeTarget(w: number, h: number): Target {
      const tex = gl!.createTexture()!;
      gl!.bindTexture(gl!.TEXTURE_2D, tex);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RG16F, w, h, 0, gl!.RG, gl!.HALF_FLOAT, null);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MIN_FILTER, gl!.LINEAR);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MAG_FILTER, gl!.LINEAR);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE);

      const fbo = gl!.createFramebuffer()!;
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbo);
      gl!.framebufferTexture2D(
        gl!.FRAMEBUFFER, gl!.COLOR_ATTACHMENT0, gl!.TEXTURE_2D, tex, 0,
      );
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      return { tex, fbo };
    }

    function allocate() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return false;

      // Only touch the backing store on real size changes — the hero panel
      // resizes every frame while scrolling, and reallocating would thrash.
      if (w !== cw || h !== ch) {
        cw = w;
        ch = h;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
      }

      // Sim cells stay roughly square so ripples stay circular. Quantised so
      // small aspect changes don't blow away the field mid-animation.
      const sw = 300;
      const sh = Math.max(80, Math.round((sw * h) / w / 16) * 16);
      if (sw !== simW || sh !== simH || !targets.length) {
        for (const t of targets) {
          gl!.deleteTexture(t.tex);
          gl!.deleteFramebuffer(t.fbo);
        }
        simW = sw;
        simH = sh;
        targets = [makeTarget(sw, sh), makeTarget(sw, sh)];
      }
      return true;
    }

    let mx = 0.5;
    let my = 0.5;
    let strength = 0;
    let idle = 0;
    let frame: number | null = null;

    function step() {
      if (!allocate()) {
        frame = null;
        return;
      }

      const [src, dst] = targets;
      gl!.bindVertexArray(vao);

      // --- advance the field ---
      gl!.useProgram(simProg);
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, dst.fbo);
      gl!.viewport(0, 0, simW, simH);
      gl!.disable(gl!.BLEND);
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, src.tex);
      gl!.uniform1i(U.simState, 0);
      gl!.uniform2f(U.simTexel, 1 / simW, 1 / simH);
      gl!.uniform2f(U.simMouse, mx, my);
      gl!.uniform1f(U.simStrength, strength);
      gl!.uniform1f(U.simRadius, 0.035);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);

      strength = 0; // impulse lasts a single step
      targets = [dst, src];

      // --- shade it onto the canvas ---
      gl!.useProgram(drawProg);
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, null);
      gl!.viewport(0, 0, canvas.width, canvas.height);
      gl!.enable(gl!.BLEND);
      gl!.blendFunc(gl!.ONE, gl!.ONE_MINUS_SRC_ALPHA);
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, dst.tex);
      gl!.uniform1i(U.drawState, 0);
      gl!.uniform2f(U.drawTexel, 1 / simW, 1 / simH);
      gl!.uniform1f(U.drawGain, gain);
      gl!.uniform3f(U.drawCrest, crest[0], crest[1], crest[2]);
      gl!.uniform3f(U.drawTrough, trough[0], trough[1], trough[2]);
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);

      idle -= 1;
      frame = idle > 0 ? requestAnimationFrame(step) : null;
    }

    const wake = (frames: number) => {
      idle = Math.max(idle, frames);
      if (frame === null) frame = requestAnimationFrame(step);
    };

    let lastX = 0;
    let lastY = 0;
    let primed = false;

    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch') return;
        const r = canvas.getBoundingClientRect();
        if (
          e.clientX < r.left || e.clientX > r.right ||
          e.clientY < r.top || e.clientY > r.bottom
        ) return;

        const x = (e.clientX - r.left) / r.width;
        const y = 1 - (e.clientY - r.top) / r.height; // uv origin bottom-left

        if (primed) {
          const speed = Math.hypot(x - lastX, y - lastY);
          strength = Math.min(maxStrength, maxStrength * 0.11 + speed * 0.9);
        }
        mx = x;
        my = y;
        lastX = x;
        lastY = y;
        primed = true;

        wake(260);
      },
      { passive: true },
    );

    window.addEventListener('resize', () => wake(60));
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document
      .querySelectorAll<HTMLCanvasElement>('canvas[data-water]')
      .forEach(initWater);
  }
</script>
