  .ai__voiceOff:hover { background: rgba(17, 19, 24, 0.12); color: #14161c; }
  .ai__voiceOff:focus-visible { outline: 2px solid var(--blue-500, #0059ff); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .ai__stage { animation: none; }
    /* The particle field handles this itself — the script stops the rotation
       and the scatter but keeps the swell, because the swell is the part that
