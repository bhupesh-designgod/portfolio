<!-- Message styles live in a global block on purpose: Astro's scoped CSS is
     applied via a data attribute stamped onto elements in the template, and
     every element below is created by script at runtime — so scoped rules
     would never match them. -->
<style is:global>
  /* ---- turns ----
     Generous space between speakers, tight space within one turn: the gap is
     what tells you where one person stopped and the next started, so it has
     to be clearly bigger than any gap inside a message. */
  .turn {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    max-width: 100%;
  }
  .turn + .turn { margin-top: 4px; }
  /* A change of speaker gets noticeably more room than a continuation. */
  .turn--me + .turn--ai,
  .turn--ai + .turn--me { margin-top: 18px; }

  .turn--me { flex-direction: row-reverse; }

  /* The assistant's face, in miniature — the same character sitting in the
     corner, so there's no question who is talking. */
  .turn__ava {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    margin-top: 19px; /* aligns with the bubble, not the label */
    border-radius: 50%;
    background:
      radial-gradient(38% 34% at 32% 26%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%),
      radial-gradient(115% 115% at 32% 26%, #5a76ff 0%, #3b5bf6 46%, #2842e2 80%, #2036c9 100%);
    box-shadow: inset -2px -2px 5px rgba(10, 20, 110, 0.3);
  }

  .turn__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 84%;
  }
  .turn--me .turn__col { align-items: flex-end; }

  .turn__label {
    margin-bottom: 4px;
    font-family: "Inter", "Nunito", system-ui, sans-serif;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #a3a9b8;
  }

  .turn__msg {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 14px;
    line-height: 1.58;
    white-space: pre-wrap;
    overflow-wrap: anywhere; /* a pasted URL shouldn't widen the panel */
  }

  /* Sender: solid brand blue, right-aligned, tail on the right. */
  .turn--me .turn__msg {
    background: var(--blue-500);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  /* Receiver: light surface with a hairline, so it reads as a different
     material rather than just a paler version of the same bubble. */
  .turn--ai .turn__msg {
    background: #f4f6fb;
    border: 1px solid #e7ebf4;
    color: #2c313c;
    border-bottom-left-radius: 4px;
  }

  .turn__msg.is-error {
    background: #fdf0ee;
    border-color: #f6ded9;
    color: #a13c28;
  }

  /* Waiting on the first token. Three real elements rather than ::before and
     ::after, which can only ever produce two dots. */
  /* Bullets and paragraphs inside a reply. Tight, because this is a bubble
     beside the page and not a document. */
  .turn__para { margin: 0; }
  .turn__para + .turn__para,
  .turn__para + .turn__list,
  .turn__list + .turn__para { margin-top: 8px; }
  .turn__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 5px;
  }
  .turn__list li {
    position: relative;
    padding-left: 14px;
  }
  /* A drawn dot rather than a list marker, so it keeps its size and colour
     regardless of the font the bubble inherits. */
  .turn__list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue-500);
  }
  .turn__msg strong {
    font-weight: 700;
    color: #0b0d12;
  }
  .turn__link {
    color: var(--blue-500);
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 89, 255, 0.32);
  }
  .turn__link:hover { border-bottom-color: var(--blue-500); }

  /* Voice-mode subtitles. Global for the same reason as .turn__link above —
     setCaption() builds one span per word at runtime, and runtime elements
     never receive Astro's scoping attribute. Spoken words light; the rest
     stay on the dim base colour set on .ai__cap, so the line reads as one
     sentence with a moving edge rather than as two colours of text. */
  .ai__cap::-webkit-scrollbar { display: none; }
  .ai__cap span { transition: color 0.16s linear; }
  .ai__cap span[data-on='true'] { color: #14161c; }

  .turn__msg[data-pending] {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 21px;
  }
  .turn__msg[data-pending] i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b3bacb;
    animation: ai-wait 1.15s ease-in-out infinite;
  }
  .turn__msg[data-pending] i:nth-child(2) { animation-delay: 0.16s; }
  .turn__msg[data-pending] i:nth-child(3) { animation-delay: 0.32s; }
  @keyframes ai-wait {
    0%, 60%, 100% { opacity: 0.28; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-2px); }
  }
</style>
