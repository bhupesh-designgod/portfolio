---
import { ASSISTANT } from '../lib/portfolio-context';

/* The assistant, as a blob with eyes.
 *
 * Two halves that stay deliberately separate:
 *
 *   Scrolling is free. Fold awareness is one IntersectionObserver and a table
 *   of hardcoded lines — no network, no model, nothing per-frame. The eyes and
 *   the nudges cost nothing but a class change.
 *
 *   Only typing costs money. /api/chat is touched when someone actually asks
 *   something, and not before.
 *
 * The nudge gate is the part worth reading: a character that comments every
 * time you scroll past something is the thing people close immediately, so it
 * speaks at most twice a session and shuts up entirely the moment you engage
 * with it.
 */
---

<div class="ai" data-ai data-assistant={ASSISTANT} data-mood="idle" data-state="idle">
  {/* Nudge bubble — the proactive half */}
  <div class="ai__bubble" data-bubble hidden>
    <p data-bubble-copy></p>
    <button type="button" class="ai__bubbleNo" data-bubble-close aria-label="Dismiss">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4.6 4.6 11.4 11.4M11.4 4.6 4.6 11.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  {/* Chat panel — the on-demand half */}
  <div class="ai__panel" data-panel hidden role="dialog" aria-modal="false" aria-label="Ask about this portfolio">
    <header class="ai__head">
      <p class="ai__title">Ask {ASSISTANT}</p>
      <button type="button" class="ai__close" data-panel-close aria-label="Close">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4.6 4.6 11.4 11.4M11.4 4.6 4.6 11.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <div class="ai__log" data-log aria-live="polite">
      {/* Empty state. Bhupesh introduces the assistant, so his face leads and
          the blob sits on it as a badge — one image saying "me, and this thing
          of mine". The answers then come back in the assistant's own voice. */}
      <div class="ai__empty" data-empty>
        <span class="ai__emptyAva">
          <img src="/assets/avatar.webp" alt="" width="56" height="56" decoding="async" />
          <span class="ai__emptyBadge" aria-hidden="true"></span>
        </span>

        <p class="ai__emptyTitle">Meet {ASSISTANT}, my unpaid assistant</p>
        <p class="ai__emptyBody">
          I&rsquo;m away, but {ASSISTANT} has read everything &mdash; my projects, my background,
          and how to reach me.
        </p>

        <div class="ai__chips" data-chips>
          {/* Three different intents rather than three angles on the same one:
              who he is, what he can do, and what to do next. */}
          <button type="button" data-chip>Ask about Bhupesh&rsquo;s background</button>
          <button type="button" data-chip>What Bhupesh is capable of</button>
          <button type="button" data-chip>How to reach Bhupesh</button>
        </div>
      </div>
    </div>

    {/* Voice mode. Takes the transcript's place on screen while the log stays
        mounted and keeps filling, so leaving the mode drops you back into a
        conversation that carried on without interruption.

        aria-hidden throughout: every word here is already in the log, which is
        the live region. Announcing it twice — once as transcript, once as
        subtitle — is worse than not announcing it at all. */}
    <div class="ai__stage" data-stage hidden aria-hidden="true">
      {/* The orb, ported from 21st.dev — a WebGL ring whose noise, spin and
          edge distortion all rise with the voice, so loudness reads as
          turbulence rather than as brightness. The buffer is 2x its CSS box;
          the shader and the uniform mapping are in the script. */}
      <div class="ai__orb" data-orb>
        <canvas data-orb-canvas width="360" height="360"></canvas>
      </div>

      {/* The question, small, so you can see what is being answered. */}
      <p class="ai__asked" data-asked></p>

      {/* Subtitles. One utterance at a time — a whole answer at this size
          would not fit, and the point of the mode is listening, not reading
          ahead. Words light as they are spoken where the browser reports
          boundaries. */}
      <p class="ai__cap" data-cap></p>

      <button type="button" class="ai__voiceOff" data-voice-off>Back to chat</button>
    </div>

    <form class="ai__form" data-form>
      <input
        type="text"
        data-input
        maxlength="500"
        autocomplete="off"
        placeholder="Ask a question…"
        aria-label="Your question"
      />
      {/* Beside Send rather than up in the header: this is the row where you
          are already acting, and a mode switch parked next to the close button
          read as chrome. Hidden until the script confirms Web Audio exists. */}
      <button type="button" class="ai__voiceBtn" data-voice-on aria-label="Switch to voice mode" hidden>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 10.5v-1M6.5 13.5v-7M10 16V4M13.5 13.5v-7M17 10.5v-1"
            fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
      <button type="submit" data-send aria-label="Send">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </form>
  </div>

  {/* The character */}
  <button type="button" class="ai__blob" data-ai-blob aria-label="Ask about this portfolio" aria-expanded="false">
    <span class="ai__body" aria-hidden="true">
      {/* Decorations sit outside the gaze group so they stay pinned to the
          sphere while the face turns. */}
      <svg class="ai__fx" viewBox="0 0 64 64">
        <path class="fx-spark" d="M52 12 l1.6 4.2 4.2 1.6 -4.2 1.6 -1.6 4.2 -1.6 -4.2 -4.2 -1.6 4.2 -1.6z" />
        <path class="fx-line fx-line--l" d="M-3 26 q-3.5 6 0 12" />
        <path class="fx-line fx-line--r" d="M67 26 q3.5 6 0 12" />
      </svg>

      {/* Costume layer. Everything here is hidden until a project claims it —
          see the costume block in the script. One sheet per costume, same as
          the expressions: cheaper to read than a component per outfit. */}
      <svg class="ai__gear" viewBox="0 0 64 64">
        <defs>
          <clipPath id="aiSphere">
            {/* A hair inside the silhouette, so a clipped edge never shows a
                seam against the sphere's own antialiased rim. */}
            <circle cx="32" cy="32" r="31.4" />
          </clipPath>
          <linearGradient id="aiBandFace" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" />
            {/* The lower edge picks up bounce off the blue below it. */}
            <stop offset="1" stop-color="#d5dcff" />
          </linearGradient>
        </defs>

        {/* ---- fitness: a sweatband, worn at a slight angle ----
            Clipped to the sphere, so the ends meet the silhouette exactly
            however the curve is tuned — and so it can drop in from above
            without ever hanging off the head. */}
        <g class="gear-band" clip-path="url(#aiSphere)">
          <g class="gear-band__in">
            <path class="gear-band__cloth" d="M-8 6 Q32 17 72 6 L72 15.5 Q32 26.5 -8 15.5 Z" />
            <path class="gear-band__stripe" d="M-8 8.6 Q32 19.6 72 8.6 L72 11.2 Q32 22.2 -8 11.2 Z" />
          </g>
        </g>

        {/* Outside the clip, so it reads as held rather than painted on. Sits
            low and to the side, clear of the face: the inner plate laps over
            the silhouette just enough to sit in front of the body. */}
        <g class="gear-bell">
          <rect class="gear-bell__bar" x="-9" y="50.7" width="17" height="2.6" rx="1.3" />
          <rect class="gear-bell__plate" x="-11.6" y="46.6" width="4.8" height="11" rx="2.2" />
          <rect class="gear-bell__plate" x="6.2" y="46.6" width="4.8" height="11" rx="2.2" />
        </g>
      </svg>

      <span class="ai__face" data-face>
        {/* Every expression is a path in one sheet, cross-faded by opacity.
            Cheaper and far more precise than reshaping boxes with border-radius,
            and it keeps all twelve variants in one place to read. */}
        <svg class="ai__f" viewBox="0 0 64 64">
          {/* eyes — default capsules */}
          <rect class="e-cap" x="19.7" y="23" width="4.6" height="13" rx="2.3" />
          <rect class="e-cap" x="39.7" y="23" width="4.6" height="13" rx="2.3" />

          {/* curious: one capsule holds, the other drops to a dot */}
          <circle class="e-dot" cx="42" cy="32" r="2.8" />

          {/* happy / cheerful: closed arcs, arched up */}
          <path class="e-up" d="M17.5 32 q4.5 -6.5 9 0" />
          <path class="e-up" d="M37.5 32 q4.5 -6.5 9 0" />

          {/* relaxed: closed arcs, settled down */}
          <path class="e-down" d="M17.5 29 q4.5 6.5 9 0" />
          <path class="e-down" d="M37.5 29 q4.5 6.5 9 0" />

          {/* wink: a chevron on the left only */}
          <path class="e-wink" d="M18 26.5 l6 5 -6 5" />

          {/* mouths */}
          <path class="m-neutral" d="M26.5 42 q5.5 4 11 0" />
          <path class="m-smile" d="M25 40.5 q7 8.5 14 0" />
          <path class="m-open" d="M25.5 41 h13 a6.5 6.5 0 0 1 -13 0z" />
        </svg>
      </span>
    </span>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-ai]');

  if (root) {
    const blob = root.querySelector<HTMLButtonElement>('[data-ai-blob]')!;
    const bubble = root.querySelector<HTMLElement>('[data-bubble]')!;
    const bubbleCopy = root.querySelector<HTMLElement>('[data-bubble-copy]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const face = root.querySelector<HTMLElement>('[data-face]')!;

    let busy = false; // a reply is streaming — read by the expression layer below

    /* Frontmatter runs on the server; this script runs in the browser. The
       name comes across on a data attribute rather than being duplicated. */
    const name = root.dataset.assistant ?? 'Assistant';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Lifecycle events for anything that needs to react to the chat — sound,
       analytics, whatever comes later. Announced explicitly rather than left
       to be inferred from `data-mood`: setBase() deliberately doesn't write
       that attribute while a passing expression is playing, so opening the
       panel mid-smile changed nothing observable. */
    const emit = (name: string) => root!.dispatchEvent(new CustomEvent(name, { bubbles: true }));

    /* ---------------- the face ---------------- */

    /* Gaze. One rAF-throttled pointermove writing one transform — the whole
       face shifts, so it reads as the character turning to watch you. */
    let px = -1;
    let py = -1;
    let gazing = false;

    function gaze() {
      gazing = false;
      const r = blob.getBoundingClientRect();
      const dx = px - (r.left + r.width / 2);
      const dy = py - (r.top + r.height / 2);
      const dist = Math.hypot(dx, dy) || 1;
      // Eased and clamped: a pointer across the room still registers as a
      // glance, and the face never slides off the sphere.
      const reach = Math.min(dist / 240, 1) * 4;
      face.style.transform = `translate(${((dx / dist) * reach).toFixed(2)}px, ${((dy / dist) * reach * 0.8).toFixed(2)}px)`;
    }

    /* With no pointer to follow it looks around on its own, so it never reads
       as frozen — the difference between idle and switched-off. */
    function wander() {
      if (px !== -1) return; // a real pointer outranks the idle drift
      const a = Math.random() * Math.PI * 2;
      const r = 1.5 + Math.random() * 2.5;
      face.style.transform = `translate(${(Math.cos(a) * r).toFixed(2)}px, ${(Math.sin(a) * r * 0.7).toFixed(2)}px)`;
    }

    if (!reduce) {
      window.addEventListener(
        'pointermove',
        (e) => {
          px = e.clientX;
          py = e.clientY;
          if (!gazing) {
            gazing = true;
            requestAnimationFrame(gaze);
          }
        },
        { passive: true },
      );

      /* Blink on an irregular timer. A fixed interval reads as a metronome;
         real blinks cluster. */
      const blink = () => {
        root.dataset.blink = '1';
        setTimeout(() => delete root.dataset.blink, 130);
        setTimeout(blink, 2600 + Math.random() * 4600);
      };
      setTimeout(blink, 1600);
      setInterval(wander, 2800);
    }

    /* ---------------- expressions ----------------
     *
     * Two layers. `base` is the standing condition, now always idle. `flash` is
     * a reaction that plays over the top for a moment and then falls back to
     * it.
     *
     * Keeping them separate is what stops a passing reaction from stranding
     * the face in the wrong expression: every flash knows where to return to.
     */
    /* `thinking` (squiggle mouth) and `eager` (star eyes) were removed —
       they read as cheap where the rest of the set reads as drawn. The
       states they covered fall back to idle, and the waiting cue moved to
       the body's breathing rate, which is keyed off data-state instead. */
    type Mood = 'idle' | 'curious' | 'happy' | 'greet' | 'excited' | 'guiding' | 'relaxed';

    let base: Mood = 'idle';
    let flashTimer = 0;

    function apply(m: Mood) {
      root.dataset.mood = m;
    }

    function setBase(m: Mood) {
      base = m;
      if (!flashTimer) apply(m);
    }

    function flash(m: Mood, ms: number) {
      if (reduce) return;
      apply(m);
      clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => {
        flashTimer = 0;
        apply(base);
      }, ms);
    }

    /* Nobody has touched anything for a while — settle, but stay present.
       Reset by any real signal of a person being there. */
    let restTimer = 0;
    function stirred() {
      if (base === 'relaxed') setBase('idle');
      clearTimeout(restTimer);
      if (reduce) return;
      restTimer = window.setTimeout(() => {
        if (panel.hidden && !busy) setBase('relaxed');
      }, 45000);
    }

    if (!reduce) {
      for (const evt of ['pointermove', 'scroll', 'keydown'] as const) {
        window.addEventListener(evt, stirred, { passive: true });
      }
      stirred();
    }

    /* Hover: greet on the first hover of the session, then plain happy. */
    const GREETED = 'ai-greeted';
    blob.addEventListener('pointerenter', () => {
      if (busy || !panel.hidden) return;
      if (!sessionStorage.getItem(GREETED)) {
        sessionStorage.setItem(GREETED, '1');
        flash('greet', 1600);
      } else {
        flash('happy', 1200);
      }
    });
    blob.addEventListener('pointerleave', () => {
      if (!flashTimer) apply(base);
    });

    /* ---------------- nudges ---------------- */

    const LINES: Record<string, string[]> = {
      work: [
        'Want me to summarise any of these in a sentence?',
        'Looking for something specific? I can point you at the right project.',
        'Ask me what he actually did on any of these.',
      ],
      resume: [
        'Want the résumé as a PDF instead?',
        'Ask me anything about his background.',
      ],
      contact: [
        'Found what you needed? I can answer questions before you write.',
      ],
      reading: [
        'Ask me for the short version of this one.',
        'Want the outcome without reading the whole thing?',
      ],
    };

    const CAP = 2;
    const seen = (k: string) => sessionStorage.getItem(`ai-nudge-${k}`) === '1';
    const count = () => Number(sessionStorage.getItem('ai-nudge-count') ?? 0);
    let engaged = false; // set once they interact — after that, silence

    let hideTimer = 0;
    function say(fold: string) {
      if (engaged || bubble.hidden === false || !panel.hidden) return;
      /* A walkthrough is already narrating this page. Offering "the short
         version of this one" over the top of it is the assistant talking across
         the tour — two voices for the same page, one of them interrupting. */
      if (document.body.classList.contains('wt-on')) return;
      if (seen(fold) || count() >= CAP) return;
      const lines = LINES[fold];
      if (!lines) return;

      sessionStorage.setItem(`ai-nudge-${fold}`, '1');
      sessionStorage.setItem('ai-nudge-count', String(count() + 1));

      bubbleCopy.textContent = lines[Math.floor(Math.random() * lines.length)];
      bubble.hidden = false;
      flash('guiding', 4200);
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(hush, 7000);
    }

    function hush() {
      clearTimeout(hideTimer);
      bubble.hidden = true;
    }

    root.querySelector('[data-bubble-close]')!.addEventListener('click', () => {
      // Dismissing one is a signal about all of them.
      engaged = true;
      hush();
    });

    /* A nudge already on screen when a walkthrough starts has to go too — the
       gate above only stops new ones. */
    window.addEventListener('walkthrough:start', hush);

    /* ---------------- fold awareness ---------------- */

    /* IntersectionObserver rather than a scroll handler: this fires on boundary
       crossings only, where a scroll handler would run every frame for a value
       that changes three times a page. */
    const folds: [Element, string][] = [];
    const add = (sel: string, name: string) => {
      const el = document.querySelector(sel);
      if (el) folds.push([el, name]);
    };
    add('#work', 'work');
    add('#resume', 'resume');
    add('.footer', 'contact');
    // Case study pages have their own rhythm; the whole reading surface is one fold.
    add('.cs-read', 'reading');

    if (folds.length) {
      let current = '';
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const name = folds.find(([el]) => el === entry.target)?.[1];
            if (!name || name === current) continue;
            current = name;
            flash('curious', 1500);
            say(name);
          }
        },
        // A fold is "current" when it crosses the middle band of the viewport.
        { rootMargin: '-45% 0px -45% 0px' },
      );
      for (const [el] of folds) io.observe(el);
    }

    /* ---------------- costumes ----------------
     *
     * A project can dress the assistant: `costume` in its frontmatter reaches
     * the DOM as a data attribute, and the stylesheet draws the gear. Two
     * scopes, because "which project am I looking at" means different things
     * on the two pages:
     *
     *   Case study page — the whole page is one project, so the costume is
     *   worn from load to unload.
     *
     *   Home page — the cards are a list, so it's worn only while that card
     *   is what you're actually looking at, and swaps as you scroll past.
     *
     * Adding a costume to another project is a frontmatter line plus a block
     * in the stylesheet. Nothing here needs to know the names.
     */
    const page = document.querySelector<HTMLElement>('.cs[data-costume]');

    if (page) {
      root.dataset.costume = page.dataset.costume!;
    } else {
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>('[data-costume]'),
      ).filter((el) => el !== root);

      if (cards.length) {
        /* The observer reports crossings, not what's currently centred, so the
           set is kept and re-read — two cards can straddle the middle band at
           once, and the nearer one should win. */
        const inBand = new Set<HTMLElement>();

        const wear = () => {
          const mid = window.innerHeight / 2;
          let best: HTMLElement | null = null;
          let bestDist = Infinity;

          for (const el of inBand) {
            const r = el.getBoundingClientRect();
            const dist = Math.abs(r.top + r.height / 2 - mid);
            if (dist < bestDist) {
              bestDist = dist;
              best = el;
            }
          }

          const next = best?.dataset.costume ?? '';
          if (next === (root.dataset.costume ?? '')) return;
          if (next) root.dataset.costume = next;
          else delete root.dataset.costume;
        };

        const co = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const el = entry.target as HTMLElement;
              if (entry.isIntersecting) inBand.add(el);
              else inBand.delete(el);
            }
            wear();
          },
          // Narrower than the nudge band: a costume change is a visible event,
          // so it should land when the card is genuinely the subject.
          { rootMargin: '-35% 0px -35% 0px' },
        );

        for (const el of cards) co.observe(el);
      }
    }

    /* ---------------- chat ---------------- */

    const MAX_TURNS = 8;
    const SESSION_CAP = 15;
    let history: { role: 'user' | 'assistant'; content: string }[] = [];

    function open() {
      engaged = true;
      hush();
      panel.hidden = false;
      root.dataset.state = 'open';
      setBase('idle');
      stirred();
      emit('ai:open');
      blob.setAttribute('aria-expanded', 'true');
      setTimeout(() => input.focus(), reduce ? 0 : 260);
    }

    function close() {
      /* Leaving voice mode on the way out, not just silencing it: the mode
         holds the music paused, and a panel closed from voice mode would
         otherwise keep it that way with nothing left on screen to explain
         why. setVoiceMode stops the speech itself. */
      if (voiceMode) setVoiceMode(false);
      else stopSpeech();
      panel.hidden = true;
      root.dataset.state = 'idle';
      setBase('idle');
      emit('ai:close');
      blob.setAttribute('aria-expanded', 'false');
      blob.focus();
    }

    blob.addEventListener('click', () => (panel.hidden ? open() : close()));
    root.querySelector('[data-panel-close]')!.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
    document.addEventListener('pointerdown', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) close();
    });

    /* ---- voice mode ----
       A separate mode, entered from the header and left from the stage. While
       it is on, answers arrive as audio with subtitles instead of as a
       transcript you read. Input stays typed — there is no microphone here, on
       purpose: speech recognition in the browser means shipping the visitor's
       audio to Google or Apple, which is not a thing to do quietly on someone
       else's portfolio.

       Speech comes from /api/speak and only from there. The browser's own
       synthesiser used to stand behind it as a fallback and has been removed:
       it sounded a decade old, and one failed request latched the whole
       session onto it. A line that will not synthesise is now skipped and
       said so in the caption — silence is the better failure. */
    const voiceBtn = root.querySelector<HTMLElement>('[data-voice-on]')!;
    const voiceOff = root.querySelector<HTMLElement>('[data-voice-off]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const cap = root.querySelector<HTMLElement>('[data-cap]')!;
    const asked = root.querySelector<HTMLElement>('[data-asked]')!;

    let voiceMode = false;
    let spokenUpTo = 0; // how much of the current answer has been queued
    let speaking = false; // audio is sounding or queued; the orb pulses while it is
    let capWords: HTMLElement[] = [];

    /* The rendered reply is a tiny markup subset (see renderReply below), and
       every part of it reads badly out loud: asterisks get spelled, and a bare
       path becomes "slash work slash t b s". */
    const plain = (s: string) =>
      s
        .replace(/\*\*([^*\n]+)\*\*/g, '$1')
        .replace(/^\s*[-*•]\s+/gm, '')
        /* Only a slash that *starts* a token is a path. Matching a bare slash
           anywhere ate the second half of every ordinary pair — "design/
           research" was read as "design", "he/she" as "he" — which is most of
           why the voice sounded like it was skipping words. */
        .replace(/(^|[\s([])\/[a-z0-9][a-z0-9/-]*/gi, '$1')
        .replace(/\s+/g, ' ')
        .trim();

    /* ---- amplitude ----
       The orb reads one number, `amp` in 0…1, and knows nothing about where it
       comes from. Normally that is the real RMS of the audio being played,
       off the AnalyserNode further down. When there is no audio graph to
       sample — the speechSynthesis fallback, which exposes none — a `boundary`
       event per word kicks the value to 1 and it decays over a slow idle sway,
       so the thing still breathes between words. Either way the orb sees the
       same number and nothing below this changes. */
    let amp = 0;
    let ampPeak = 0;
    let ampRaf = 0;

    /* ---- the orb ----
       A port of 21st.dev/@isaiahbjork/voice-powered-orb. The GLSL below is
       that component's, unchanged — the simplex noise, the two light falloff
       terms, the YIQ hue rotation and the three base colours are all its.

       What changed is where the number driving it comes from. The original
       opens the microphone and turns the visitor's own voice into rotation
       and distortion. This mode has no microphone on purpose, and it already
       holds a better signal than one: `amp`, the RMS of the assistant's
       speech taken off the AnalyserNode below. So `amp` is fed in exactly
       where the original feeds its mic level, and nothing asks the visitor
       for permission to render a graphic.

       ogl is dropped as well. It supplies a fullscreen triangle and a program
       wrapper — the same handful of calls WaterSurface already makes against
       raw WebGL in this codebase, so there is no reason to add a dependency
       for them. */
    const canvas = root.querySelector<HTMLCanvasElement>('[data-orb-canvas]');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Degrees of hue rotation applied to all three base colours. 0 is the
       component as published — cyan through white into violet. The rest of
       this site is blue; this one graphic is left alone, because the sweep
       between two hues is the effect and collapsing it toward a single blue
       flattens the orb into a ring. */
    const ORB_HUE = 0;
    /* The original's prop defaults, kept as the constants they effectively
       were: voiceSensitivity is already baked into `amp`. */
    const BASE_ROT_SPEED = 0.3;
    const MAX_ROT_SPEED = 1.2;
    const MAX_HOVER = 0.8;

    const orbVert = `
      precision highp float;
      attribute vec2 position;
      attribute vec2 uv;
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 0.0, 1.0);
      }
    `;

    const orbFrag = `
      precision highp float;

      uniform float iTime;
      uniform vec3 iResolution;
      uniform float hue;
      uniform float hover;
      uniform float rot;
      uniform float hoverIntensity;
      varying vec2 vUv;

      vec3 rgb2yiq(vec3 c) {
        float y = dot(c, vec3(0.299, 0.587, 0.114));
        float i = dot(c, vec3(0.596, -0.274, -0.322));
        float q = dot(c, vec3(0.211, -0.523, 0.312));
        return vec3(y, i, q);
      }

      vec3 yiq2rgb(vec3 c) {
        float r = c.x + 0.956 * c.y + 0.621 * c.z;
        float g = c.x - 0.272 * c.y - 0.647 * c.z;
        float b = c.x - 1.106 * c.y + 1.703 * c.z;
        return vec3(r, g, b);
      }

      vec3 adjustHue(vec3 color, float hueDeg) {
        float hueRad = hueDeg * 3.14159265 / 180.0;
        vec3 yiq = rgb2yiq(color);
        float cosA = cos(hueRad);
        float sinA = sin(hueRad);
        float i = yiq.y * cosA - yiq.z * sinA;
        float q = yiq.y * sinA + yiq.z * cosA;
        yiq.y = i;
        yiq.z = q;
        return yiq2rgb(yiq);
      }

      vec3 hash33(vec3 p3) {
        p3 = fract(p3 * vec3(0.1031, 0.11369, 0.13787));
        p3 += dot(p3, p3.yxz + 19.19);
        return -1.0 + 2.0 * fract(vec3(
          p3.x + p3.y,
          p3.x + p3.z,
          p3.y + p3.z
        ) * p3.zyx);
      }

      float snoise3(vec3 p) {
        const float K1 = 0.333333333;
        const float K2 = 0.166666667;
        vec3 i = floor(p + (p.x + p.y + p.z) * K1);
        vec3 d0 = p - (i - (i.x + i.y + i.z) * K2);
        vec3 e = step(vec3(0.0), d0 - d0.yzx);
        vec3 i1 = e * (1.0 - e.zxy);
        vec3 i2 = 1.0 - e.zxy * (1.0 - e);
        vec3 d1 = d0 - (i1 - K2);
        vec3 d2 = d0 - (i2 - K1);
        vec3 d3 = d0 - 0.5;
        vec4 h = max(0.6 - vec4(
          dot(d0, d0),
          dot(d1, d1),
          dot(d2, d2),
          dot(d3, d3)
        ), 0.0);
        vec4 n = h * h * h * h * vec4(
          dot(d0, hash33(i)),
          dot(d1, hash33(i + i1)),
          dot(d2, hash33(i + i2)),
          dot(d3, hash33(i + 1.0))
        );
        return dot(vec4(31.316), n);
      }

      vec4 extractAlpha(vec3 colorIn) {
        float a = max(max(colorIn.r, colorIn.g), colorIn.b);
        return vec4(colorIn.rgb / (a + 1e-5), a);
      }

      const vec3 baseColor1 = vec3(0.611765, 0.262745, 0.996078);
      const vec3 baseColor2 = vec3(0.298039, 0.760784, 0.913725);
      const vec3 baseColor3 = vec3(0.062745, 0.078431, 0.600000);
      const float innerRadius = 0.6;
      const float noiseScale = 0.65;

      float light1(float intensity, float attenuation, float dist) {
        return intensity / (1.0 + dist * attenuation);
      }

      float light2(float intensity, float attenuation, float dist) {
        return intensity / (1.0 + dist * dist * attenuation);
      }

      vec4 draw(vec2 uv) {
        vec3 color1 = adjustHue(baseColor1, hue);
        vec3 color2 = adjustHue(baseColor2, hue);
        vec3 color3 = adjustHue(baseColor3, hue);

        float ang = atan(uv.y, uv.x);
        float len = length(uv);
        float invLen = len > 0.0 ? 1.0 / len : 0.0;

        float n0 = snoise3(vec3(uv * noiseScale, iTime * 0.5)) * 0.5 + 0.5;
        float r0 = mix(mix(innerRadius, 1.0, 0.4), mix(innerRadius, 1.0, 0.6), n0);
        float d0 = distance(uv, (r0 * invLen) * uv);
        float v0 = light1(1.0, 10.0, d0);
        v0 *= smoothstep(r0 * 1.05, r0, len);
        float cl = cos(ang + iTime * 2.0) * 0.5 + 0.5;

        float a = iTime * -1.0;
        vec2 pos = vec2(cos(a), sin(a)) * r0;
        float d = distance(uv, pos);
        float v1 = light2(1.5, 5.0, d);
        v1 *= light1(1.0, 50.0, d0);

        float v2 = smoothstep(1.0, mix(innerRadius, 1.0, n0 * 0.5), len);
        float v3 = smoothstep(innerRadius, mix(innerRadius, 1.0, 0.5), len);

        vec3 col = mix(color1, color2, cl);
        col = mix(color3, col, v0);
        col = (col + v1) * v2 * v3;
        col = clamp(col, 0.0, 1.0);

        return extractAlpha(col);
      }

      vec4 mainImage(vec2 fragCoord) {
        vec2 center = iResolution.xy * 0.5;
        float size = min(iResolution.x, iResolution.y);
        vec2 uv = (fragCoord - center) / size * 2.0;

        float angle = rot;
        float s = sin(angle);
        float c = cos(angle);
        uv = vec2(c * uv.x - s * uv.y, s * uv.x + c * uv.y);

        uv.x += hover * hoverIntensity * 0.1 * sin(uv.y * 10.0 + iTime);
        uv.y += hover * hoverIntensity * 0.1 * sin(uv.x * 10.0 + iTime);

        return draw(uv);
      }

      void main() {
        vec2 fragCoord = vUv * iResolution.xy;
        vec4 col = mainImage(fragCoord);
        gl_FragColor = vec4(col.rgb * col.a, col.a);
      }
    `;

    /* The shader's last line is `vec4(col.rgb * col.a, col.a)` — it emits
       premultiplied colour. The component pairs that with
       premultipliedAlpha:false and a SRC_ALPHA blend, which multiplies by
       alpha a second time: at the soft edge of the ring the destination is
       dimmed by (1 - a) while only a*a of the colour is added back, so the
       falloff fills with grey. On the near-black the component was built
       against that is invisible. This panel is white, where it reads as a
       dirty halo around the orb.

       So the blend is matched to what the shader actually emits — ONE for a
       premultiplied source — and the context is told the same thing. The
       shader is untouched. */
    const gl =
      canvas?.getContext('webgl', {
        alpha: true,
        premultipliedAlpha: true,
        antialias: true,
      }) ?? null;

    type OrbGpu = {
      u: Record<string, WebGLUniformLocation | null>;
    };
    let gpu: OrbGpu | null = null;

    if (gl && canvas) {
      const compile = (type: number, src: string) => {
        const sh = gl.createShader(type)!;
        gl.shaderSource(sh, src);
        gl.compileShader(sh);
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
          console.warn('orb shader:', gl.getShaderInfoLog(sh));
          return null;
        }
        return sh;
      };

      const vs = compile(gl.VERTEX_SHADER, orbVert);
      const fs = compile(gl.FRAGMENT_SHADER, orbFrag);

      if (vs && fs) {
        const prog = gl.createProgram()!;
        gl.attachShader(prog, vs);
        gl.attachShader(prog, fs);
        gl.linkProgram(prog);

        if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
          gl.useProgram(prog);

          /* ogl's Triangle: one oversized triangle covering the viewport,
             which beats two triangles because there is no seam down the
             diagonal for the fragment shader to sample across. */
          const put = (name: string, data: number[]) => {
            const buf = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, buf);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(data), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(prog, name);
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
          };
          put('position', [-1, -1, 3, -1, -1, 3]);
          put('uv', [0, 0, 2, 0, 0, 2]);

          gl.clearColor(0, 0, 0, 0);
          gl.enable(gl.BLEND);
          gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
          gl.viewport(0, 0, canvas.width, canvas.height);

          gpu = {
            u: {
              iTime: gl.getUniformLocation(prog, 'iTime'),
              iResolution: gl.getUniformLocation(prog, 'iResolution'),
              hue: gl.getUniformLocation(prog, 'hue'),
              hover: gl.getUniformLocation(prog, 'hover'),
              rot: gl.getUniformLocation(prog, 'rot'),
              hoverIntensity: gl.getUniformLocation(prog, 'hoverIntensity'),
            },
          };
          gl.uniform3f(gpu.u.iResolution, canvas.width, canvas.height, canvas.width / canvas.height);
          gl.uniform1f(gpu.u.hue, ORB_HUE);
        }
      }
    }

    let orbRot = 0;
    let orbLast = 0;

    function drawOrb(now: number) {
      if (!gl || !gpu || !canvas) return;

      const dt = orbLast ? (now - orbLast) * 0.001 : 0;
      orbLast = now;
      const t = still ? 0 : now * 0.001;

      /* The original's mapping, with `amp` standing in for its mic level.
         The 0.05 gate is its own: below that the extra spin is off and the
         orb is carried only by the noise and the orbiting light in the
         shader, which is what keeps it alive between answers rather than
         frozen. */
      if (!still && amp > 0.05) {
        orbRot += dt * (BASE_ROT_SPEED + amp * MAX_ROT_SPEED * 2.0);
      }

      gl.uniform1f(gpu.u.iTime, t);
      gl.uniform1f(gpu.u.rot, orbRot);
      gl.uniform1f(gpu.u.hover, still ? 0 : Math.min(amp * 2.0, 1.0));
      gl.uniform1f(gpu.u.hoverIntensity, still ? 0 : Math.min(amp * MAX_HOVER * 0.8, MAX_HOVER));

      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    const ampLoop = (now: number = performance.now()) => {
      let target: number;

      /* Derived, not counted. The audio clock already knows whether anything is
         sounding, and a count kept by hand drifted from it every time a clip
         was stopped rather than allowed to end. */
      const clock = audioCtx ? audioCtx.currentTime : 0;
      const wasSpeaking = speaking;
      speaking = !!audioCtx && queuedUntil > clock;
      if (speaking !== wasSpeaking) root.dataset.speaking = String(speaking);

      if (analyser && scope && speaking) {
        /* The real thing: RMS of the waveform this frame. Deviation from 128
           because time-domain data is centred there, and x3.4 because speech
           at a comfortable listening level sits well below full scale — raw
           RMS would leave the field barely moving. */
        analyser.getByteTimeDomainData(scope);
        let sum = 0;
        for (let i = 0; i < scope.length; i++) {
          const d = (scope[i] - 128) / 128;
          sum += d * d;
        }
        target = Math.min(1, Math.sqrt(sum / scope.length) * 3.4);
      } else {
        // Fallback voice: no audio graph, so word events and a slow sway.
        ampPeak *= 0.9;
        target = Math.max(ampPeak, speaking ? 0.2 + Math.sin(now / 240) * 0.07 : 0);
      }

      amp += (target - amp) * 0.22; // ease, so peaks arrive as swells not steps

      followCaption(clock);
      drawOrb(now);

      /* Runs for as long as the mode is open, not just while a voice is
         playing — the field turning quietly between questions is what makes
         it feel like something waiting rather than something switched off. */
      ampRaf = voiceMode || speaking || amp > 0.004 ? requestAnimationFrame(ampLoop) : 0;
    };
    const runAmp = () => {
      if (!ampRaf) ampRaf = requestAnimationFrame(ampLoop);
    };
    const kick = () => {
      ampPeak = 1;
      runAmp();
    };

    const stopSpeech = () => {
      /* Bumping the generation orphans every fetch and every queued line at
         once — cheaper and more certain than trying to unwind the chain. */
      generation += 1;
      chain = Promise.resolve();
      /* Everything scheduled, not just what is audible: a clip queued to start
         in two seconds is every bit as much a thing that must not be heard. */
      for (const src of playing) {
        try {
          src.stop();
        } catch {
          /* already ended */
        }
      }
      playing.clear();
      queuedUntil = 0;
      timeline = [];
      shown = null;
      speaking = false;
      root.dataset.speaking = 'false';
      ampPeak = 0;
      runAmp(); // let it settle to rest rather than snapping
    };

    /* Subtitles are rebuilt per utterance, one word per span, each tagged with
       where it starts in the spoken string. That offset is the only thing the
       boundary event gives us to sync against. */
    function setCaption(text: string) {
      cap.textContent = '';
      capWords = [];
      let at = 0;
      for (const part of text.split(/(\s+)/)) {
        if (!part) continue;
        if (/^\s+$/.test(part)) {
          cap.appendChild(document.createTextNode(part));
        } else {
          const w = document.createElement('span');
          w.textContent = part;
          w.dataset.at = String(at);
          cap.appendChild(w);
          capWords.push(w);
        }
        at += part.length;
      }
    }

    /* Everything up to the word being spoken is lit. */
    const litUpTo = (charIndex: number) => {
      let last: HTMLElement | null = null;
      for (const w of capWords) {
        const on = Number(w.dataset.at) <= charIndex;
        w.dataset.on = String(on);
        if (on) last = w;
      }
      /* The caption is a fixed window, not a growing block — a long sentence
         used to push the stage past its own height and print itself over the
         button. It scrolls to follow the voice instead, which is what real
         subtitles do. */
      if (last && cap.scrollHeight > cap.clientHeight + 1) {
        /* Snapped to whole lines. Scrolling to an arbitrary pixel offset put
           the boundary through the middle of a row of glyphs, which is what
           made the top line look sliced rather than scrolled. */
        const line = last.offsetHeight || 1;
        const want = last.offsetTop - cap.clientHeight / 2 + line / 2;
        cap.scrollTop = Math.max(0, Math.round(want / line) * line);
      }
    };

    /* Reads the caption off the audio clock every frame: which utterance is
       sounding, and how far into it the voice has got. The clip is put on
       screen when it starts rather than when it is scheduled, so the subtitle
       cannot run ahead of a line still waiting its turn — and the last one
       stays up after the voice stops, which is what you want to be looking at
       while you decide what to ask next. */
    const followCaption = (now: number) => {
      while (timeline.length > 1 && timeline[1].start <= now) timeline.shift();
      const u = timeline[0];
      if (!u || now < u.start) return;
      if (u !== shown) {
        setCaption(u.text);
        shown = u;
      }
      litUpTo(charAt(u, (now - u.start) * 1000));
    };

    /* ---- hosted voice ----
       /api/speak returns one sentence as audio plus a mark per spoken word. It
       is played through Web Audio rather than an <audio> element for two
       reasons that matter: an AnalyserNode on the graph gives the orb the real
       waveform, so it moves with the voice instead of guessing; and clips can
       be scheduled on the audio clock rather than started by a JavaScript
       event, which is what closes the gap between sentences.

       A line that fails to synthesise is skipped on its own — a hiccup on one
       sentence must not cost the rest of the answer. */
    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let scope: Uint8Array | null = null;
    let chain: Promise<void> = Promise.resolve();
    let generation = 0; // bumped on stop; anything older is discarded
    /* Everything scheduled and not yet finished. More than one clip is usually
       in here: audio is queued ahead of the moment it plays. */
    const playing = new Set<AudioBufferSourceNode>();
    /* When the queued audio runs out, on the AudioContext's own clock. Each
       clip begins exactly there rather than when an `ended` event says the last
       one finished — that wait is a frame at best, and it is what put a hole
       between every sentence. */
    let queuedUntil = 0;

    /* One scheduled utterance. `cues` are word starts in milliseconds from the
       top of the clip; `start`/`end` are positions on the audio clock. The
       caption is driven from this rather than from playback events, so what is
       on screen and what is in your ears are read off the same clock and
       cannot drift apart. */
    type Cue = { t: number; at: number };
    type Spoken = { text: string; cues: Cue[]; start: number; end: number; ms: number };
    let timeline: Spoken[] = [];
    let shown: Spoken | null = null;

    const openAudio = () => {
      if (audioCtx) return audioCtx;
      const Ctor = window.AudioContext ?? (window as any).webkitAudioContext;
      if (!Ctor) return null;
      audioCtx = new Ctor();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      analyser.smoothingTimeConstant = 0.75;
      scope = new Uint8Array(analyser.fftSize);
      analyser.connect(audioCtx.destination);
      return audioCtx;
    };

    type Mark = { t: number; d: number; w: string };
    type Line = { buf: AudioBuffer; marks: Mark[] };

    async function fetchLine(text: string): Promise<Line | null> {
      const ctx = openAudio();
      if (!ctx) return null;
      try {
        const res = await fetch('/api/speak', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        // Failures are per line, not per session: one bad request used to
        // latch the whole conversation onto the fallback voice.
        if (!res.ok) return null;
        const { audio, marks } = await res.json();
        if (typeof audio !== 'string') return null;
        const bytes = Uint8Array.from(atob(audio), (c) => c.charCodeAt(0));
        return {
          buf: await ctx.decodeAudioData(bytes.buffer),
          marks: Array.isArray(marks) ? marks : [],
        };
      } catch {
        return null;
      }
    }

    /* Marks name the word, not where it sits in the string, and the
       synthesiser does not always split where a space does — it says "twenty
       five" for "25". Walking forward from the previous match keeps the two in
       step, and a mark that cannot be placed is dropped rather than guessed
       at: the cost is one word holding its highlight a beat longer, not a
       caption that slides out of step for the rest of the line. */
    function cuesFor(text: string, marks: Mark[]): Cue[] {
      const cues: Cue[] = [];
      let from = 0;
      for (const m of marks) {
        const w = typeof m?.w === 'string' ? m.w.trim() : '';
        if (!w) continue;
        const at = text.indexOf(w, from);
        if (at < 0) continue;
        cues.push({ t: m.t, at });
        from = at + w.length;
      }
      return cues;
    }

    /* Where the voice is in the caption, in characters. With cues this is the
       last word the synthesiser said it had started; without them it falls
       back to the old guess — the clip's duration spread evenly across its
       characters — which is wrong in a readable way rather than absent. */
    function charAt(u: Spoken, ms: number) {
      if (!u.cues.length) return u.ms ? (ms / u.ms) * u.text.length : u.text.length;
      let at = 0;
      for (const c of u.cues) {
        if (c.t > ms) break;
        at = c.at;
      }
      return at;
    }

    /* Queues one clip to begin the instant the previous one ends. Returns as
       soon as it is scheduled — the wait is the audio clock's job, not a
       promise's, and holding the chain here is what used to leave a hole. */
    function schedule(buf: AudioBuffer, text: string, marks: Mark[]) {
      const ctx = openAudio();
      if (!ctx || !analyser) return;
      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.connect(analyser);

      /* Butt up against whatever is already queued; if nothing is, start now
         with a hair of lead time so the scheduler is not chasing a moment that
         has already passed. */
      const at = Math.max(ctx.currentTime + 0.06, queuedUntil);
      queuedUntil = at + buf.duration;

      timeline.push({
        text,
        cues: cuesFor(text, marks),
        start: at,
        end: queuedUntil,
        ms: buf.duration * 1000,
      });

      playing.add(src);
      src.onended = () => playing.delete(src);
      src.start(at);
      runAmp();
    }

    /* Nothing to play. Silence beats the browser's own synthesiser, which is
       the voice this mode exists to get away from — so the line is skipped and
       the caption says so, in its turn rather than over whatever is speaking. */
    const SKIPPED_MS = 1.2;
    function scheduleSkip() {
      const ctx = openAudio();
      const at = Math.max((ctx?.currentTime ?? 0) + 0.06, queuedUntil);
      queuedUntil = at + SKIPPED_MS;
      timeline.push({
        text: '— that line would not load —',
        cues: [],
        start: at,
        end: queuedUntil,
        ms: SKIPPED_MS * 1000,
      });
      runAmp();
    }

    /* Fetches run as soon as a sentence is ready — several at once — while
       scheduling stays strictly in order on this chain. Waiting for one line to
       finish before requesting the next would put the round trip into every
       gap between sentences. */
    function enqueueHosted(text: string) {
      const gen = generation;
      const pending = fetchLine(text);
      chain = chain.then(async () => {
        if (gen !== generation) return;
        const line = await pending;
        if (gen !== generation) return;
        if (!line) return scheduleSkip();
        schedule(line.buf, text, line.marks);
      });
    }

    /* Speaks each complete sentence as it arrives rather than waiting for the
       whole answer, so the voice starts while the model is still writing. It
       also sidesteps a long-standing Chrome bug that truncates any single
       utterance running past roughly fifteen seconds, and it gives the
       subtitles a natural unit to show one at a time. */
    const SENTENCE = /[^.!?]+[.!?]+\s*/g;
    /* Every chunk boundary is an audible seam — two MP3s butted together each
       carry a little encoder padding — so the aim is the fewest cuts that
       still let the voice start before the model has finished writing. Below
       MIN we wait for more text rather than spend a seam on a short clause;
       MAX stays under the route's own 320-character limit. */
    const MIN_SPEAK = 140;
    const MAX_SPEAK = 300;

    const speakStream = (full: string, final = false) => {
      if (!voiceMode) return;
      const pending = full.slice(spokenUpTo);

      /* Walk the sentence ends and take the last one that fits. Cutting at a
         full stop is what makes the seam inaudible: the voice was going to
         pause there anyway. */
      let cut = 0;
      let m: RegExpExecArray | null;
      SENTENCE.lastIndex = 0;
      while ((m = SENTENCE.exec(pending))) {
        const end = m.index + m[0].length;
        if (end > MAX_SPEAK) break;
        cut = end;
      }

      /* One sentence longer than MAX has no full stop to cut at, so fall back
         to the last space that fits — mid-sentence, but at a word. */
      if (!cut && pending.length > MAX_SPEAK) {
        cut = pending.lastIndexOf(' ', MAX_SPEAK);
        if (cut < 1) cut = MAX_SPEAK;
      }

      // Hold short tails back until the answer is done.
      if (!final && cut < MIN_SPEAK) return;

      const chunk = final ? pending.slice(0, MAX_SPEAK) : pending.slice(0, cut);
      const line = plain(chunk);
      if (!line) {
        if (final) spokenUpTo += chunk.length;
        return;
      }
      spokenUpTo += chunk.length;
      enqueueHosted(line);

      // A final flush can leave more than one chunk's worth still unsaid.
      if (final && spokenUpTo < full.length) speakStream(full, true);
    };

    function setVoiceMode(on: boolean) {
      voiceMode = on;
      root.dataset.mode = on ? 'voice' : '';
      stage.hidden = !on;
      voiceBtn.hidden = on;
      if (on) runAmp(); // the field starts turning the moment the mode opens
      /* Announced on document rather than called directly: the player is a
         sibling component that may not be on the page at all, and this side of
         it should not have to know. MusicBlob decides what to do about it. */
      document.dispatchEvent(new CustomEvent('scout:voice', { detail: { on } }));
      if (!on) {
        stopSpeech();
        cap.textContent = '';
        asked.textContent = '';
      }
      input.focus();
    }

    /* Voice mode needs Web Audio and nothing else now. Without it there is
       nothing to offer, and the button stays hidden. */
    if (window.AudioContext || (window as any).webkitAudioContext) {
      voiceBtn.hidden = false;

      voiceBtn.addEventListener('click', () => {
        setVoiceMode(true);
        /* Web Audio is gesture-gated and this click is the only gesture voice
           mode gets — everything after it is driven by the stream. Opening and
           resuming the context here is what stops the browser suspending the
           graph before the first clip arrives. */
        openAudio()?.resume().catch(() => {});
      });
      voiceOff.addEventListener('click', () => setVoiceMode(false));

      // Speech outlives the document otherwise — it keeps talking on the next page.
      window.addEventListener('pagehide', stopSpeech);
    }

    /* Each turn is avatar + label + bubble rather than a bare bubble. Colour
       and alignment alone tell you *that* the speaker changed; the label and
       face tell you *who* it is, which is what someone scanning a transcript
       is actually looking for. Returns the text node so callers can stream
       into it. */
    function bubbleFor(role: 'user' | 'assistant' | 'error'): HTMLElement {
      const row = document.createElement('div');
      row.className = `turn turn--${role === 'user' ? 'me' : 'ai'}`;

      if (role !== 'user') {
        const ava = document.createElement('span');
        ava.className = 'turn__ava';
        ava.setAttribute('aria-hidden', 'true');
        row.appendChild(ava);
      }

      const col = document.createElement('div');
      col.className = 'turn__col';

      const label = document.createElement('span');
      label.className = 'turn__label';
      label.textContent = role === 'user' ? 'You' : name;

      const msg = document.createElement('div');
      msg.className = 'turn__msg';
      if (role === 'error') msg.classList.add('is-error');

      col.append(label, msg);
      row.appendChild(col);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return msg;
    }

    async function ask(text: string) {
      if (busy || !text.trim()) return;
      if (history.filter((m) => m.role === 'user').length >= SESSION_CAP) {
        bubbleFor('error').textContent =
          "That's my limit for one visit — email designs.bhupesh@gmail.com and he'll pick it up from here.";
        return;
      }

      busy = true;
      empty.hidden = true;
      root.dataset.state = 'thinking';
      setBase('idle');
      emit('ai:send');
      input.value = '';

      bubbleFor('user').textContent = text;
      history.push({ role: 'user', content: text });
      // Trim oldest turns rather than letting the request grow unbounded.
      if (history.length > MAX_TURNS) history = history.slice(-MAX_TURNS);

      const out = bubbleFor('assistant');
      out.dataset.pending = '1';
      out.append(...[0, 1, 2].map(() => document.createElement('i')));
      let acc = '';

      // A new question cuts off the old answer mid-sentence, as it should.
      stopSpeech();
      spokenUpTo = 0;
      if (voiceMode) {
        asked.textContent = text;
        // Held until the first utterance starts, so the subtitle never leads
        // the voice. The orb carries the wait.
        cap.textContent = '';
        capWords = [];
      }

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        if (!res.ok) {
          const { error } = await res.json().catch(() => ({ error: 'Something went wrong.' }));
          out.classList.add('is-error');
          out.textContent = error;
          return;
        }

        const reader = res.body!.getReader();
        const decoder = new TextDecoder();
        let buf = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          const parts = buf.split('\n\n');
          buf = parts.pop() ?? '';

          for (const part of parts) {
            const line = part.replace(/^data: /, '').trim();
            if (!line || line === '[DONE]') continue;
            const payload = JSON.parse(line);
            if (payload.error) {
              out.classList.add('is-error');
              out.textContent =
                "I couldn't answer that one. Try rephrasing, or email designs.bhupesh@gmail.com.";
              return;
            }
            /* Guarded rather than assumed: anything on this stream that is
               not a text payload must not be concatenated, or its `undefined`
               lands in the answer as a word. */
            if (typeof payload?.text !== 'string') continue;
            acc += payload.text;
            delete out.dataset.pending;
            renderReply(out, acc);
            speakStream(acc);
            log.scrollTop = log.scrollHeight;
          }
        }

        if (acc) {
          // Flush whatever tail never ended in a full stop.
          speakStream(acc, true);
          history.push({ role: 'assistant', content: acc });
          flash('excited', 2400); // it was just useful — let it show
          emit('ai:reply');
        }
      } catch {
        out.classList.add('is-error');
        out.textContent = 'Connection dropped. Try again in a moment.';
      } finally {
        delete out.dataset.pending;
        busy = false;
        root.dataset.state = panel.hidden ? 'idle' : 'open';
        setBase('idle');
        input.focus();
      }
    }

    /* ---- reply rendering ----
       The model may now use a deliberately tiny subset: `- ` bullets, **bold**,
       and bare site paths. Everything is built with createElement and
       textContent — there is still no innerHTML anywhere in this file, so the
       model cannot emit markup even if it tries. Anything outside the subset
       lands as literal text, which is the safe failure.

       Links are restricted to same-origin paths beginning with a slash. A full
       URL from the model is rendered as text, never as an anchor: the reply is
       partly shaped by whatever the visitor typed, so it is not a trustworthy
       source of destinations. */
    const INLINE = /\*\*([^*\n]+)\*\*|(\/[a-z0-9][a-z0-9/-]*)/gi;

    function inlineInto(parent: HTMLElement, text: string) {
      let last = 0;
      let m: RegExpExecArray | null;
      INLINE.lastIndex = 0;

      while ((m = INLINE.exec(text))) {
        const isPath = m[2] !== undefined;
        const before = m.index === 0 ? '' : text[m.index - 1];

        /* A path only counts at a word boundary. Without this, `</b>` linked to
           /b and `https://x.com` linked to /x — both same-origin and harmless,
           both visibly broken. */
        if (isPath && before && !/[\s(]/.test(before)) continue;

        if (m.index > last) {
          parent.appendChild(document.createTextNode(text.slice(last, m.index)));
        }

        if (isPath) {
          const a = document.createElement('a');
          a.href = m[2];                        // same-origin path, never a URL
          a.className = 'turn__link';
          a.textContent = m[2];
          parent.appendChild(a);
        } else {
          const b = document.createElement('strong');
          b.textContent = m[1];
          parent.appendChild(b);
        }
        last = m.index + m[0].length;
      }

      if (last < text.length) {
        parent.appendChild(document.createTextNode(text.slice(last)));
      }
    }

    function renderReply(host: HTMLElement, raw: string) {
      host.textContent = '';
      let list: HTMLUListElement | null = null;

      for (const line of raw.split('\n')) {
        const t = line.trim();
        if (!t) { list = null; continue; }

        const bullet = t.match(/^[-*\u2022]\s+(.*)$/);
        if (bullet) {
          if (!list) {
            list = document.createElement('ul');
            list.className = 'turn__list';
            host.appendChild(list);
          }
          const li = document.createElement('li');
          inlineInto(li, bullet[1]);
          list.appendChild(li);
          continue;
        }

        list = null;
        const para = document.createElement('p');
        para.className = 'turn__para';
        inlineInto(para, t);
        host.appendChild(para);
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });

    for (const chip of Array.from(root.querySelectorAll<HTMLButtonElement>('[data-chip]'))) {
      chip.addEventListener('click', () => ask(chip.textContent!.trim()));
    }
  }
</script>

<style>
  .ai {
    position: fixed;
    right: max(20px, 3vw);
    bottom: 22px;
    z-index: 55; /* over the progressive blur (40) and nav (50) */
    font-family: "Inter", "Nunito", system-ui, sans-serif;
  }

  .ai [hidden] { display: none; }

  /* ---------------- the blob ----------------
     A soft sphere, not a liquid shape: the character comes from the face and
     the motion, so the silhouette stays calm and the gradient does the volume.
     The button owns press/focus; .ai__body owns the living motion, so the two
     never fight over `transform`. */
  .ai__blob {
    position: relative;
    display: block;
    width: 68px;
    height: 68px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* Contact shadow on the ground, well below the sphere. */
    filter: drop-shadow(0 14px 16px rgba(30, 50, 170, 0.34));
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ai__blob:active { transform: scale(0.94); }
  .ai__blob:focus-visible { outline: 2px solid var(--blue-500); outline-offset: 5px; }

  .ai__body {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* Lit from the upper left: a bright highlight, a deep terminator at the
       lower right, and a faint bounce coming back up off the ground. */
    background:
      radial-gradient(42% 38% at 33% 26%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%),
      radial-gradient(58% 55% at 30% 24%, #7d97ff 0%, rgba(125, 151, 255, 0) 68%),
      radial-gradient(45% 42% at 74% 82%, #6d88ff 0%, rgba(109, 136, 255, 0) 70%),
      radial-gradient(118% 118% at 32% 26%, #5a76ff 0%, #3b5bf6 46%, #2842e2 80%, #2036c9 100%);
    box-shadow:
      inset -5px -7px 16px rgba(16, 30, 130, 0.34),
      inset 3px 4px 12px rgba(255, 255, 255, 0.2);
    /* Alive at rest — a slow breath, never a bounce. */
    animation: ai-breathe 4.6s ease-in-out infinite;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ai__blob:hover .ai__body { transform: scale(1.07); }

  @keyframes ai-breathe {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-3px) scale(1.022, 0.985); }
  }

  /* Thinking: the breath quickens a little. */
  /* Keyed to data-state, not data-mood: the quicker breath is the waiting
     cue now that the face no longer changes for it. */
  .ai[data-state="thinking"] .ai__body { animation-duration: 1.5s; }

  /* Noticing a new fold — a single squash-and-settle. */
  .ai[data-mood="curious"] .ai__body { animation: ai-notice 0.66s cubic-bezier(0.3, 1.3, 0.5, 1); }
  @keyframes ai-notice {
    0% { transform: scale(1); }
    30% { transform: scale(1.1, 0.9) translateY(3px); }
    62% { transform: scale(0.96, 1.06) translateY(-5px); }
    100% { transform: scale(1) translateY(0); }
  }

  /* ---------------- the face ----------------
     Two capsules and an arc. The whole face translates as one when it looks
     around — a character this simple reads as turning its head, where moving
     pupils inside eyeballs would read as a different, busier creature. */
  .ai__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    /* Written by the gaze handler. */
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ai__f,
  .ai__fx,
  .ai__gear {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ai__f > *,
  .ai__fx > * {
    opacity: 0;
    transition: opacity 0.17s ease;
  }
  /* Strokes for the drawn features, fills for the solid ones. */
  .ai__f path:not(.m-open),
  .ai__fx .fx-line {
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai__f rect,
  .ai__f circle,
  .ai__f .m-open,
  .ai__fx .fx-spark { fill: #fff; }
  .ai__fx .fx-line { stroke-width: 2.2; opacity: 0; }

  /* ---- expressions ----
     Written inverted on purpose: every feature is hidden by default and each
     rule lists the moods that reveal it. The obvious shape — hide-everything
     then re-show a few — puts two rules of equal specificity against each
     other, and the reset wins as often as not. This way nothing competes. */

  .ai__f > *, .ai__fx > * { opacity: 0; }

  /* eyes */
  .ai[data-mood="idle"] .e-cap,
  .ai[data-mood="excited"] .e-cap,
  .ai[data-mood="guiding"] .e-cap,
  .ai[data-mood="curious"] .e-cap:first-of-type,   /* the other drops to a dot */
  .ai[data-mood="greet"] .e-cap:last-of-type,      /* the other winks */
  .ai[data-mood="curious"] .e-dot,
  .ai[data-mood="happy"] .e-up,
  .ai[data-mood="relaxed"] .e-down,
  .ai[data-mood="greet"] .e-wink { opacity: 1; }

  /* mouths */
  .ai[data-mood="idle"] .m-neutral,
  .ai[data-mood="curious"] .m-neutral,
  .ai[data-mood="relaxed"] .m-neutral,
  .ai[data-mood="happy"] .m-smile,
  .ai[data-mood="greet"] .m-smile,
  .ai[data-mood="guiding"] .m-smile,
  .ai[data-mood="excited"] .m-open { opacity: 1; }

  /* decorations */
  .ai[data-mood="excited"] .fx-spark { opacity: 1; animation: ai-spark 0.7s ease; }
  .ai[data-mood="guiding"] .fx-line { opacity: 0.75; animation: ai-lines 1.1s ease-in-out infinite; }

  @keyframes ai-spark {
    0% { opacity: 0; transform: scale(0.3) rotate(-40deg); transform-origin: 53px 18px; }
    55% { opacity: 1; transform: scale(1.15) rotate(8deg); transform-origin: 53px 18px; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes ai-lines {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.8; }
  }

  /* CURIOUS also tilts the head — the part that sells "noticing". */
  .ai[data-mood="curious"] .ai__face { rotate: -7deg; }

  /* Blink overlays whatever mood is running, but only where the eyes are
     actually open — closed-eye moods have nothing left to close. */
  .ai[data-blink]:not([data-mood="happy"]):not([data-mood="relaxed"]):not([data-mood="greet"]) .e-cap {
    transform-box: fill-box;
    transform-origin: center;
    scale: 1 0.16;
  }
  .ai .e-cap { transition: opacity 0.17s ease, scale 0.1s ease; }

  /* ---------------- costumes ----------------
     Drawn in the same layer as the sphere, so the breath and the squash carry
     the gear with them — a headband that stays still while the head moves is
     the thing that gives the trick away.

     Everything is off by default and switched on by one `data-costume` value,
     so a second costume is a new block, not an edit to this one. */

  .ai__gear > * { opacity: 0; }

  .gear-band__cloth { fill: url(#aiBandFace); }
  .gear-band__stripe { fill: #2743e0; }
  .gear-bell__bar { fill: #9aa3bd; }
  .gear-bell__plate { fill: #252c3c; }

  /* Rotation lives on the inner group: the clip is on the parent, so the band
     can be tilted and animated without dragging its own mask around with it. */
  .gear-band__in {
    transform-box: view-box;
    transform-origin: 32px 16px;
    rotate: -6deg;
  }

  .ai[data-costume="fitness"] .gear-band,
  .ai[data-costume="fitness"] .gear-bell { opacity: 1; }

  /* Dropped on rather than faded in — the clip means it can start above the
     crown and arrive, which is what makes it read as put on. */
  .ai[data-costume="fitness"] .gear-band__in {
    animation: ai-band-on 0.52s cubic-bezier(0.3, 1.25, 0.5, 1) both;
  }
  @keyframes ai-band-on {
    from { transform: translateY(-14px); }
    to { transform: none; }
  }

  /* One slow curl on a long cycle, so it's an occasional flicker of life
     rather than a thing pumping away in the corner of the page. */
  .gear-bell {
    transform-box: view-box;
    /* Pivots at the inner plate — the end nearest the body, so the far end
       swings up the way a curl actually travels. */
    transform-origin: 8.6px 52px;
    transition: opacity 0.35s ease 0.12s;
  }
  .ai[data-costume="fitness"] .gear-bell {
    animation: ai-curl 5.4s ease-in-out 0.9s infinite;
  }
  /* Positive rotation lifts the outer end: the pivot is the inner plate, and
     y runs down in SVG, so the sign is the opposite of the obvious one. */
  @keyframes ai-curl {
    0%, 56%, 100% { transform: none; }
    67% { transform: translateY(-4px) rotate(16deg); }
    80% { transform: translateY(1px) rotate(-4deg); }
    90% { transform: none; }
  }

  /* ---------------- nudge bubble ---------------- */
  .ai__bubble {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    width: max-content;
    max-width: 250px;
    padding: 13px 34px 13px 16px;
    border-radius: 16px 16px 4px 16px;
    background: rgba(20, 24, 42, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    backdrop-filter: blur(14px) saturate(150%);
    box-shadow: 0 16px 40px rgba(12, 20, 45, 0.28);
    animation: ai-pop 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .ai__bubble p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: #fff;
  }
  .ai__bubbleNo {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .ai__bubbleNo svg { width: 11px; height: 11px; }
  .ai__bubbleNo:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }

  @keyframes ai-pop {
    from { opacity: 0; transform: translateY(8px) scale(0.94); }
    to { opacity: 1; transform: none; }
  }

  /* ---------------- chat panel ---------------- */
  .ai__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 40px));
    height: min(520px, calc(100vh - 140px));
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e9ecf3;
    box-shadow: 0 30px 70px rgba(10, 20, 60, 0.26);
    transform-origin: bottom right;
    animation: ai-panel 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes ai-panel {
    from { opacity: 0; transform: scale(0.86) translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .ai__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 14px 15px 18px;
    border-bottom: 1px solid #eef0f5;
  }
  .ai__title { margin: 0; font-size: 14px; font-weight: 600; color: #0b0d12; }
  .ai__close {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(17, 19, 24, 0.06);
    color: #14161c;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .ai__close:hover { background: rgba(17, 19, 24, 0.13); }
  .ai__close svg { width: 12px; height: 12px; }

  /* Sits in the form beside Send, so it matches that button's size and
     shape rather than the header's. Outlined, not filled — Send is the
     primary action in this row and only one of them should look it. */
  .ai__voiceBtn {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--blue-300, #74a5ff);
    border-radius: 50%;
    background: rgba(0, 89, 255, 0.07);
    color: var(--blue-500, #0059ff);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ai__voiceBtn:hover {
    background: var(--blue-500, #0059ff);
    border-color: var(--blue-500, #0059ff);
    color: #fff;
  }
  .ai__voiceBtn:focus-visible { outline: 2px solid var(--blue-500, #0059ff); outline-offset: 2px; }
  .ai__voiceBtn svg { width: 17px; height: 17px; }
  .ai__voiceBtn[hidden] { display: none; }

  /* ---------------- voice stage ----------------
     Laid over the transcript, not swapped with it, so the log keeps filling
     underneath and leaving the mode reveals a conversation that carried on. */
  /* Takes the log's slot in the panel's flex column rather than being pinned
     over it with offsets — the header grew when the Voice button landed in it,
     and any hardcoded inset would have been wrong from that moment on. */
  .ai__stage {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 26px 18px;
    text-align: center;
    animation: ai-stage-in 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  /* The UA's [hidden] rule loses to the class selector above. */
  .ai__stage[hidden] { display: none; }
  /* Hidden, not unmounted: the transcript keeps filling while you listen, so
     leaving voice mode reveals a conversation that carried on. */
  .ai[data-mode='voice'] .ai__log { display: none; }
  @keyframes ai-stage-in {
    from { opacity: 0; transform: scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- the orb ----
     A canvas, sized in CSS and backed at 2x for retina. The shader loop
     lives in the script and reads the same `amp` the speech drives, so this
     rule only has to place it. */
  .ai__orb {
    position: relative;
    width: 180px;
    height: 180px;
    flex: 0 0 auto;
  }
  .ai__orb canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai__asked {
    margin: 0;
    max-width: 30ch;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.4;
    color: #8b91a0;
  }

  /* One utterance at a time, set large enough to read from back in your chair
     — the whole point of the mode is that you are not leaning in. */
  .ai__cap {
    margin: 0;
    max-width: 34ch;
    /* A window, not a block. min-height stops the first line shoving the
       button down; max-height stops a long sentence from overflowing the
       stage and printing itself over that button, which is what it did. The
       script scrolls this to follow the spoken word. */
    min-height: 2.9em;
    max-height: 5.8em;
    overflow-y: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
    /* Whatever falls outside the window fades instead of ending on a hard
       edge, so a partly-scrolled line reads as more text rather than as a
       rendering fault. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 86%, transparent 100%);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.2px;
    color: #c3c8d4;
  }
  /* The per-word spans are styled in the is:global block below, not here:
     scoped styles match on a data-astro-cid attribute that Astro stamps onto
     template elements, and those spans are built at runtime by setCaption(),
     so they never carry it. Same reason .turn__link lives down there. */

  .ai__voiceOff {
    margin-top: 4px;
    padding: 7px 14px;
    border: 0;
    border-radius: 999px;
    background: rgba(17, 19, 24, 0.06);
    color: #4a5162;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
