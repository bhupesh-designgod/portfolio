---
/* The same metal, milled down to a button — and the switch that turns the
 * camera on.
 *
 * Clicking it asks for camera access, and once the answer is yes the button's
 * own surface starts reflecting, along with every other reflective surface on
 * the page. It is the only control here that requests the camera directly, so
 * it carries the whole state machine in its label: what it will do, that it is
 * asking, that it is on, and what went wrong if it is not.
 *
 * Where the card is a slab, this is a machined part — the grain is brushed
 * finer, because at 54px tall the card's streak spacing would put about four
 * visible lines across the entire button.
 */
interface Props {
  id?: string;
  class?: string;
}

const { id = `rb-${Math.random().toString(36).slice(2, 8)}`, class: className = '' } = Astro.props;
---

<button class:list={['rb', className]} type="button" data-rb data-state="idle">
  <svg class="rb__defs" aria-hidden="true" focusable="false">
    <defs>
      <filter
        id={`${id}-brush`}
        x="-10%"
        y="-10%"
        width="120%"
        height="120%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.01 2.6"
          numOctaves="2"
          seed="4"
          result="noise"
        />
        <feColorMatrix
          in="noise"
          type="matrix"
          values="0 0 0 0 0.5
                  0 0 0 0 0.5
                  0 0 0 0 0.5
                  0.5 0.35 0.15 0 0"
          result="grey"
        />
        <feComponentTransfer in="grey">
          <feFuncA type="linear" slope="0.5" intercept="0.24" />
        </feComponentTransfer>
      </filter>

      {/* Same glass as the card, at a tenth the area. No bump map and no
          specular pass — that pair is what made the old surface read as frost.
          The field is scaled to the button: a frequency low enough to bend the
          whole pill in one curve rather than ripple across it. */}
      <filter id={`${id}-liquid`} x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.012 0.02"
          numOctaves="1"
          seed="5"
          result="warp"
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="warp"
          scale="16"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>

    </defs>
  </svg>

  <span class="rb__metal" aria-hidden="true"></span>
  <span class="rb__brush" style={`filter:url(#${id}-brush)`} aria-hidden="true"></span>
  <span class="rb__grain" aria-hidden="true"></span>

  <video
    class="rb__glass"
    data-rb-cam
    style={`filter:blur(7px) url(#${id}-liquid)`}
    muted
    playsinline
    autoplay
    aria-hidden="true"></video>

  <span class="rb__spec" aria-hidden="true"></span>
  <span class="rb__edge" aria-hidden="true"></span>

  {/* The label is the state readout, so it is a live region — someone using a
     screen reader gets told the camera came on, same as everyone else. */}
  <span class="rb__label" data-rb-label aria-live="polite"><slot>Turn the reflection on</slot></span>
</button>

<script>
  import { attach, onState, release, request, getState } from '../lib/reflective';

  const COPY: Record<string, string> = {
    idle: 'Turn the reflection on',
    asking: 'Waiting for the camera…',
    live: 'Reflection on — click to stop',
    denied: 'Camera blocked. Allow it in the address bar',
    unavailable: 'No camera available here',
  };

  for (const el of document.querySelectorAll<HTMLButtonElement>('[data-rb]')) {
    const label = el.querySelector<HTMLElement>('[data-rb-label]');
    const cam = el.querySelector<HTMLVideoElement>('[data-rb-cam]');

    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
    });
    el.addEventListener('pointerleave', () => el.style.setProperty('--mx', '30%'));

    el.addEventListener('click', () => {
      if (getState() === 'live') {
        release();
        return;
      }
      /* Attach before asking, so the frames land the moment permission is
         granted rather than a repaint later. */
      if (cam) attach(cam);
      request();
    });

    onState((s) => {
      el.dataset.state = s;
      /* Only ever swap the text — replacing the node would drop it out of the
         live region and the announcement with it. */
      if (label) label.textContent = COPY[s] ?? COPY.idle;
      el.setAttribute('aria-pressed', String(s === 'live'));
      el.disabled = s === 'unavailable';
    });
  }
</script>

<style>
  .rb {
    --mx: 30%;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 30px;
    border: 0;
    border-radius: 999px;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    background: #10141c;
    box-shadow:
      0 10px 26px rgba(8, 12, 24, 0.4),
      0 1px 0 rgba(255, 255, 255, 0.14) inset;
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }
  .rb:hover {
    transform: translateY(-1px);
    box-shadow:
      0 14px 32px rgba(8, 12, 24, 0.46),
      0 1px 0 rgba(255, 255, 255, 0.2) inset;
  }
  .rb:active {
    transform: translateY(0);
  }
  .rb:focus-visible {
    outline: 2px solid var(--blue-500);
    outline-offset: 3px;
  }
  .rb[disabled] {
    cursor: default;
    opacity: 0.55;
  }
  .rb[disabled]:hover {
    transform: none;
  }

  .rb__defs {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .rb__metal {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      104deg,
      #2b3341 0%,
      #6f7b95 14%,
      #212936 30%,
      #57637a 48%,
      #1d2430 64%,
      #77839d 80%,
      #29313f 96%
    );
  }

  .rb__brush {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.58;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background: #808080;
  }

  .rb__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.1;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* Explicitly sized: a video is a replaced element, and width:auto takes its
     intrinsic width rather than filling the box. */
  .rb__glass {
    position: absolute;
    left: -10%;
    top: -10%;
    width: 120%;
    height: 120%;
    z-index: 2;
    object-fit: cover;
    opacity: 0;
    transform: scaleX(-1);
    pointer-events: none;
    transition: opacity 0.7s ease;
  }
  .rb[data-state='live'] .rb__glass {
    opacity: 0.88;
  }
  .rb[data-state='live'] .rb__brush {
    opacity: 0.2;
  }

  /* Only the horizontal position tracks the pointer. On something this short a
     vertical highlight has nowhere to go and just looks noisy. */
  .rb__spec {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(
        34% 120% at var(--mx) 34%,
        rgba(255, 255, 255, 0.95),
        rgba(255, 255, 255, 0.2) 46%,
        transparent 72%
      ),
      linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0) 46%);
    transition: background 0.08s linear;
  }
  .rb[data-state='live'] .rb__spec {
    opacity: 0.5;
  }

  .rb__edge {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.85),
      rgba(255, 255, 255, 0.12) 52%,
      rgba(255, 255, 255, 0.4)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  .rb__label {
    position: relative;
    z-index: 5;
    font-family: 'Inter', 'Nunito', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: #f2f5fa;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .rb,
    .rb__spec,
    .rb__glass {
      transition: none;
    }
    .rb:hover {
      transform: none;
    }
  }
</style>
