---
import WaterSurface from './WaterSurface.astro';

interface Props {
  name?: string;
  avatar?: string;
}
const { name = 'Bhupesh Parmar', avatar = '/assets/avatar.png' } = Astro.props;

---

<!-- .hero-wrap is the scroll runway that drives the white panel's expansion -->
<div class="hero-wrap" id="heroWrap">
  <section class="hero">
    {/* Layered gradient / texture / glass background.
        data-hero-tint marks this as the one surface the music player may
        recolour. It is a deliberate opt-in rather than a class lookup: the
        case study pages build their own dark, per-project accented field
        (.cs-hero__bg) and must never be retinted by whatever is playing.
        Not `data-mood` — AiBlob already owns that attribute, on every page. */}
    <div class="hero__bg" data-hero-tint aria-hidden="true">
      {/* The tinted layers, twice. `base` is what you see; `next` sits on top
          at opacity 0 holding the incoming palette, and the music player
          crossfades it in. Fading one stack over another is the only way to
          change these colours smoothly — animating the colours themselves
          means re-rasterising five gradients, a 160px blur and a color-burn
          layer every frame, which janks. Opacity stays on the compositor.

          Both copies are in the DOM from load so their drift animations run
          from the same start time. A duplicate created on demand would begin
          its 37–73s cycles out of phase, and the crossfade would ghost. */}
      {(['base', 'next'] as const).map((role) => (
        <div
          class:list={['hero__tint', role === 'next' && 'hero__tint--next']}
          data-tint={role}
        >
          <div class="hero__blobs"></div>
          <div class="hero__orb hero__orb--a"></div>
          <div class="hero__orb hero__orb--b"></div>
          <div class="hero__orb hero__orb--c"></div>
          <div class="hero__burn"></div>
          <div class="hero__glow"></div>
        </div>
      ))}
      <WaterSurface class="hero__water" />
      <div class="hero__glass"></div>
      <div class="hero__grain"></div>
    </div>

    <!-- White panel: floats as a rounded card, expands to full-bleed on scroll -->
    <div class="hero__panel" id="heroPanel">
      <div class="hero__content">
        <div class="hero__stack">
          <div class="hero__chip">
            <img class="hero__ava" src={avatar} alt={`Portrait of ${name}`} width="400" height="400" />
            <span class="hero__chipTxt">
              <b class="hero__name">{name}</b>
              <span class="hero__kind">Product Designer</span>
            </span>
          </div>

          {/* Written in sentence case and uppercased in CSS: Bebas Neue only
              has caps, but the DOM should still read as a normal sentence for
              screen readers and search. The two spans force the break — left
              to itself the ampersand orphans onto line two. */}
          <h1 class="hero__title">
            <span>Designing for consumer &amp;</span>{' '}
            <span>enterprise products</span>
          </h1>

          <p class="hero__sub">
            Hi! My name is <b>Bhupesh</b>, with two design degrees and around a
            year of <b>professional experience</b>.
          </p>

          <div class="hero__acts">
            <a class="hero__btn" href="/about">
              See my journey
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M12.5 6.5 19 12l-6.5 5.5" fill="none" stroke="currentColor"
                  stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a class="hero__ghost" href="#work">Skip to work</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{/* Runs during parse so the nav starts light over the blue — no flash of dark
    labels before the module script below boots. */}
<script is:inline>document.documentElement.dataset.navTone = 'dark';</script>

<script>
  /* Drives the white panel's expansion as you scroll through the hero runway.
     progress 0 -> card floats over the gradient
     progress 1 -> panel fills the viewport, flowing into the section below */
  const wrap = document.getElementById('heroWrap');
  const root = document.documentElement;
  const navPill = document.querySelector<HTMLElement>('.nav__pill');
  /* The --panel-* props are read by .hero__panel and nothing else, so they get
     set on the panel itself. Writing them to :root invalidated style for every
     element on the page, on every scrolled frame. */
  const panel = document.getElementById('heroPanel');

  if (wrap && panel) {
    // Radius and shadow both land on 0 so the expanded panel reads as one
    // continuous white surface with the section below it.
    const from = { top: 14, x: 8, bottom: -22, radius: 60, shadow: 0.28 };
    const to = { top: 0, x: 0, bottom: 0, radius: 0, shadow: 0 };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let ticking = false;

    function update() {
      ticking = false;
      // Runway = hero-wrap height minus one viewport (the sticky travel distance).
      const travel = wrap!.offsetHeight - window.innerHeight;
      const p = reduce ? 0 : clamp(window.scrollY / (travel || 1));

      const s = panel!.style;
      s.setProperty('--panel-top', lerp(from.top, to.top, p) + '%');
      s.setProperty('--panel-x', lerp(from.x, to.x, p) + '%');
      s.setProperty('--panel-bottom', lerp(from.bottom, to.bottom, p) + '%');
      s.setProperty('--panel-radius', lerp(from.radius, to.radius, p) + 'px');
      s.setProperty('--panel-shadow', String(lerp(from.shadow, to.shadow, p)));

      /* The panel's top edge is the light/dark boundary. While it sits below
         the nav, the nav is over blue; once it rises past, the nav is on white. */
      const panelTopPx = (lerp(from.top, to.top, p) / 100) * window.innerHeight;
      const navBottom = navPill ? navPill.getBoundingClientRect().bottom : 70;
      root.dataset.navTone = panelTopPx > navBottom ? 'dark' : 'light';
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

</script>
