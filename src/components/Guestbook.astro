---
/* The guestbook — the last thing before the footer.
 *
 * Everything above this section asks the reader to take something in. This one
 * asks them to leave something behind, and the exchange only works if what they
 * leave is worth making: so the thing they leave is a pass they designed. Pick a
 * pattern, pick a finish, reshuffle until it's yours, sign it — and then find it
 * on the wall. Make a thing, see the thing. That round trip is the section.
 *
 * Two rules that are load-bearing:
 *
 * 1. The pass is BLANK at rest — an unfilled form, no call to action. Only when
 *    the pointer reaches it does it say what it's for. A permanent CTA competes
 *    with the headline; a blank card is a question the reader chooses to ask.
 *
 * 2. The art is generated from a theme and a seed, never uploaded. Two numbers
 *    and a name reproduce the card exactly, on any card size, forever.
 *
 * The wall renders whatever was passed in at build time, then replaces itself
 * with the live list once `/api/guestbook` answers. So the section is complete
 * and honest with no network at all, and current when there is one.
 */
import { asciiArt, THEMES } from '../lib/ascii-art';
import { cardHtml, FINISHES, type CardEntry } from '../lib/guestbook-card';

interface Props {
  entries?: CardEntry[];
  /* Slots on the wall: three across, two down. The pass is a landscape card, so
     three to a row is what keeps it big enough for the art to be worth looking
     at — which is the entire reason someone made one. */
  slots?: number;
}

const { entries = [], slots = 6 } = Astro.props;

/* The count card occupies a slot, so it only earns one when it would stand for
   more than the card it displaced. */
const shown = entries.length <= slots ? entries : entries.slice(0, slots - 1);
const rest = entries.length - shown.length;

/* Why someone is here, in the order the answers actually turn up. `Other` is
   last because it's the shrug, and a shrug should never be the first option. */
const reasons = ['Hiring', 'Collaboration', 'Just exploring', 'Industry buddy', 'Other'];
---

<section class="gb" id="guestbook">
  <div class="gb__wrap">
    <div class="gb__top">
      <div class="gb__intro">
        <h2 class="gb__title">Leave a little mark.</h2>
        {/* Less a comment box than a bench with initials carved in it. The
            old line read as a request for feedback on the site, which is not
            what this is: nobody is being asked to review anything, only to
            leave a trace that they came by. */}
        <p class="gb__lead">
          Less a comment box, more carving your initials into a bench. Make
          yourself a pass, sign it, and it stays on the wall.
        </p>
      </div>

      {/* The blank pass. A button, not a div with a click handler — it has to be
          reachable on a keyboard, and the hover reveal is mirrored on :focus so
          a tab lands somewhere that explains itself. The wrapper carries the
          perspective; the tilt script transforms the button inside it. */}
      <div class="gb__passWrap" data-gb-tilt>
        <button type="button" class="gb__pass gbc gbc--paper" data-gb-open>
          <pre class="gbc__art" aria-hidden="true">{asciiArt('waves', 22, 15, 7)}</pre>

          {/* The pass with nothing written on it yet. A plain rectangle says
              nothing; an empty form says what is about to happen, and it still
              counts as blank because none of the fields have answers. It fades
              back as the call to action comes forward, so the two are never
              both competing for the same middle of the card. */}
          <span class="gb__ghost" aria-hidden="true">
            <span class="gbc__mark">The guestbook</span>
            <span class="gb__ghostRow"><i>Visitor</i><em></em></span>
            <span class="gb__ghostRow"><i>Issued on</i><em></em></span>
            <span class="gb__ghostSign"><i>X</i><em></em></span>
          </span>

          <span class="gb__passFace">
            <span class="gb__plus" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 6.5v11M6.5 12h11" stroke="currentColor" stroke-width="2.6"
                  stroke-linecap="round"></path>
              </svg>
            </span>
            <span class="gb__passLabel">Add yours</span>
          </span>
        </button>
      </div>

    </div>

    {/* Below the band, not tucked into it. It used to share a grid row with the
        lower half of the pass, which only worked while the left column was tall
        enough to fill the pass's height. With the marginal note gone and the
        lead down to two lines it no longer is, and the tuck opened a hole under
        the copy instead of closing one. */}
    <div class="gb__wallHead">
      <h3 class="gb__wallTitle">Who&rsquo;s been here?</h3>
      <p class="gb__wallSub" data-gb-sub>
        {
          entries.length
            ? 'Some kind people have already left a mark.'
            : 'Nobody yet. The first card here is going to age well.'
        }
      </p>
    </div>

    <ul class="gb__wall" data-gb-wall>
      {shown.map((e) => <li class="gb__slot" set:html={cardHtml(e)} />)}

      {/* Nothing signed yet. A dashed slot rather than an empty row, so the wall
          still reads as a wall and the invitation is where the first card will
          be. Removed the moment a real entry arrives. */}
      {entries.length === 0 && (
        <li class="gb__empty" data-gb-empty>
          <span class="gb__emptyPlus" aria-hidden="true">+</span>
          <p class="gb__emptyCopy">Yours could be the first one here.</p>
        </li>
      )}

      {/* The overflow card. Not a link yet — the wall page doesn't exist, and a
          card with an arrow that goes nowhere is worse than no card. */}
      <li class="gb__count" data-gb-count hidden={rest === 0}>
        <span class="gb__countDots" aria-hidden="true"><i></i><i></i><i></i></span>
        <p class="gb__countNum" data-gb-count-num>+ {rest} others</p>
        <p class="gb__countCopy">People from around the world have left a mark too.</p>
      </li>
    </ul>
  </div>
</section>

{/* ------------------------------ the studio ------------------------------
    Not a form with a preview bolted on — the card is the subject and the
    controls sit under it, so every change is watched rather than described.
    A native <dialog>, so Escape, the focus trap and the backdrop are the
    browser's problem rather than three more listeners. */}
<dialog class="gbd" data-gb-dlg aria-labelledby="gbd-title">
  <form class="gbd__note" method="dialog" data-gb-form>
    <div class="gbd__head">
      <h2 class="gbd__title" id="gbd-title">Welcome, visitor.</h2>
      <p class="gbd__sub">Make yourself a pass. It goes straight on the wall.</p>
    </div>

    <div class="gbd__nameRow">
      <label class="gbd__nameLab" for="gbd-name">Name</label>
      <input class="gbd__in" id="gbd-name" name="name" type="text" maxlength="24" required
        autocomplete="name" placeholder="Your name" data-gb-name />
      {/* Borrow one instead. Not everyone wants their real name on a stranger's
          site, and the alternative to a made-up name is no signature at all. */}
      <button type="button" class="gbd__icon" data-gb-dice title="Borrow a name"
        aria-label="Borrow a name">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 12a8 8 0 0 1-13.7 5.6L4 15.5"
            stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path d="M20 4.5v4h-4M4 19.5v-4h4" stroke="currentColor" stroke-width="1.9"
            stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    {/* The live card, and the thing you sign. The signature line on the card is
        the pad — a separate box below it asked people to sign in one place and
        then showed them the result in another, which is not how signing
        anything works. */}
    <div class="gbd__stage" data-gb-preview></div>
    <p class="gbd__sigHint" data-gb-sig-hint>
      <span>Sign on the line &mdash; it&rsquo;s your card</span>
      <button type="button" class="gbd__clear" data-gb-clear hidden>Clear</button>
    </p>

    <div class="gbd__controls">
      <div class="gbd__ctl">
        <span class="gbd__ctlLab">Pattern</span>
        <div class="gbd__chips" role="radiogroup" aria-label="Pattern">
          {
            THEMES.map((t, i) => (
              <button type="button" class="gbd__chip" role="radio" data-gb-theme={t.key}
                aria-checked={i === 0 ? 'true' : 'false'}>{t.label}</button>
            ))
          }
        </div>
        <button type="button" class="gbd__icon gbd__icon--sm" data-gb-shuffle
          title="Shuffle the pattern" aria-label="Shuffle the pattern">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 12a8 8 0 0 1-13.7 5.6L4 15.5"
              stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path d="M20 4.5v4h-4M4 19.5v-4h4" stroke="currentColor" stroke-width="1.9"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>

      <div class="gbd__ctl">
        <span class="gbd__ctlLab">Finish</span>
        <div class="gbd__sw" role="radiogroup" aria-label="Finish">
          {
            FINISHES.map((f, i) => (
              <button type="button" class={`gbd__swatch gbd__swatch--${f.key}`} role="radio"
                data-gb-finish={f.key} aria-checked={i === 0 ? 'true' : 'false'}
                title={f.label} aria-label={f.label}></button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="gbd__fields">
      <label class="gbd__row">
        <span class="gbd__label">You&rsquo;re here to</span>
        <select class="gbd__in gbd__in--sel" name="reason" required data-gb-reason>
          {reasons.map((r) => <option value={r}>{r}</option>)}
        </select>
      </label>

      <label class="gbd__row">
        <span class="gbd__label">A quick note <i>(optional)</i></span>
        {/* "Love your work!" prompted a review. This prompts a trace. */}
        <input class="gbd__in" name="note" type="text" maxlength="90"
          placeholder="Passing through." data-gb-note />
      </label>
    </div>

    <p class="gbd__err" data-gb-err hidden></p>

    <div class="gbd__foot">
      <p class="gbd__thanks">Thanks for being here.</p>
      <div class="gbd__acts">
        <button type="button" class="gbd__ghostBtn" data-gb-cancel>Cancel</button>
        {/* Names the destination, not the transaction. "Submit" tells you a form
            went somewhere; this tells you where the thing you just made ends
            up, which is the only reason anyone filled it in. */}
        <button type="submit" class="gbd__go" data-gb-submit>Pin it to the wall</button>
      </div>
    </div>
  </form>
</dialog>

<script>
  import { cardHtml, borrowedName, serial, type Art } from '../lib/guestbook-card';

  /* Slots on the wall. Mirrors `slots` in the component frontmatter — the two
     have to agree or the wall reflows the moment the live list arrives. */
  const SLOTS = 6;

  const dlg = document.querySelector<HTMLDialogElement>('[data-gb-dlg]');
  const form = document.querySelector<HTMLFormElement>('[data-gb-form]');
  const wall = document.querySelector<HTMLUListElement>('[data-gb-wall]');
  const countCard = document.querySelector<HTMLLIElement>('[data-gb-count]');
  const countNum = document.querySelector<HTMLElement>('[data-gb-count-num]');
  const sub = document.querySelector<HTMLElement>('[data-gb-sub]');
  const err = document.querySelector<HTMLElement>('[data-gb-err]');
  const stage = document.querySelector<HTMLElement>('[data-gb-preview]');
  const nameIn = document.querySelector<HTMLInputElement>('[data-gb-name]');
  const noteIn = document.querySelector<HTMLInputElement>('[data-gb-note]');
  const reasonIn = document.querySelector<HTMLSelectElement>('[data-gb-reason]');

  /* ------------------------------- the tilt -------------------------------
   * The pass leans toward the pointer, the way a card does when you pick it up
   * to read it. Rotation is capped low: past about 12 degrees the type on the
   * face starts to skew visibly and the card stops reading as a card.
   *
   * Deliberately not React Bits' TiltedCard — the effect is a transform driven
   * by pointer position, and importing React to set one would put a framework
   * on a page that currently ships almost no JavaScript.
   */
  const tiltWrap = document.querySelector<HTMLElement>('[data-gb-tilt]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (tiltWrap && window.matchMedia('(pointer: fine)').matches && !still) {
    const cardEl = tiltWrap.querySelector<HTMLElement>('.gb__pass')!;
    const MAX = 11;      // degrees
    const EASE = 0.13;   // per frame; low enough that the card lags the hand

    let tx = 0, ty = 0, ts = 1;
    let cx = 0, cy = 0, cs = 1;
    let raf = 0;

    const frame = () => {
      cx += (tx - cx) * EASE;
      cy += (ty - cy) * EASE;
      cs += (ts - cs) * EASE;
      cardEl.style.transform =
        `rotateX(${cy.toFixed(3)}deg) rotateY(${cx.toFixed(3)}deg) scale(${cs.toFixed(4)})`;
      /* Park the loop once it has effectively arrived, rather than burning a
         frame a tick forever on a card nobody is touching. */
      if (Math.abs(tx - cx) + Math.abs(ty - cy) + Math.abs(ts - cs) * 60 < 0.01) {
        cardEl.style.transform = `rotateX(${ty}deg) rotateY(${tx}deg) scale(${ts})`;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    };
    const run = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    tiltWrap.addEventListener('pointermove', (e) => {
      const r = tiltWrap.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 2 * MAX;
      ty = -((e.clientY - r.top) / r.height - 0.5) * 2 * MAX;
      ts = 1.035;
      run();
    });
    const rest = () => { tx = 0; ty = 0; ts = 1; run(); };
    tiltWrap.addEventListener('pointerleave', rest);
    /* Keyboard focus gets the scale but no lean — there is no pointer to lean
       toward, and a card tilted at random would just look broken. */
    cardEl.addEventListener('focus', () => { ts = 1.035; run(); });
    cardEl.addEventListener('blur', rest);
  }

  /* ------------------------------ the draft ------------------------------ */
  const draft: { art: Art } = { art: { theme: 'waves', seed: 7, finish: 'paper' } };
  const today = new Date().toISOString();

  const hint = document.querySelector<HTMLElement>('[data-gb-sig-hint]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-gb-clear]');

  /* Full re-render. Only for things that change the card's structure or its
     artwork — never for typing, because it destroys the canvas the visitor may
     be mid-signature on. */
  function renderCard() {
    if (!stage) return;
    stage.innerHTML = cardHtml(
      {
        name: nameIn?.value.trim() || '',
        reason: reasonIn?.value ?? '',
        note: noteIn?.value.trim() || undefined,
        art: draft.art,
        date: today,
      },
      { live: true },
    );
    mountPad();
  }

  /* Typing path. Writes into the nodes that are already there, so the signature
     canvas survives and the card does not flash on every keystroke. */
  function syncText() {
    if (!stage) return;
    const name = nameIn?.value.trim() || '';
    const nameEl = stage.querySelector('.gbc__name');
    const noEl = stage.querySelector('.gbc__no');
    const noteEl = stage.querySelector<HTMLElement>('.gbc__note');
    const chip = stage.querySelector('.gbc__meta i');
    if (nameEl) nameEl.textContent = name || 'Your name';
    if (noEl) noEl.textContent = `No. ${serial(name || 'Your name', today)}`;
    if (chip) chip.textContent = reasonIn?.value ?? '';
    if (noteEl) {
      const v = noteIn?.value.trim() ?? '';
      noteEl.textContent = v;
      noteEl.hidden = !v;
    }
  }

  const mark = (nodes: NodeListOf<Element>, active: Element) =>
    nodes.forEach((n) => n.setAttribute('aria-checked', String(n === active)));

  const themeBtns = document.querySelectorAll('[data-gb-theme]');
  themeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      draft.art.theme = b.getAttribute('data-gb-theme') as Art['theme'];
      mark(themeBtns, b);
      renderCard();
    }),
  );

  const finishBtns = document.querySelectorAll('[data-gb-finish]');
  finishBtns.forEach((b) =>
    b.addEventListener('click', () => {
      draft.art.finish = b.getAttribute('data-gb-finish') as Art['finish'];
      mark(finishBtns, b);
      renderCard();
    }),
  );

  document.querySelector('[data-gb-shuffle]')?.addEventListener('click', () => {
    draft.art.seed = Math.floor(Math.random() * 997);
    renderCard();
  });

  document.querySelector('[data-gb-dice]')?.addEventListener('click', () => {
    if (nameIn) nameIn.value = borrowedName();
    syncText();
  });

  [nameIn, noteIn].forEach((el) => el?.addEventListener('input', syncText));
  reasonIn?.addEventListener('change', syncText);

  /* -------------------------- signing, on the card -------------------------
   * The canvas is mounted over the card's own signature line, so the pen lands
   * where the ink ends up. Strokes are captured in canvas pixels and normalised
   * to a 100x40 box on submit, so the wall can draw them at any card size.
   * Points are thinned as they arrive — a slow signature otherwise produces a
   * few thousand samples, and the whole charm of this is that it stays a couple
   * of hundred bytes.
   */
  type Pt = { x: number; y: number };
  let strokes: Pt[][] = [];
  let drawing = false;
  let pad: HTMLCanvasElement | null = null;

  /* Re-created whenever the card is re-rendered, then the existing strokes are
     drawn back onto it — so changing the pattern or the finish never costs
     somebody the signature they already wrote. */
  function mountPad() {
    const sig = stage?.querySelector<HTMLElement>('[data-gb-sig]');
    if (!sig) return;
    pad = document.createElement('canvas');
    pad.className = 'gbc__pad';
    sig.appendChild(pad);

    const r = pad.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    pad.width = Math.max(1, Math.round(r.width * dpr));
    pad.height = Math.max(1, Math.round(r.height * dpr));

    pad.addEventListener('pointerdown', (e) => {
      drawing = true;
      pad!.setPointerCapture(e.pointerId);
      strokes.push([at(e)]);
      /* Stops the pen dragging the dialog out from under itself. */
      e.preventDefault();
    });
    pad.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      const s = strokes[strokes.length - 1];
      const p = at(e);
      const last = s[s.length - 1];
      /* 2.5px of travel before a point counts. Below that it's tremor. */
      if (Math.hypot(p.x - last.x, p.y - last.y) < 2.5) return;
      s.push(p);
      repaint();
    });
    const stopDraw = () => {
      if (!drawing) return;
      drawing = false;
      reflectSigned();
    };
    pad.addEventListener('pointerup', stopDraw);
    pad.addEventListener('pointercancel', stopDraw);
    pad.addEventListener('pointerleave', stopDraw);

    repaint();
    reflectSigned();
  }

  function padCtx() {
    const ctx = pad?.getContext('2d');
    if (!ctx || !pad) return null;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    ctx.lineWidth = 2.2 * dpr;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    /* The four finishes run from white to near-black, so the ink has to be
       whatever the card's own text is rather than a fixed colour. Read off the
       card, not the stage: `--c-fg` is set by `.gbc--<finish>` on the card
       itself, so asking the wrapper gets nothing and falls back to dark, which
       on the ink finish is dark ink on a near-black card. */
    const card = stage?.querySelector('.gbc');
    ctx.strokeStyle =
      (card && getComputedStyle(card).getPropertyValue('--c-fg')?.trim()) || '#232838';
    return ctx;
  }

  function repaint() {
    const ctx = padCtx();
    if (!ctx || !pad) return;
    ctx.clearRect(0, 0, pad.width, pad.height);
    for (const s of strokes) {
      if (s.length < 2) continue;
      ctx.beginPath();
      ctx.moveTo(s[0].x, s[0].y);
      for (let i = 1; i < s.length; i++) ctx.lineTo(s[i].x, s[i].y);
      ctx.stroke();
    }
  }

  /* The hint is the affordance now that the labelled row is gone, so it has to
     disappear the moment it has been acted on — and Clear only exists once
     there is something to clear. */
  function reflectSigned() {
    const has = strokes.some((s) => s.length > 1);
    hint?.classList.toggle('is-signed', has);
    if (clearBtn) clearBtn.hidden = !has;
  }

  function at(e: PointerEvent): Pt {
    const r = pad!.getBoundingClientRect();
    return {
      x: ((e.clientX - r.left) / r.width) * pad!.width,
      y: ((e.clientY - r.top) / r.height) * pad!.height,
    };
  }

  clearBtn?.addEventListener('click', () => {
    strokes = [];
    repaint();
    reflectSigned();
  });

  /* Normalise to the 100x40 viewBox the cards use. Returns '' for anything too
     slight to be a signature, so a stray tap doesn't become a scribble. */
  function signPath(): string {
    const pts = strokes.flat();
    if (pts.length < 4 || !pad) return '';
    const xs = pts.map((p) => p.x);
    const ys = pts.map((p) => p.y);
    const minX = Math.min(...xs);
    const maxX = Math.max(...xs);
    const minY = Math.min(...ys);
    const maxY = Math.max(...ys);
    const w = Math.max(maxX - minX, 1);
    const h = Math.max(maxY - minY, 1);
    /* Fit on the tighter axis so the signature keeps its own proportions —
       stretching handwriting to fill a box is instantly wrong. */
    const k = Math.min(100 / w, 40 / h);
    const ox = (100 - w * k) / 2;
    const oy = (40 - h * k) / 2;

    const out = strokes
      .filter((s) => s.length > 1)
      .map(
        (s) =>
          'M' +
          s
            .map((p) => `${(ox + (p.x - minX) * k).toFixed(1)} ${(oy + (p.y - minY) * k).toFixed(1)}`)
            .join('L'),
      )
      .join('');
    return out.length > 1400 ? out.slice(0, out.lastIndexOf('L', 1400)) : out;
  }

  /* ------------------------------- dialog -------------------------------- */
  function open() {
    if (!dlg) return;
    err && (err.hidden = true);
    dlg.showModal();
    /* Rendered after showModal, not before: the card has no layout until the
       dialog is open, and the canvas backing store is sized from its box — size
       it too early and the first stroke lands at the wrong scale. */
    renderCard();
  }

  document.querySelector('[data-gb-open]')?.addEventListener('click', open);
  document.querySelector('[data-gb-cancel]')?.addEventListener('click', () => dlg?.close());
  /* Click on the backdrop — the dialog element itself, since the card inside is
     a child that stops the event reaching here. */
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  /* --------------------------------- wall -------------------------------- */
  function render(entries: any[], total: number) {
    if (!wall) return;
    /* An empty answer is not news. The store being unconfigured, empty, or
       briefly unreachable all look the same from here, and in every one of
       those cases the cards already on the page are the best available truth —
       so leave them alone rather than blanking the wall. */
    if (!entries.length) return;

    document.querySelector('[data-gb-empty]')?.remove();
    wall.querySelectorAll('.gb__slot').forEach((n) => n.remove());

    const show = total <= SLOTS ? entries.slice(0, SLOTS) : entries.slice(0, SLOTS - 1);
    const frag = document.createDocumentFragment();
    show.forEach((e) => {
      const li = document.createElement('li');
      li.className = 'gb__slot';
      li.innerHTML = cardHtml(e);
      frag.appendChild(li);
    });
    wall.prepend(frag);

    const restCount = Math.max(0, total - show.length);
    if (countCard) countCard.hidden = restCount === 0;
    if (countNum) countNum.textContent = `+ ${restCount} others`;
    if (sub && total) sub.textContent = 'Some kind people have already left a mark.';
  }

  /* Pull the live list once the section is worth showing. The build-time cards
     are already on screen, so a failure here changes nothing visible. */
  fetch('/api/guestbook')
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => d && render(d.entries ?? [], d.total ?? 0))
    .catch(() => {});

  /* -------------------------------- submit ------------------------------- */
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.querySelector<HTMLButtonElement>('[data-gb-submit]');
    const body = {
      name: nameIn?.value.trim() ?? '',
      reason: reasonIn?.value ?? '',
      note: noteIn?.value.trim() ?? '',
      sign: signPath(),
      art: draft.art,
    };
    if (!body.name) return;

    btn && (btn.disabled = true);
    btn && (btn.textContent = 'Pinning it up…');

    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const out = await res.json().catch(() => ({}));

      if (!res.ok) {
        if (err) {
          err.textContent = out.error ?? 'That did not go through. Try again in a moment.';
          err.hidden = false;
        }
        return;
      }

      /* Stamped, then handed over. The sweep is the moment the card stops being
         a draft — without it the dialog just vanishes and the wall silently has
         one more card on it, which is the same event with the join cut out. */
      const madeCard = stage?.querySelector('.gbc');
      if (madeCard && !still) {
        madeCard.classList.add('is-shining');
        await new Promise((r) => setTimeout(r, 900));
      }

      render(out.entries ?? [], out.total ?? 0);
      dlg?.close();
      form.reset();
      strokes = [];
      reflectSigned();

      /* The point of the whole section: the card you just made is on the wall,
         so put it in front of the person who made it, and mark it so it is
         obvious which one of them is theirs. */
      const fresh = document.querySelector<HTMLElement>('.gb__wall .gb__slot');
      if (fresh) {
        fresh.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
        fresh.classList.add('is-fresh');
        window.setTimeout(() => fresh.classList.remove('is-fresh'), 2600);
      }
    } catch {
      if (err) {
        err.textContent = 'No connection. Try again in a moment.';
        err.hidden = false;
      }
    } finally {
      btn && (btn.disabled = false);
      btn && (btn.textContent = 'Pin it to the wall');
    }
  });
</script>
