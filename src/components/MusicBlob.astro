---
/* Ambient music, as a liquid-glass blob docked to the nav pill's right edge.
 *
 * One looping track, one control: click the blob to play, click again to
 * pause. The waveform inside is the whole readout —
 *   idle    → a static waveform silhouette (never started)
 *   playing → the bars dance
 *   paused  → the bars flatten into a line
 * A hint bubble drops below it once per session, so the blob isn't a mystery
 * button.
 *
 * Material is the nav pill's, down to the tint: the same #liquidGlass
 * displacement map (defined once in Nav.astro), specular rim and top gloss.
 * The waveform is painted in --nav-ink, so it flips light over the blue hero
 * and dark over white exactly as the nav labels do.
 *
 * Rendered inside <header class="nav">, in the flex flow beside the pill, so
 * the two centre as one cluster and the blob can't run off a narrow screen.
 */
interface Track {
  title: string;
  artist: string;
  src: string;
  /* The colour this track "sounds like". Not painted anywhere directly — it is
     read for its hue and chroma, which the hero background rotates its own
     blue toward. See moodOf() below. */
  mood: string;
}
interface Props {
  tracks?: Track[];
}

/* Everything is `preload="none"` and nothing is fetched until someone presses
   play, so the length of this list costs the page nothing on load. Adding a
   track is one line plus a file in /public/audio. */
const DEFAULT_TRACKS: Track[] = [
  /* Four, and one register. The old list ran from Bon Iver to the GTA IV theme,
     which meant every track change threw the hero somewhere unrelated — five
     soundtracks to five different sites. These sit in one warm, cinematic
     place, so the colour moves through a family rather than across the wheel:
     twilight blue into amber into cool air into burnt orange, then round.

     Kevin MacLeod, CC BY 3.0, credited in the panel below — which is the whole
     licence, and the reason these are here rather than anything off a streaming
     service: they can actually be hosted. */
  { title: 'Atlantean Twilight', artist: 'Kevin MacLeod', src: '/audio/atlantean-twilight.mp3', mood: '#5b7fa6' },
  { title: 'Bathed in the Light', artist: 'Kevin MacLeod', src: '/audio/bathed-in-the-light.mp3', mood: '#e0a144' },
  { title: 'Air Prelude', artist: 'Kevin MacLeod', src: '/audio/air-prelude.mp3', mood: '#9aa8b8' },
  { title: 'Autumn Day', artist: 'Kevin MacLeod', src: '/audio/autumn-day.mp3', mood: '#c4703f' },
];

const { tracks = DEFAULT_TRACKS } = Astro.props;

/* ---- mood → a finished hex palette for the hero ----
 *
 * The hero is one blue palette (see .hero__bg in global.css); a mood is that
 * palette turned around the OKLCH hue circle. A track's colour is therefore
 * never painted directly, only measured: we take its hue and chroma, compare
 * them against the hero's own #0059ff, and rotate every hero colour by the
 * difference. Lightness is passed through untouched — that is what keeps a
 * red hero exactly as readable as the blue one, and keeps the white panel's
 * contrast where it was designed.
 *
 * All of it runs at build time. The browser receives finished hex strings and
 * does no colour maths, which is the point: the swap has to be one repaint.
 */

/* prop, colour, alpha. Split out so the maths only ever handles a hex and the
   orbs can keep their weights without an rgba() parser. */
const HERO_PALETTE: [string, string, number][] = [
  ['--m-hi', '#74a5ff', 1],
  ['--m-mid', '#0059ff', 1],
  ['--m-deep', '#003dae', 1],
  ['--m-dark', '#001845', 1],
  ['--m-glow', '#392ffa', 1],
  ['--m-g1', '#01113a', 1],
  ['--m-g2', '#012a86', 1],
  ['--m-g3', '#0146c9', 1],
  ['--m-orb-a', '#7aaaff', 0.8],
  ['--m-orb-b', '#1c56eb', 0.75],
  ['--m-orb-c', '#3c78ff', 0.55],
];

const toLinear = (v: number) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
const toGamma = (v: number) => (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);

// sRGB → linear → LMS → OKLab → polar. Ottosson's matrices throughout.
function hexToOklch(hex: string) {
  const n = parseInt(hex.slice(1), 16);
  const r = toLinear(((n >> 16) & 255) / 255);
  const g = toLinear(((n >> 8) & 255) / 255);
  const b = toLinear((n & 255) / 255);
  const l_ = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
  const m_ = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
  const s_ = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
  const L = 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_;
  const A = 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_;
  const B = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_;
  return { l: L, c: Math.hypot(A, B), h: ((Math.atan2(B, A) * 180) / Math.PI + 360) % 360 };
}

function oklchToLinearRgb(l: number, c: number, h: number) {
  const a = c * Math.cos((h * Math.PI) / 180);
  const b = c * Math.sin((h * Math.PI) / 180);
  const L = (l + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const M = (l - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const S = (l - 0.0894841775 * a - 1.2914855480 * b) ** 3;
  return [
    4.0767416621 * L - 3.3077115913 * M + 0.2309699292 * S,
    -1.2684380046 * L + 2.6097574011 * M - 0.3413193965 * S,
    -0.0041960863 * L - 0.7034186147 * M + 1.7076147010 * S,
  ];
}

const inGamut = (rgb: number[]) => rgb.every((v) => v >= -1e-4 && v <= 1 + 1e-4);

/* #0059ff is a near-gamut-edge blue, so rotating its chroma to an orange or a
   red at the same lightness lands outside sRGB. Clipping each channel there
   would drag the hue off target — so bisect chroma down instead, holding
   lightness and hue, which is what CSS Color 4 gamut mapping does. */
function oklchToCss(l: number, c: number, h: number, alpha: number) {
  if (!inGamut(oklchToLinearRgb(l, c, h))) {
    let lo = 0;
    let hi = c;
    for (let i = 0; i < 20; i++) {
      const mid = (lo + hi) / 2;
      if (inGamut(oklchToLinearRgb(l, mid, h))) lo = mid;
      else hi = mid;
    }
    c = lo;
  }
  const [r, g, b] = oklchToLinearRgb(l, c, h).map((v) =>
    Math.round(toGamma(Math.min(1, Math.max(0, v))) * 255)
  );
  return alpha === 1
    ? '#' + [r, g, b].map((v) => v.toString(16).padStart(2, '0')).join('')
    : `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

const BASE = hexToOklch('#0059ff'); // the hero's own blue, the zero point

function paletteFor(accent: string) {
  const t = hexToOklch(accent);
  // Wrapped into −180…180 so the rotation takes the short way round the wheel.
  const shift = ((((t.h - BASE.h) % 360) + 540) % 360) - 180;
  /* Clamped: a near-grey accent shouldn't wash the hero out completely, and
     nothing should push past the chroma the blue already carries. */
  const sat = Math.min(1.5, Math.max(0.35, t.c / BASE.c));

  const out: Record<string, string> = {};
  for (const [prop, hex, alpha] of HERO_PALETTE) {
    const o = hexToOklch(hex);
    out[prop] = oklchToCss(o.l, o.c * sat, o.h + shift, alpha);
  }
  return out;
}

const palettes = tracks.map((t) => paletteFor(t.mood));

const nudges = [
  'Tired of shortlisting? Let me add relaxing vibes',
  'Long day of screening profiles? Put something on.',
  'Scrolling deserves a soundtrack. Want one?',
];
---

<div class="music" data-state="idle" data-open="false" data-music>
  {/* The island. The pill grows rightward from behind the blob, so the blob
      itself never moves — it stays docked to the nav pill's edge. */}
  <div class="music__body" data-body aria-hidden="true">
    <span class="music__now">
      <span class="music__nowTitle" data-title>{tracks[0].title}</span>
    </span>
    <span class="music__transport">
      <button type="button" data-prev aria-label="Previous track">
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M12 3.5v9L5.5 8zM4 3.5v9" fill="currentColor" stroke="currentColor"
            stroke-width="1.4" stroke-linejoin="round" /></svg
        >
      </button>
      <button type="button" data-next aria-label="Next track">
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path d="M4 3.5v9L10.5 8zM12 3.5v9" fill="currentColor" stroke="currentColor"
            stroke-width="1.4" stroke-linejoin="round" /></svg
        >
      </button>
      <button type="button" data-list-toggle aria-expanded="false" aria-label="Choose a track">
        <svg class="music__caret" viewBox="0 0 16 16" aria-hidden="true"
          ><path d="m4 6.5 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.7"
            stroke-linecap="round" stroke-linejoin="round" /></svg
        >
      </button>
    </span>
  </div>

  <button
    type="button"
    class="music__blob"
    data-blob
    aria-pressed="false"
    aria-label="Play ambient music"
  >
    <span class="music__sheen" aria-hidden="true"></span>
    <span class="music__wave" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i>
    </span>
  </button>

  {/* The full list, on click. Same material as the hint bubble below it. */}
  <div class="music__list" data-list hidden>
    <p class="music__listHead">Soundtrack</p>
    <ul>
      {tracks.map((t, i) => (
        <li>
          <button type="button" data-track={i} data-src={t.src}>
            <span class="music__eq" aria-hidden="true"><i /><i /><i /></span>
            <span class="music__trackTxt">
              <b>{t.title}</b>
              <span>{t.artist}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    {/* The licence, in the only place it belongs: next to the thing it covers.
        CC BY asks for the name and the terms, and a line this size is the
        honest way to give both without turning the panel into paperwork. */}
    <p class="music__credit">
      Music by Kevin MacLeod ·
      <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a>
    </p>
  </div>

  {/* One finished palette per track, in the playlist's order. Eleven hex
      values each — small enough to inline, and it keeps the colour maths on
      the server where it belongs. */}
  <script
    type="application/json"
    data-tint-palettes
    set:html={JSON.stringify(palettes)}
  />

  <!-- one-time hint, hanging below the blob -->
  <div class="music__nudge" data-nudge hidden>
    <p data-nudge-copy>{nudges[0]}</p>
    <button type="button" class="music__nudgeNo" data-dismiss aria-label="No thanks">
      <svg viewBox="0 0 16 16" aria-hidden="true"
        ><path
          d="M4.6 4.6 11.4 11.4M11.4 4.6 4.6 11.4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        /></svg
      >
    </button>
    <script
      type="application/json"
      data-nudge-options
      set:html={JSON.stringify(nudges)}
    />
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-music]');

  if (root) {
    const blob = root.querySelector<HTMLButtonElement>('[data-blob]')!;
    const nudge = root.querySelector<HTMLElement>('[data-nudge]')!;
    const nudgeCopy = root.querySelector<HTMLElement>('[data-nudge-copy]')!;

    const audio = new Audio();
    audio.preload = 'none';
    audio.volume = 0.45;

    const setState = (s: 'idle' | 'playing' | 'paused') => {
      root.dataset.state = s;
      const playing = s === 'playing';
      blob.setAttribute('aria-pressed', String(playing));
      blob.setAttribute('aria-label', playing ? 'Pause ambient music' : 'Play ambient music');
    };

    /* ---- hint: once per session, and only after they've engaged a little ---- */
    const NUDGE_KEY = 'music-nudge-seen';
    const showNudge = (copy?: string) => {
      if (copy) nudgeCopy.textContent = copy;
      else {
        if (sessionStorage.getItem(NUDGE_KEY)) return;
        const raw = root.querySelector('[data-nudge-options]')?.textContent;
        if (raw) {
          const opts: string[] = JSON.parse(raw);
          nudgeCopy.textContent = opts[Math.floor(Math.random() * opts.length)];
        }
      }
      nudge.hidden = false;
    };
    const hideNudge = (remember = true) => {
      nudge.hidden = true;
      if (remember) sessionStorage.setItem(NUDGE_KEY, '1');
    };

    // Trigger once they're actually reading — a scroll past one viewport.
    let nudged = false;
    let nudgeTimer = 0;

    const trigger = () => {
      if (nudged) return;
      nudged = true;
      window.removeEventListener('scroll', maybeNudge);
      clearTimeout(nudgeTimer);
      if (root.dataset.state !== 'idle') return;
      showNudge();
      setTimeout(() => { if (!nudge.hidden) hideNudge(); }, 9000);
    };

    function maybeNudge() {
      if (window.scrollY >= window.innerHeight * 0.75) trigger();
    }

    window.addEventListener('scroll', maybeNudge, { passive: true });
    // Evaluate once on load: a restored scroll position fires no scroll event.
    maybeNudge();
    // And catch anyone who lingers at the top without scrolling.
    nudgeTimer = window.setTimeout(trigger, 15000);

    root.querySelector('[data-dismiss]')!.addEventListener('click', () => hideNudge());

    /* ---- the playlist ---- */
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-track]'));
    const srcs = items.map((b) => b.dataset.src!);
    const titles = items.map((b) => b.querySelector('b')!.textContent!);
    const titleEl = root.querySelector<HTMLElement>('[data-title]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const listToggle = root.querySelector<HTMLButtonElement>('[data-list-toggle]')!;
    const body = root.querySelector<HTMLElement>('[data-body]')!;
    let index = 0;

    const paint = () => {
      titleEl.textContent = titles[index];
      items.forEach((b, i) => b.setAttribute('aria-current', String(i === index)));
    };
    paint();

    /* ---- expand / collapse ----
       Hover drives it on a mouse. Touch has no hover, so there the first tap
       opens the island instead of starting playback — otherwise the controls
       would be unreachable on a phone. */
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const setOpen = (open: boolean) => {
      root.dataset.open = String(open);
      body.setAttribute('aria-hidden', String(!open));
      if (!open) closeList();
    };

    if (fine.matches) {
      root.addEventListener('pointerenter', () => setOpen(true));
      root.addEventListener('pointerleave', () => {
        if (list.hidden) setOpen(false);
      });
      root.addEventListener('focusin', () => setOpen(true));
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget as Node) && list.hidden) setOpen(false);
      });
    }

    /* ---- the list ---- */
    function openList() {
      list.hidden = false;
      listToggle.setAttribute('aria-expanded', 'true');
    }
    function closeList() {
      list.hidden = true;
      listToggle.setAttribute('aria-expanded', 'false');
    }
    listToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      list.hidden ? openList() : closeList();
    });
    document.addEventListener('click', (e) => {
      if (root.contains(e.target as Node)) return;
      closeList();
      if (fine.matches) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeList();
      setOpen(false);
    });

    /* ---- the hero takes the track's colour ----
       One element opts in, via data-hero-tint, and it is only ever the
       homepage hero — the case study pages paint their own per-project
       accented field and are deliberately left alone. On those pages (and
       anywhere else the nav appears) this is null and the player just plays.

       Set in one go, with no transition. Animating these would mean
       re-rasterising five gradients, a 160px blur and a color-burn layer per
       frame; see the note in global.css. */
    const tintRoot = document.querySelector<HTMLElement>('[data-hero-tint]');
    const baseTint = tintRoot?.querySelector<HTMLElement>('[data-tint="base"]');
    const nextTint = tintRoot?.querySelector<HTMLElement>('[data-tint="next"]');
    const palettes: Record<string, string>[] = JSON.parse(
      root.querySelector('[data-tint-palettes]')?.textContent || '[]'
    );
    const FADE_MS = 850; // must match .hero__tint--next's transition

    /* Writes a palette onto one stack. `null` means blue: the inline values
       are removed rather than overwritten, so the stylesheet stays the single
       source of what the resting page is. */
    type Palette = Record<string, string> | null;
    const paintTint = (el: HTMLElement, palette: Palette) => {
      for (const prop in palettes[0]) {
        if (palette) el.style.setProperty(prop, palette[prop]);
        else el.style.removeProperty(prop);
      }
    };

    /* What the hero is, or is on its way to being. Compared by reference, so
       asking for the palette already showing is free — which matters because
       `play` fires on both a resume and a track change, and only one of those
       should start a fade. */
    let shown: Palette = null;
    let fading = false;
    let fadeTimer = 0;

    /* Ends the fade: the incoming palette becomes the resting one and the
       overlay drops back to invisible without animating, ready for the next
       change. Safe to call early — an interrupted fade just lands now. */
    const settleTint = () => {
      if (!fading || !baseTint || !nextTint) return;
      fading = false;
      clearTimeout(fadeTimer);
      paintTint(baseTint, shown);
      nextTint.style.transition = 'none';
      nextTint.style.opacity = '0';
      void nextTint.offsetHeight; // flush, so the reset itself isn't animated
      nextTint.style.transition = '';
    };

    const fadeTint = (palette: Palette) => {
      if (!baseTint || !nextTint || palette === shown) return;
      settleTint(); // any fade still in flight lands before this one starts
      shown = palette;
      paintTint(nextTint, palette);
      void nextTint.offsetHeight; // give the transition a start value to leave
      nextTint.style.opacity = '1';
      fading = true;
      fadeTimer = window.setTimeout(settleTint, FADE_MS + 60);
    };

    /* ---- transport ---- */
    /* `pause` also fires as a track runs out, an instant before `ended` hands
       over to the next one. Clearing on the spot would flash the page blue
       between two tracks, so the reset waits a beat and any new mood cancels
       it. A real pause is still under a frame late. */
    let resetTimer = 0;
    const cancelReset = () => clearTimeout(resetTimer);

    /* True from asking for a new track until that track is actually playing.
     *
     * Assigning `audio.src` tears down whatever is playing, and the element
     * reports that by firing `pause` — the same event, with the same shape, as
     * a person pressing the button. The handler below can't tell them apart, so
     * it schedules the hero back to blue and flips the button to paused.
     *
     * On a fast load the `play` that follows cancels both in time and nothing
     * shows. On a slow one the 80ms timer wins and the page flashes blue
     * mid-change. A deliberate switch is not a pause, so it says so here and
     * the handler steps aside. */
    let switching = false;

    audio.addEventListener('play', () => {
      switching = false;
      cancelReset();
      /* Resuming has to re-tint: pausing sent the hero back to blue, and a
         resume goes through here rather than through load(), which is the
         only other place a palette gets set. A no-op when the colour is
         already up, so a track change doesn't fade twice. */
      fadeTint(palettes[index] ?? null);
      setState('playing');
    });
    audio.addEventListener('pause', () => {
      /* Not a pause — the old track being cleared so the next one can load.
         Leaving the colour and the button alone is what makes a track change
         read as one continuous thing rather than as a stop and a start. */
      if (switching) return;
      setState('paused');
      // Stopped is stopped: the page goes back to being blue.
      cancelReset();
      resetTimer = window.setTimeout(() => fadeTint(null), 80);
    });

    const fail = () => {
      switching = false;
      setState('idle');
      // Nothing is playing, so nothing is colouring the page.
      cancelReset();
      fadeTint(null);
      // Say so rather than leaving a button that looks broken.
      showNudge('That track would not load. Sorry!');
      setTimeout(() => hideNudge(), 5000);
    };
    audio.addEventListener('error', fail);

    /* `wanted` guards against a race: switching tracks quickly fires an error
       for the abandoned load, which would otherwise blame the new one. */
    let wanted = '';
    const load = (i: number, play: boolean) => {
      index = (i + srcs.length) % srcs.length;
      paint();
      // Cancels a pending reset, so switching tracks never blinks blue.
      cancelReset();
      fadeTint(palettes[index] ?? null);
      wanted = srcs[index];
      /* Raised before the assignment, because that is what fires the `pause`
         this is here to disown. Lowered by `play`, or by `fail` if the new
         track never arrives — so a switch that dies still lets the page go
         back to blue rather than freezing on a colour with nothing playing. */
      switching = play;
      audio.src = wanted;
      if (play) audio.play().catch(() => { if (audio.src === wanted) fail(); });
    };

    const toggle = () => {
      hideNudge();
      if (audio.paused) {
        // Deferred until the first press, so nothing downloads unasked.
        if (!audio.src) load(index, true);
        else audio.play().catch(fail);
      } else {
        audio.pause();
      }
    };

    blob.addEventListener('click', () => {
      // On touch the first tap only opens the island; the second one plays.
      if (!fine.matches && root.dataset.open !== 'true') {
        setOpen(true);
        return;
      }
      toggle();
    });

    /* ---- yielding to Scout's voice mode ----
       Two things talking at once is just noise, so the music steps aside while
       the assistant is speaking and comes back afterwards.

       `ducked` is the whole point: it resumes only what this handler paused.
       Someone who had already stopped the music before opening voice mode does
       not want it starting up on its own when they close it — and without the
       flag, that is exactly what would happen. */
    let ducked = false;
    document.addEventListener('scout:voice', (e) => {
      const on = (e as CustomEvent<{ on: boolean }>).detail?.on;
      if (on) {
        if (audio.paused) return;
        ducked = true;
        audio.pause();
      } else if (ducked) {
        ducked = false;
        audio.play().catch(() => { /* the tab may have lost permission */ });
      }
    });

    root.querySelector('[data-prev]')!.addEventListener('click', () => load(index - 1, true));
    root.querySelector('[data-next]')!.addEventListener('click', () => load(index + 1, true));
    // A track that ends walks on to the next one rather than stopping dead.
    audio.addEventListener('ended', () => load(index + 1, true));

    items.forEach((b, i) =>
      b.addEventListener('click', () => {
        hideNudge();
        load(i, true);
        closeList();
      })
    );
  }
</script>

<style>
  .music {
    /* 0.60 × the nav pill's height (74px desktop, 59px below 820px) */
    --blob-size: 44.4px;
    --bar-h: 16px;
    --bar-w: 2px;
    --bar-gap: 2.5px;

    position: relative; /* anchor for the hint bubble */
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    font-family: "Nunito", system-ui, sans-serif;
  }

  /* The UA rule [hidden]{display:none} loses to any author `display` rule,
     so restate it with enough specificity to beat the class selectors below. */
  .music [hidden] { display: none; }

  /* ---------------- the blob ---------------- */
  .music__blob {
    position: relative;
    /* Above the island pill, which grows out from behind it. */
    z-index: 2;
    width: var(--blob-size);
    height: var(--blob-size);
    padding: 0;
    border: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
    overflow: hidden;

