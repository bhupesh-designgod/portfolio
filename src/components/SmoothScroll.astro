---
/* Lenis smooth scroll. Lenis drives the real window scroll position, so
   window.scrollY and native scroll events still work — the hero's panel
   handler keeps running unchanged. */
import 'lenis/dist/lenis.css';
---

<script>
  import Lenis from 'lenis';

  /* Flip to true to put Lenis back. Off while Bhupesh compares the feel of the
     site on native scroll — everything else copes: hash links fall back to the
     `scroll-behavior: smooth` already on <html>, and the walkthrough player
     checks for `window.__lenis` and uses `window.scrollTo` when it is absent. */
  const SMOOTH = false;

  if (SMOOTH && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({
      /* Fraction of the remaining distance covered per frame. At 0.09 the first
         few frames barely moved, which read as the page resisting the wheel
         before it gave. 0.15 still glides but answers the first tick. */
      lerp: 0.15,
      wheelMultiplier: 1.1,
      anchors: true,     // hash links (e.g. /#work) ease instead of jumping
    });

    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    /* Published so anything that needs to move the page programmatically goes
       through Lenis rather than around it. `window.scrollTo` fights Lenis' own
       rAF — both write scrollTop on the same frame and the page judders. The
       walkthrough player is the only caller today; it falls back to
       `window.scrollTo` when this is absent, which is the reduced-motion case
       where Lenis is never constructed. */
    (window as any).__lenis = lenis;
  }
</script>
