---
/* A card cut from metal that reflects whoever is looking at it.
 *
 * The technique is react-bits' ReflectiveCard, read from source. Its metal is
 * a live camera frame pushed through an SVG filter chain:
 *
 *   feTurbulence      -> a noise field
 *   feDisplacementMap -> ripple the blurred frame through it
 *   feSpecularLighting + fePointLight -> a highlight over that noise
 *   feComposite + feBlend (screen) -> the highlight back onto the ripple
 *
 * Two departures from the reference, both about when rather than whether.
 *
 * It calls getUserMedia on mount. This one never does — the camera is requested
 * from a click, by src/lib/reflective.ts, which also shares a single stream
 * across every surface on the page.
 *
 * And its card is nothing until the camera answers. This one is a finished
 * object before the reflection arrives and stays one if the answer is no: a
 * brushed-steel surface built from a clean gradient plus a directional grain
 * pass. The camera lands on top of that, blended screen, the way a reflection
 * actually behaves — it adds light to a surface rather than replacing it.
 *
 * The card is not a link and not a button. It is a surface; whatever wraps it
 * decides what clicking it does.
 */
interface Props {
  index?: string;
  title?: string;
  meta?: string;
  /** Each card instantiates its own filters; ids have to be unique. */
  id?: string;
  /** Overridable so the same component can be a tile or a full-size panel. */
  aspect?: string;
  class?: string;
}

const {
  index = '01',
  title = 'Untitled',
  meta = '',
  id = `rc-${Math.random().toString(36).slice(2, 8)}`,
  aspect = '0.78 / 1',
  class: className = '',
} = Astro.props;
---

<div class:list={['rc', className]} data-rc data-mirror="1" style={`--rc-aspect:${aspect}`}>
  {/* Zero-sized: this exists only to define the two filters. */}
  <svg class="rc__defs" aria-hidden="true" focusable="false">
    <defs>
      {/* The brushing, on the resting surface. Anisotropic on purpose — an even
          baseFrequency gives round lumps and the surface reads as rock, so the
          noise is stretched, slow across x and fast down y, which draws streaks
          along the brushing direction. Then pulled into a narrow band either
          side of mid grey, because straight out of feTurbulence it spans the
          full range and reads as static. */}
      <filter
        id={`${id}-brush`}
        x="-10%"
        y="-10%"
        width="120%"
        height="120%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.008 1.7"
          numOctaves="2"
          seed="7"
          result="noise"
        />
        <feColorMatrix
          in="noise"
          type="matrix"
          values="0 0 0 0 0.5
                  0 0 0 0 0.5
                  0 0 0 0 0.5
                  0.5 0.35 0.15 0 0"
          result="grey"
        />
        <feComponentTransfer in="grey">
          <feFuncA type="linear" slope="0.55" intercept="0.22" />
        </feComponentTransfer>
      </filter>

      {/* Refraction, on the body of the pane.
          
          The frost this replaces came from feSpecularLighting over two octaves
          of turbulence: that pair is a bump map, and a bump map is exactly what
          etched glass is. So both are gone. What is left is one octave of noise
          at a very low frequency — a field that varies over most of the card
          rather than every few pixels — which bends the image in slow curves
          instead of pebbling it. That is the difference between looking through
          a bathroom window and looking through a thick lens. */}
      <filter id={`${id}-liquid`} x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.0026 0.0042"
          numOctaves="1"
          seed="9"
          result="warp"
        />
        <feDisplacementMap
          data-rc-disp
          in="SourceGraphic"
          in2="warp"
          scale="48"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>

      {/* Refraction at the rim, where a real pane bends light hardest. Same
          field, tighter and stronger, on a copy of the frame that is scaled up
          and masked to a ring — which is what gives the card thickness rather
          than reading as a warped photograph. */}
      <filter id={`${id}-rim`} x="-25%" y="-25%" width="150%" height="150%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.0045 0.0065"
          numOctaves="1"
          seed="3"
          result="warp"
        />
        <feDisplacementMap
          in="SourceGraphic"
          in2="warp"
          scale="96"
          xChannelSelector="R"
          yChannelSelector="G"
        />
      </filter>

    </defs>
  </svg>

  {/* Resting surface: a clean gradient with the grain over it, never displaced.
      Displacing a gradient shifts every row by a different amount and the bands
      come apart into scan lines. */}
  <span class="rc__metal" aria-hidden="true"></span>
  <span class="rc__brush" style={`filter:url(#${id}-brush)`} aria-hidden="true"></span>
  <span class="rc__grain" aria-hidden="true"></span>

  {/* The pane. Explicitly sized rather than left to four insets: a video is a
      replaced element, and width:auto takes its intrinsic width instead of
      filling the box. */}
  <video
    class="rc__glass"
    data-rc-cam
    style={`filter:saturate(1.3) brightness(1.03) blur(var(--rc-soft, 8px)) url(#${id}-liquid)`}
    muted
    playsinline
    autoplay
    aria-hidden="true"></video>

  {/* The edge lens: the same stream again, scaled up, bent harder, and masked
      to a ring that follows the corner radius. */}
  <span class="rc__rim" aria-hidden="true">
    <video
      class="rc__rimcam"
      data-rc-cam
      style={`filter:saturate(1.45) brightness(1.06) blur(2px) url(#${id}-rim)`}
      muted
      playsinline
      autoplay></video>
  </span>

  {/* Glass splits colour where it bends hardest. A spectral ring at low opacity
      is a cheaper read on that than displacing three channels separately, and
      it costs nothing per frame. */}
  <span class="rc__fringe" aria-hidden="true"></span>
  <span class="rc__inner" aria-hidden="true"></span>

  <span class="rc__spec" aria-hidden="true"></span>

  <span class="rc__body">
    <span class="rc__top">
      <span class="rc__idx">{index}</span>
      {meta && <span class="rc__meta">{meta}</span>}
    </span>

    <span class="rc__slot"><slot /></span>

    <span class="rc__foot">
      <span class="rc__title">{title}</span>
    </span>
  </span>

  <span class="rc__edge" aria-hidden="true"></span>
</div>

<script>
  import { join, leave, onState } from '../lib/reflective';

  for (const el of document.querySelectorAll<HTMLElement>('[data-rc]')) {
    /* The moving part: a specular highlight sitting where the pointer is. Two
       custom properties, so the work per move is setting a string. */
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    });
    el.addEventListener('pointerleave', () => {
      /* Back to rest: up and to the left, where a light in a room usually is. */
      el.style.setProperty('--mx', '28%');
      el.style.setProperty('--my', '18%');
    });
  }

  /* Every card reflects whatever stream is running, so a card in a modal and a
     button on the page behind it light up together rather than negotiating
     separately. Joining does not keep the camera on — only whatever asked for
     it does that. */
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        /* Two surfaces per card now — the pane and the edge lens — both fed
           from the one stream. */
        for (const cam of e.target.querySelectorAll<HTMLVideoElement>('[data-rc-cam]')) {
          if (e.isIntersecting) join(cam);
          else leave(cam);
        }
      }
    },
    { rootMargin: '120px' },
  );
  for (const el of document.querySelectorAll<HTMLElement>('[data-rc]')) io.observe(el);

  onState((s) => {
    for (const el of document.querySelectorAll<HTMLElement>('[data-rc]')) {
      el.dataset.state = s;
    }
  });
</script>

<style>
  .rc {
    --mx: 28%;
    --my: 18%;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--rc-aspect, 0.78 / 1);
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    background: #0d1016;
    box-shadow:
      0 24px 60px rgba(8, 12, 24, 0.45),
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 12px 26px -18px rgba(255, 255, 255, 0.5) inset,
      0 -10px 22px -18px rgba(255, 255, 255, 0.28) inset,
      0 0 0 1px rgba(10, 14, 22, 0.35) inset;
  }
  .rc__defs {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .rc__metal {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      112deg,
      #232a37 0%,
      #626e88 18%,
      #1d242f 34%,
      #4e5a70 52%,
      #1a202a 68%,
      #6b7791 84%,
      #242b39 100%
    );
  }

  /* Soft-light, so the grain lightens the gradient's dark bands and darkens its
     light ones — which is what a directional brushing does to a curved surface.
     Overlay at this strength just bleaches the top half. */
  .rc__brush {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.62;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background: #808080;
  }

  .rc__grain {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.12;
    mix-blend-mode: overlay;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* The pane. Normal blend, not screen: glass transmits what is in front of it
     rather than adding light to what is behind, and screening a bright room
     over the metal was most of why the old surface looked like a smear. */
  .rc__glass {
    position: absolute;
    left: -8%;
    top: -8%;
    width: 116%;
    height: 116%;
    z-index: 2;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
  }
  /* A mirror, not a camera: unflipped, moving your hand left moves it right. */
  .rc[data-mirror='1'] .rc__glass,
  .rc[data-mirror='1'] .rc__rimcam {
    transform: scaleX(-1);
  }
  .rc[data-state='live'] .rc__glass {
    opacity: var(--rc-cam-opacity, 0.92);
  }

  /* A ring that follows the corner radius, drawn the same way as the hairline:
     two masks, the inner one subtracted. */
  .rc__rim {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
    /* Two soft bands unioned, not a subtracted content box. Subtracting gives
       a hard 20px inset rectangle, and a visible seam is the one thing a pane
       of glass does not have — the bend has to fade toward the middle. */
    -webkit-mask:
      linear-gradient(to right, #000 0, transparent 26%, transparent 74%, #000 100%),
      linear-gradient(to bottom, #000 0, transparent 26%, transparent 74%, #000 100%);
    -webkit-mask-composite: source-over;
    mask:
      linear-gradient(to right, #000 0, transparent 26%, transparent 74%, #000 100%),
      linear-gradient(to bottom, #000 0, transparent 26%, transparent 74%, #000 100%);
    mask-composite: add;
  }
  .rc[data-state='live'] .rc__rim {
    opacity: 0.9;
  }
  /* Scaled past the frame, because a lens shows you a magnified slice of what
     is behind its edge, not the same slice shifted. */
  .rc__rimcam {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
  }
  .rc[data-mirror='1'] .rc__rimcam {
    transform: scaleX(-1) scale(1.18);
  }

  .rc__fringe {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    opacity: 0.16;
    mix-blend-mode: screen;
    pointer-events: none;
    filter: blur(7px);
    background: conic-gradient(
      from 210deg,
      rgba(255, 90, 130, 0.85),
      rgba(90, 200, 255, 0.85) 24%,
      rgba(150, 255, 210, 0.7) 48%,
      rgba(255, 200, 100, 0.85) 72%,
      rgba(255, 90, 130, 0.85)
    );
    transition: opacity 0.7s ease;
    -webkit-mask:
      linear-gradient(to right, #000 0, transparent 30%, transparent 70%, #000 100%),
      linear-gradient(to bottom, #000 0, transparent 30%, transparent 70%, #000 100%);
    -webkit-mask-composite: source-over;
    mask:
      linear-gradient(to right, #000 0, transparent 30%, transparent 70%, #000 100%),
      linear-gradient(to bottom, #000 0, transparent 30%, transparent 70%, #000 100%);
    mask-composite: add;
  }
  .rc[data-state='live'] .rc__fringe {
    opacity: 0.5;
  }

  .rc__inner {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    padding: 1.5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98) 0%,
      rgba(255, 255, 255, 0.22) 28%,
      rgba(150, 175, 210, 0.12) 52%,
      rgba(255, 255, 255, 0.34) 74%,
      rgba(255, 255, 255, 0.9) 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }
  .rc[data-state='live'] .rc__inner {
    opacity: 0.85;
  }

  /* The gloss on top of the pane: a highlight where the pointer is, and a fixed
     diagonal sheen that makes the surface read as curved rather than flat. */
  .rc__spec {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(
        40% 32% at var(--mx) var(--my),
        rgba(255, 255, 255, 0.5),
        rgba(255, 255, 255, 0.1) 45%,
        transparent 70%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.52) 0%,
        rgba(255, 255, 255, 0.16) 12%,
        rgba(255, 255, 255, 0) 34%
      ),
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.26) 0%,
        rgba(255, 255, 255, 0.04) 34%,
        rgba(255, 255, 255, 0) 52%,
        rgba(255, 255, 255, 0.04) 68%,
        rgba(255, 255, 255, 0.24) 100%
      );
    transition: background 0.08s linear;
  }

  /* The brushing is the resting surface. Once there is glass over it, the
     streaks read through the pane as dirt on the metal. */
  .rc[data-state='live'] .rc__brush {
    opacity: 0.24;
  }
  .rc[data-state='live'] .rc__grain {
    opacity: 0.06;
  }

  /* Type on metal is unreadable without a ground under it, and more so once a
     lit room is on the surface. Top and bottom only, so the middle stays clear
     for whatever goes in the slot. */
  .rc__body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 10, 16, 0.72) 0%, rgba(7, 10, 16, 0) 24%),
      linear-gradient(0deg, rgba(7, 10, 16, 0.86) 0%, rgba(7, 10, 16, 0) 32%),
      radial-gradient(70% 40% at 50% 50%, rgba(7, 10, 16, 0.46), transparent 70%);
  }
  .rc__body {
    position: relative;
    z-index: 6;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px;
    color: #eef2f8;
  }

  .rc__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .rc__idx,
  .rc__meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10.5px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }
  .rc__idx {
    color: rgba(238, 242, 248, 0.95);
  }
  .rc__meta {
    color: rgba(238, 242, 248, 0.72);
  }

  .rc__slot {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 14px 0;
  }

  .rc__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .rc__title {
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 26px;
    line-height: 1;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  /* A hairline, drawn as a masked gradient so it can be brighter at the top
     left than the bottom right — which is what a lit edge does. */
  .rc__edge {
    position: absolute;
    inset: 0;
    z-index: 7;
    border-radius: inherit;
    padding: 1px;
    pointer-events: none;
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.75),
      rgba(255, 255, 255, 0.14) 46%,
      rgba(255, 255, 255, 0.5)
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  @media (prefers-reduced-motion: reduce) {
    .rc__spec,
    .rc__glass,
    .rc__rim,
    .rc__fringe,
    .rc__inner {
      transition: none;
    }
  }
</style>
