---
/* The closing note.
 *
 * Everything here answers one question: how does someone who just finished
 * reading a case study reach you without thinking about it? So the email is
 * the largest thing on the page, it can be copied in one click for anyone who
 * lives in a webmail tab, and the four places you actually post are targets
 * you could hit with your elbow.
 *
 * What is deliberately absent: a newsletter box for a newsletter that does not
 * exist, columns of links to pages that were never written, and a weather
 * widget. A footer full of dead ends reads as a template.
 */
interface Props {
  email?: string;
  linkedin?: string;
  instagram?: string;
  x?: string;
  /** Shown top-right. Leave empty to drop the line entirely. */
  status?: string;
  resume?: string;
}

const {
  email = 'designs.bhupesh@gmail.com',
  linkedin = 'https://www.linkedin.com/in/bhupeshparmar/',
  instagram = 'https://www.instagram.com/designs.bhupesh/',
  x = 'https://x.com/designsbhupesh',
  status = 'Open to product design roles',
  resume = '/Bhupesh-Parmar-Resume.pdf',
} = Astro.props;

/* The build date, which is the last time anything here could have changed.
   Written at build rather than in the browser so it is the same for everyone
   and costs no request. */
const updated = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/* Mirrors Nav.astro. Kept short on purpose — this is a way back up, not a
   sitemap. */
const links = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/playground', label: 'Playground' },
  { href: '/about', label: 'About' },
];

const socials = [
  { key: 'mail', href: `mailto:${email}`, label: 'Email' },
  { key: 'in', href: linkedin, label: 'LinkedIn' },
  { key: 'ig', href: instagram, label: 'Instagram' },
  { key: 'x', href: x, label: 'X' },
];
---

<footer class="ft">
  <div class="ft__field" aria-hidden="true"></div>

  <div class="ft__inner">
    <div class="ft__meta">
      <p><span>Last updated</span>{updated}</p>
      {status && <p class="ft__status"><span>Currently</span>{status}</p>}
    </div>

    {/* The note. Ruled like a pad, because a handwritten aside is the one
        thing in a portfolio that cannot be mistaken for boilerplate. */}
    <div class="ft__note" data-note>
      {/* The site's own material, not a flat card: the same #liquidGlass
          displacement, specular rim and top gloss the nav pill and the music
          blob are made of. Those two are the most recognisable things on the
          page, so the closing note being cut from the same glass is what ties
          this footer to the rest of the site rather than to a reference. */}
      <span class="ft__gloss" aria-hidden="true"></span>
      <span class="ft__sheen" aria-hidden="true"></span>

      <p class="ft__noteHead">A note from Bhupesh</p>
      <p class="ft__line">Thanks for scrolling this far.</p>
      <p class="ft__line">If something here stuck with you, I&rsquo;d like to hear it.</p>
      <p class="ft__line ft__line--mail">
        <a href={`mailto:${email}`}>{email}</a>
        {/* Half of everyone reading this lives in a webmail tab, where a
            mailto: link opens the wrong client or nothing at all. */}
        <button type="button" class="ft__copy" data-copy={email} aria-label="Copy email address">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="2" fill="none"
              stroke="currentColor" stroke-width="1.5"></rect>
            <path d="M10.5 3.5h-6a2 2 0 0 0-2 2v6" fill="none"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </p>
      <p class="ft__sign">— Bhupesh</p>
    </div>

    <ul class="ft__tiles">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              class={`ft__tile ft__tile--${s.key}`}
              aria-label={s.label}
              {...(s.key === 'mail' ? {} : { target: '_blank', rel: 'me noopener' })}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {s.key === 'mail' && (
                  <>
                    <rect x="2.5" y="5" width="19" height="14" rx="2.6" fill="none"
                      stroke="currentColor" stroke-width="1.9" />
                    <path d="m3.5 7.5 8.5 6 8.5-6" fill="none" stroke="currentColor"
                      stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
                {s.key === 'in' && (
                  <>
                    <path d="M4.2 9.4h3v10.4h-3z" fill="currentColor" />
                    <circle cx="5.7" cy="5.6" r="1.85" fill="currentColor" />
                    <path
                      d="M10 9.4h2.9v1.5a3.3 3.3 0 0 1 2.9-1.6c2.6 0 4 1.7 4 4.6v5.9h-3v-5.3c0-1.5-.6-2.4-1.9-2.4s-2 .9-2 2.4v5.3h-2.9z"
                      fill="currentColor"
                    />
                  </>
                )}
                {s.key === 'ig' && (
                  <>
                    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2" fill="none"
                      stroke="currentColor" stroke-width="1.9" />
                    <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor"
                      stroke-width="1.9" />
                    <circle cx="17.1" cy="6.9" r="1.25" fill="currentColor" />
                  </>
                )}
                {s.key === 'x' && (
                  <path
                    d="M3.6 3.4h4.3l4.06 5.5 4.7-5.5h2.5l-6.06 7.1 6.5 8.7h-4.3l-4.3-5.8-5 5.8H3.4l6.4-7.5z"
                    fill="currentColor"
                  />
                )}
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ft__bar">
      <p class="ft__copyright">&copy; {new Date().getFullYear()} Bhupesh Parmar</p>
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={resume} target="_blank" rel="noopener">R&eacute;sum&eacute;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  /* Copy-to-clipboard, with the button reporting what happened. writeText can
     reject — an insecure origin, or a browser that will not grant the
     permission — so the failure path says so rather than lying with a tick. */
  /* Carries the rim highlight round to whichever edge the pointer is nearest.
     Only the bearing is tracked — the face of the glass is deliberately not
     lit from here. Coalesced into one frame, because pointermove fires far
     more often than the screen refreshes and each write repaints the ring. */
  const note = document.querySelector<HTMLElement>('[data-note]');
  if (note && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let px = 0;
    let py = 0;
    let queued = 0;

    note.addEventListener('pointermove', (e) => {
      const box = note.getBoundingClientRect();
      px = e.clientX - box.left - box.width / 2;
      py = e.clientY - box.top - box.height / 2;
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        /* Less 90° because a conic gradient starts at twelve o'clock while
           atan2 starts at three, so without it the lit arc sits a quarter turn
           away from the cursor. */
        const deg = (Math.atan2(py, px) * 180) / Math.PI - 90;
        note.style.setProperty('--ang', deg.toFixed(1));
      });
    });
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');

  if (btn && label) {
    let reset = 0;
    btn.addEventListener('click', async () => {
      const done = (text: string, ok: boolean) => {
        label.textContent = text;
        btn.dataset.state = ok ? 'done' : 'fail';
        clearTimeout(reset);
        reset = window.setTimeout(() => {
          label.textContent = 'Copy';
          delete btn.dataset.state;
        }, 1900);
      };
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        done('Copied', true);
      } catch {
        done('Press ⌘C', false);
      }
    });
  }
</script>

<style>
  /* The hero opens on this blue and the page ends on it, so the white between
     them reads as a sheet laid over one continuous field rather than as the
     background itself. */
  .ft {
    position: relative;
    z-index: 3;
    overflow: hidden;
    padding: clamp(56px, 8vw, 96px) 6% clamp(28px, 3vw, 40px);
    color: #fff;
    background: #04124a;
  }
  .ft__field {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 18% 0%, rgba(116, 165, 255, 0.5) 0%, transparent 60%),
      radial-gradient(64% 70% at 88% 22%, rgba(57, 47, 250, 0.55) 0%, transparent 62%),
      radial-gradient(90% 80% at 50% 108%, rgba(0, 89, 255, 0.55) 0%, transparent 66%),
      linear-gradient(168deg, #04124a 0%, #0a2a8e 52%, #0742c4 100%);
  }
  .ft__inner {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
  }

  /* ---- corner meta ---- */
  .ft__meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(34px, 5vw, 58px);
  }
  .ft__meta p {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
  }
  .ft__meta span {
    display: block;
    margin-bottom: 3px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .ft__status { text-align: right; }
  /* A live status earns a live dot; a static line would just be a claim. */
  .ft__status::after {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 7px;
    border-radius: 50%;
    background: #6ee7a8;
    box-shadow: 0 0 0 3px rgba(110, 231, 168, 0.22);
  }

  /* ---- the note ----
     Liquid glass over the blue field, matching .nav__pill and .music__blob.

     The edge tracks the pointer, the face does not. Those are different
     effects and only one of them worked: a bright arc travelling round the
     rim reads as the card catching light as it turns, while a highlight
     sliding across the face read as a spotlight being dragged over it. --ang
     is the pointer's bearing from the centre, written by the script. */
  .ft__note {
    --ang: 205;

    position: relative;
    isolation: isolate;
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(22px, 3.4vw, 34px) clamp(22px, 3.6vw, 38px) clamp(18px, 2.4vw, 26px);
    border-radius: 22px;
    /* Dark enough to hold the text, sheer enough to be glass. */
    background: rgba(7, 13, 42, 0.46);
    -webkit-backdrop-filter: blur(16px) saturate(165%);
    backdrop-filter: blur(16px) saturate(165%);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.22),
      inset 0 -1px 1px rgba(255, 255, 255, 0.08),
      inset 0 0 40px rgba(255, 255, 255, 0.05),
      0 30px 70px rgba(2, 10, 40, 0.45);
    /* Barely off-square, so it sits on the page like something placed rather
       than something laid out. */
    transform: rotate(-0.5deg);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  /* Chromium only: bends the backdrop through the turbulence map. Declared
     apart so browsers that reject url() keep the plain blur above. The filter
     itself is defined once, in Nav.astro. */
  @supports (backdrop-filter: url(#liquidGlass)) {
    .ft__note {
      -webkit-backdrop-filter: blur(16px) url(#liquidGlass) saturate(165%);
      backdrop-filter: blur(16px) url(#liquidGlass) saturate(165%);
    }
  }
  .ft__note:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.3),
      inset 0 -1px 1px rgba(255, 255, 255, 0.12),
      inset 0 0 46px rgba(255, 255, 255, 0.08),
      0 42px 90px rgba(2, 10, 40, 0.52);
  }

  .ft__note > span {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
  }
  /* Content clears the three light layers. */
  .ft__note > p { position: relative; z-index: 2; }

  /* Light entering the upper surface — fixed, the part that does not depend
     on where you are pointing. */
  .ft__gloss {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.03) 34%,
      rgba(255, 255, 255, 0) 58%
    );
  }

  /* The edge. A conic sweep masked to a hairline ring, so the bright arc rides
     the border rather than filling the card — the same construction as
     .nav__sheen. Rotating `from` by the pointer's bearing is what carries the
     highlight round the border as you cross the card. */
  .ft__sheen {
    padding: 1.25px;
    background: conic-gradient(
      from calc(var(--ang) * 1deg) at 50% 50%,
      rgba(255, 255, 255, 0) 0deg,
      rgba(255, 255, 255, 0.9) 42deg,
      rgba(255, 255, 255, 0.16) 104deg,
      rgba(255, 255, 255, 0) 158deg,
      rgba(255, 255, 255, 0) 214deg,
      rgba(255, 255, 255, 0.5) 272deg,
      rgba(255, 255, 255, 0.06) 322deg,
      rgba(255, 255, 255, 0) 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }
  .ft__note:hover .ft__sheen { opacity: 1; }
  .ft__noteHead {
    margin: 0 0 18px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }
  /* Ruled like a pad — the line under each row is what makes it read as a
     note rather than as another card of copy. */
  .ft__line {
    margin: 0;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    font-size: clamp(15px, 2vw, 17.5px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }
  .ft__line--mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    border-bottom: 0;
  }
  .ft__line--mail a {
    font-weight: 700;
    font-size: clamp(16px, 2.4vw, 20px);
    color: #fff;
    text-decoration: none;
    border-bottom: 2px solid rgba(116, 165, 255, 0.55);
    transition: border-color 0.2s ease;
  }
  .ft__line--mail a:hover { border-bottom-color: #74a5ff; }

  .ft__copy {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.72);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ft__copy svg { width: 12px; height: 12px; }
  .ft__copy:hover { background: rgba(255, 255, 255, 0.13); color: #fff; }
  .ft__copy[data-state='done'] {
    background: rgba(110, 231, 168, 0.18);
    border-color: rgba(110, 231, 168, 0.45);
    color: #a6f2c8;
  }
  .ft__copy[data-state='fail'] {
    background: rgba(255, 255, 255, 0.06);
    color: #ffd9a0;
  }

  .ft__sign {
    margin: 14px 0 0;
    font-family: 'Caveat', cursive;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.58);
  }

  /* ---- the tiles ----
     Big, and tilted just enough to look handled. This is the row a recruiter
     actually uses, so it gets the size that implies. */
  .ft__tiles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 20px);
    margin: clamp(30px, 4.5vw, 48px) 0 clamp(44px, 6vw, 68px);
    padding: 0;
    list-style: none;
  }
  .ft__tile {
    display: grid;
    place-items: center;
    width: clamp(66px, 9vw, 86px);
    height: clamp(66px, 9vw, 86px);
    border-radius: clamp(18px, 2.4vw, 24px);
    border: 2.5px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), background 0.28s ease;
  }
  .ft__tile svg { width: 46%; height: 46%; }
  /* Alternating tilt, so the row reads as four objects rather than a toolbar. */
  .ft__tiles li:nth-child(odd) .ft__tile { transform: rotate(-3deg); }
  .ft__tiles li:nth-child(even) .ft__tile { transform: rotate(2.5deg); }
  .ft__tile:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.06);
    background: rgba(255, 255, 255, 0.18);
  }
  .ft__tile:focus-visible { outline: 3px solid #a6f2c8; outline-offset: 4px; }

  /* ---- bottom bar ---- */
  .ft__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .ft__copyright {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }
  .ft__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ft__nav a {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ft__nav a:hover { color: #fff; }

  @media (max-width: 560px) {
    .ft__meta { flex-direction: column; gap: 14px; }
    .ft__status { text-align: left; }
    .ft__note { transform: none; }
    .ft__bar { justify-content: center; text-align: center; }
    .ft__nav ul { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ft__tile { transition: background 0.2s ease; }
    .ft__tile:hover { transform: rotate(0deg); }
  }
</style>
