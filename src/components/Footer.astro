---
/* The closing note.
 *
 * Everything here answers one question: how does someone who just finished
 * reading a case study reach you without thinking about it? So the email is
 * the largest thing on the page, it can be copied in one click for anyone who
 * lives in a webmail tab, and the five places you actually post are targets
 * you could hit with your elbow.
 *
 * What is deliberately absent: a newsletter box for a newsletter that does not
 * exist, columns of links to pages that were never written, and a weather
 * widget. A footer full of dead ends reads as a template.
 */
interface Props {
  email?: string;
  linkedin?: string;
  medium?: string;
  instagram?: string;
  x?: string;
  /** Shown top-right. Leave empty to drop the line entirely. */
  status?: string;
  resume?: string;
}

const {
  email = 'designs.bhupesh@gmail.com',
  linkedin = 'https://www.linkedin.com/in/bhupeshparmar/',
  medium = 'https://medium.com/@designs.bhupesh',
  instagram = 'https://www.instagram.com/designs.bhupesh/',
  x = 'https://x.com/designsbhupesh',
  status = 'Open to product design roles',
  resume = '/Bhupesh-Parmar-Resume.pdf',
} = Astro.props;

/* The build date, which is the last time anything here could have changed.
   Written at build rather than in the browser so it is the same for everyone
   and costs no request. */
const updated = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/* Mirrors Nav.astro. Kept short on purpose — this is a way back up, not a
   sitemap. */
const links = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/playground', label: 'Playground' },
  { href: '/about', label: 'About' },
];

const socials = [
  { key: 'mail', href: `mailto:${email}`, label: 'Email' },
  { key: 'in', href: linkedin, label: 'LinkedIn' },
  { key: 'md', href: medium, label: 'Medium' },
  { key: 'ig', href: instagram, label: 'Instagram' },
  { key: 'x', href: x, label: 'X' },
];
---

<footer class="ft">
  {/* The field is two layers. The CSS gradient underneath is what everyone
      sees first and what stays if WebGL is unavailable or motion is reduced;
      the canvas on top is the Velaris shader, which fades in only once it has
      actually drawn a frame. Nothing here is content, so losing the canvas
      costs the footer nothing. */}
  <div class="ft__field" aria-hidden="true">
    <canvas class="ft__fieldGl" data-ft-canvas></canvas>
  </div>

  <div class="ft__inner">
    <div class="ft__meta">
      <p><span>Last updated</span>{updated}</p>
      {status && <p class="ft__status"><span>Currently</span>{status}</p>}
    </div>

    {/* The note. Ruled like a pad, because a handwritten aside is the one
        thing in a portfolio that cannot be mistaken for boilerplate. */}
    <div class="ft__note" data-note>
      {/* The site's own material, not a flat card: the specular rim and top
          gloss the nav pill and the music blob are made of. Those two are the
          most recognisable things on the page, so the closing note being cut
          from the same glass is what ties this footer to the rest of the site
          rather than to a reference. It stops short of their turbulence
          displacement — see the note by `.ft__note` in the styles below. */}
      <span class="ft__gloss" aria-hidden="true"></span>
      <span class="ft__sheen" aria-hidden="true"></span>

      <p class="ft__noteHead">A note from Bhupesh</p>
      <p class="ft__line">Thanks for scrolling this far.</p>
      <p class="ft__line">If something here stuck with you, I&rsquo;d like to hear it.</p>
      <p class="ft__line ft__line--mail">
        <a href={`mailto:${email}`}>{email}</a>
        {/* Half of everyone reading this lives in a webmail tab, where a
            mailto: link opens the wrong client or nothing at all. */}
        <button type="button" class="ft__copy" data-copy={email} aria-label="Copy email address">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="2" fill="none"
              stroke="currentColor" stroke-width="1.5"></rect>
            <path d="M10.5 3.5h-6a2 2 0 0 0-2 2v6" fill="none"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </p>
      <p class="ft__sign">— Bhupesh</p>
    </div>

    {/* The prompt the tiles were missing. Four unlabelled icons ask the reader
        to decide something; a line telling them it does not matter which one
        removes the decision, which is the whole point of putting four here. */}
    {/* A small hand, not a mascot. Line art in the same stroke weight as the
        social tiles below it, and it waves for about a second in every six —
        long enough to be noticed once, short enough that it is still by the
        time anyone reads the line. */}
    <p class="ft__lead">
      <svg class="ft__wave" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M8.4 11V5.7a1.35 1.35 0 0 1 2.7 0V11M11.1 10.6V4.5a1.35 1.35 0 0 1 2.7 0v6.1M13.8 10.8V6.1a1.35 1.35 0 0 1 2.7 0v5.9M16.5 9.3a1.35 1.35 0 0 1 2.7 0v4.5a7 7 0 0 1-7 7h-.9a6 6 0 0 1-4.24-1.76l-3.05-3.05a1.45 1.45 0 0 1 2.05-2.05L8.4 15"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>Say hello, wherever you already are</span>
    </p>

    <ul class="ft__tiles">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              class={`ft__tile ft__tile--${s.key}`}
              aria-label={s.label}
              {...(s.key === 'mail' ? {} : { target: '_blank', rel: 'me noopener' })}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                {s.key === 'mail' && (
                  <>
                    <rect x="2.5" y="5" width="19" height="14" rx="2.6" fill="none"
                      stroke="currentColor" stroke-width="1.9" />
                    <path d="m3.5 7.5 8.5 6 8.5-6" fill="none" stroke="currentColor"
                      stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </>
                )}
                {s.key === 'in' && (
                  <>
                    <path d="M4.2 9.4h3v10.4h-3z" fill="currentColor" />
                    <circle cx="5.7" cy="5.6" r="1.85" fill="currentColor" />
                    <path
                      d="M10 9.4h2.9v1.5a3.3 3.3 0 0 1 2.9-1.6c2.6 0 4 1.7 4 4.6v5.9h-3v-5.3c0-1.5-.6-2.4-1.9-2.4s-2 .9-2 2.4v5.3h-2.9z"
                      fill="currentColor"
                    />
                  </>
                )}
                {s.key === 'md' && (
                  <>
                    <circle cx="6.4" cy="12" r="6.4" fill="currentColor" />
                    <ellipse cx="16.6" cy="12" rx="2.7" ry="6.4" fill="currentColor" />
                    <ellipse cx="22.3" cy="12" rx="1" ry="6.4" fill="currentColor" />
                  </>
                )}
                {s.key === 'ig' && (
                  <>
                    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2" fill="none"
                      stroke="currentColor" stroke-width="1.9" />
                    <circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor"
                      stroke-width="1.9" />
                    <circle cx="17.1" cy="6.9" r="1.25" fill="currentColor" />
                  </>
                )}
                {s.key === 'x' && (
                  <path
                    d="M3.6 3.4h4.3l4.06 5.5 4.7-5.5h2.5l-6.06 7.1 6.5 8.7h-4.3l-4.3-5.8-5 5.8H3.4l6.4-7.5z"
                    fill="currentColor"
                  />
                )}
              </svg>
            </a>
            {/* Named, not just aria-labelled. An envelope is obvious and the
                other four are not — X's mark in particular means nothing to
                anyone who has not been told. */}
            <span class="ft__tileName">{s.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="ft__bar">
      <p class="ft__copyright">&copy; {new Date().getFullYear()} Bhupesh Parmar</p>
      <nav class="ft__nav" aria-label="Footer">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={resume} target="_blank" rel="noopener">R&eacute;sum&eacute;</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  /* Copy-to-clipboard, with the button reporting what happened. writeText can
     reject — an insecure origin, or a browser that will not grant the
     permission — so the failure path says so rather than lying with a tick. */
  /* Carries the rim highlight round to whichever edge the pointer is nearest.
     Only the bearing is tracked — the face of the glass is deliberately not
     lit from here. Coalesced into one frame, because pointermove fires far
     more often than the screen refreshes and each write repaints the ring. */
  const note = document.querySelector<HTMLElement>('[data-note]');
  if (note && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let px = 0;
    let py = 0;
    let queued = 0;

    note.addEventListener('pointermove', (e) => {
      const box = note.getBoundingClientRect();
      px = e.clientX - box.left - box.width / 2;
      py = e.clientY - box.top - box.height / 2;
      if (queued) return;
      queued = requestAnimationFrame(() => {
        queued = 0;
        /* Less 90° because a conic gradient starts at twelve o'clock while
           atan2 starts at three, so without it the lit arc sits a quarter turn
           away from the cursor. */
        const deg = (Math.atan2(py, px) * 180) / Math.PI - 90;
        note.style.setProperty('--ang', deg.toFixed(1));
      });
    });
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector<HTMLElement>('[data-copy-label]');

  if (btn && label) {
    let reset = 0;
    btn.addEventListener('click', async () => {
      const done = (text: string, ok: boolean) => {
        label.textContent = text;
        btn.dataset.state = ok ? 'done' : 'fail';
        clearTimeout(reset);
        reset = window.setTimeout(() => {
          label.textContent = 'Copy';
          delete btn.dataset.state;
        }, 1900);
      };
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        done('Copied', true);
      } catch {
        done('Press ⌘C', false);
      }
    });
  }
</script>

<style>
  /* The hero opens on this blue and the page ends on it, so the white between
     them reads as a sheet laid over one continuous field rather than as the
     background itself. */
  .ft {
    position: relative;
    z-index: 3;
    overflow: hidden;
    padding: clamp(56px, 8vw, 96px) 6% clamp(28px, 3vw, 40px);
    color: #fff;
    background: #012a86;
  }
  .ft__field {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 18% 0%, rgba(116, 165, 255, 0.5) 0%, transparent 60%),
      radial-gradient(64% 70% at 88% 22%, rgba(57, 47, 250, 0.55) 0%, transparent 62%),
      radial-gradient(90% 80% at 50% 108%, rgba(0, 89, 255, 0.55) 0%, transparent 66%),
      linear-gradient(160deg, #012a86 0%, #0b3aa8 52%, #0146c9 100%);
  }
  /* Opacity is flipped by the script on first frame, so there is no flash of
     an empty black canvas over the gradient while the shader compiles. */
  .ft__fieldGl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .ft__fieldGl[data-live] { opacity: 1; }
  .ft__inner {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
  }

  /* ---- corner meta ---- */
  .ft__meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(34px, 5vw, 58px);
  }
  .ft__meta p {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
  }
  .ft__meta span {
    display: block;
    margin-bottom: 3px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .ft__status { text-align: right; }
  /* A live status earns a live dot; a static line would just be a claim. */
  .ft__status::after {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 7px;
    border-radius: 50%;
    background: #6ee7a8;
    box-shadow: 0 0 0 3px rgba(110, 231, 168, 0.22);
  }

  /* ---- the note ----
     Liquid glass over the blue field, matching .nav__pill and .music__blob.

     The edge tracks the pointer, the face does not. Those are different
     effects and only one of them worked: a bright arc travelling round the
     rim reads as the card catching light as it turns, while a highlight
     sliding across the face read as a spotlight being dragged over it. --ang
     is the pointer's bearing from the centre, written by the script. */
  .ft__note {
    --ang: 205;

    position: relative;
    isolation: isolate;
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(22px, 3.4vw, 34px) clamp(22px, 3.6vw, 38px) clamp(18px, 2.4vw, 26px);
    border-radius: 22px;
    /* Dark enough to hold the text, sheer enough to be glass. */
    background: rgba(7, 13, 42, 0.46);
    -webkit-backdrop-filter: blur(16px) saturate(165%);
    backdrop-filter: blur(16px) saturate(165%);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.22),
      inset 0 -1px 1px rgba(255, 255, 255, 0.08),
      inset 0 0 40px rgba(255, 255, 255, 0.05),
      0 30px 70px rgba(2, 10, 40, 0.45);
    /* Barely off-square, so it sits on the page like something placed rather
       than something laid out. */
    transform: rotate(-0.5deg);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  /* The turbulence map is deliberately NOT used here, though the nav pill and
     the other small chrome still take it.

     `url(#liquidGlass)` is feTurbulence -> feGaussianBlur -> feDisplacementMap
     run over the backdrop, and a backdrop filter re-runs whenever what is
     behind it moves. On a 44px blob or a nav pill that is a rounding error. On
     this note it is roughly 160k pixels — more than every other glass surface
     on the page put together, sitting directly above the footer's own WebGL
     canvas. It keeps the blur and the saturation, which is what reads as
     glass; the refraction is what cost the frames. */
  .ft__note:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.3),
      inset 0 -1px 1px rgba(255, 255, 255, 0.12),
      inset 0 0 46px rgba(255, 255, 255, 0.08),
      0 42px 90px rgba(2, 10, 40, 0.52);
  }

  .ft__note > span {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
  }
  /* Content clears the three light layers. */
  .ft__note > p { position: relative; z-index: 2; }

  /* Light entering the upper surface — fixed, the part that does not depend
     on where you are pointing. */
  .ft__gloss {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.14) 0%,
      rgba(255, 255, 255, 0.03) 34%,
      rgba(255, 255, 255, 0) 58%
    );
  }

  /* The edge. A conic sweep masked to a hairline ring, so the bright arc rides
     the border rather than filling the card — the same construction as
     .nav__sheen. Rotating `from` by the pointer's bearing is what carries the
     highlight round the border as you cross the card. */
  .ft__sheen {
    padding: 1.25px;
    background: conic-gradient(
      from calc(var(--ang) * 1deg) at 50% 50%,
      rgba(255, 255, 255, 0) 0deg,
      rgba(255, 255, 255, 0.9) 42deg,
      rgba(255, 255, 255, 0.16) 104deg,
      rgba(255, 255, 255, 0) 158deg,
      rgba(255, 255, 255, 0) 214deg,
      rgba(255, 255, 255, 0.5) 272deg,
      rgba(255, 255, 255, 0.06) 322deg,
      rgba(255, 255, 255, 0) 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }
  .ft__note:hover .ft__sheen { opacity: 1; }
  .ft__noteHead {
    margin: 0 0 18px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }
  /* Ruled like a pad — the line under each row is what makes it read as a
     note rather than as another card of copy. */
  .ft__line {
    margin: 0;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    font-size: clamp(15px, 2vw, 17.5px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }
  .ft__line--mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    border-bottom: 0;
  }
  .ft__line--mail a {
    font-weight: 700;
    font-size: clamp(16px, 2.4vw, 20px);
    color: #fff;
    text-decoration: none;
    border-bottom: 2px solid rgba(116, 165, 255, 0.55);
    transition: border-color 0.2s ease;
  }
  .ft__line--mail a:hover { border-bottom-color: #74a5ff; }

  .ft__copy {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.72);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ft__copy svg { width: 12px; height: 12px; }
  .ft__copy:hover { background: rgba(255, 255, 255, 0.13); color: #fff; }
  .ft__copy[data-state='done'] {
    background: rgba(110, 231, 168, 0.18);
    border-color: rgba(110, 231, 168, 0.45);
    color: #a6f2c8;
  }
  .ft__copy[data-state='fail'] {
    background: rgba(255, 255, 255, 0.06);
    color: #ffd9a0;
  }

  .ft__sign {
    margin: 14px 0 0;
    font-family: 'Caveat', cursive;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.58);
  }

  /* ---- the tiles ----
     Big, and tilted just enough to look handled. This is the row a recruiter
     actually uses, so it gets the size that implies. */
  /* The line that turns four icons into an invitation. */
  .ft__lead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: clamp(28px, 4vw, 44px) 0 0;
    text-align: center;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.1px;
    color: rgba(255, 255, 255, 0.62);
  }

  .ft__wave {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
    /* Pivot at the wrist, which is where a hand actually hinges. Rotating about
       the centre makes it slide rather than wave. */
    transform-origin: 70% 85%;
    animation: ft-wave 6s ease-in-out infinite;
  }

  /* Four beats of waving, then five seconds of nothing. A hand that waves
     continuously is a mascot; this one just catches the eye once. */
  @keyframes ft-wave {
    0%, 82%, 100% { transform: rotate(0deg); }
    85% { transform: rotate(13deg); }
    88% { transform: rotate(-9deg); }
    91% { transform: rotate(11deg); }
    94% { transform: rotate(-7deg); }
    97% { transform: rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ft__wave { animation: none; }
  }

  .ft__tiles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 22px);
    margin: clamp(16px, 2.2vw, 24px) 0 clamp(44px, 6vw, 68px);
    padding: 0;
    list-style: none;
  }
  .ft__tiles li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;
  }
  .ft__tileName {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.2px;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.24s ease;
  }
  .ft__tiles li:hover .ft__tileName { color: #fff; }
  .ft__tile {
    display: grid;
    place-items: center;
    width: clamp(66px, 9vw, 86px);
    height: clamp(66px, 9vw, 86px);
    border-radius: clamp(18px, 2.4vw, 24px);
    border: 2.5px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), background 0.28s ease;
  }
  .ft__tile svg { width: 46%; height: 46%; }
  /* Alternating tilt, so the row reads as a handful of objects rather than a toolbar. */
  .ft__tiles li:nth-child(odd) .ft__tile { transform: rotate(-3deg); }
  .ft__tiles li:nth-child(even) .ft__tile { transform: rotate(2.5deg); }
  .ft__tile:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.06);
    background: rgba(255, 255, 255, 0.18);
  }
  .ft__tile:focus-visible { outline: 3px solid #a6f2c8; outline-offset: 4px; }

  /* ---- bottom bar ---- */
  .ft__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .ft__copyright {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
  }
  .ft__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ft__nav a {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .ft__nav a:hover { color: #fff; }

  @media (max-width: 560px) {
    .ft__meta { flex-direction: column; gap: 14px; }
    .ft__status { text-align: left; }
    .ft__note { transform: none; }
    .ft__bar { justify-content: center; text-align: center; }
    .ft__nav ul { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ft__tile { transition: background 0.2s ease; }
    .ft__tile:hover { transform: rotate(0deg); }
  }
</style>

<script>
  /* ---- the field ----
     A port of the Velaris shader (21st.dev). The GLSL is that component's,
     unchanged: three layers of simplex noise folded into each other, four
     colours mixed over a background, a vignette, a centre glow and film
     grain. What changed is the palette — the original ships greens, and this
     is the site's blue scale — and everything below the shader, which is the
     React stripped out.

     Three departures from the original, all about it being a footer:

     1. It only runs while it is on screen. The original renders from mount,
        which for a footer means a fullscreen shader burning frames the whole
        time someone reads the top of a long page.
     2. The colour uniforms are set once, not per frame. The original parses
        five hex strings and allocates a Float32Array inside its render loop,
        60 times a second, for values that never change.
     3. Reduced motion draws a single frame and stops, so the grain and the
        drift hold still and the footer keeps its depth. */

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ft-canvas]');
  const field = canvas?.parentElement ?? null;

  if (canvas && field) {
    const vert = `
      attribute vec2 position;
      varying vec2 vUv;
      void main() {
        vUv = position * 0.5 + 0.5;
        gl_Position = vec4(position, 0.0, 1.0);
      }
    `;

    const frag = `
      precision highp float;
      varying vec2 vUv;

      uniform vec2  u_resolution;
      uniform float u_time;
      uniform float u_grain;
      uniform vec3  u_colors[4];
      uniform vec3  u_bg;
      uniform float u_floor;

      vec3 permute(vec3 x) { return mod(((x*34.0)+1.0)*x, 289.0); }

      float snoise(vec2 v){
        const vec4 C = vec4(0.211324865405187, 0.366025403784439,
                 -0.577350269189626, 0.024390243902439);
        vec2 i  = floor(v + dot(v, C.yy) );
        vec2 x0 = v -   i + dot(i, C.xx);
        vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
        vec4 x12 = x0.xyxy + C.xxzz;
        x12.xy -= i1;
        i = mod(i, 289.0);
        vec3 p = permute( permute( i.y + vec3(0.0, i1.y, 1.0 ))
        + i.x + vec3(0.0, i1.x, 1.0 ));
        vec3 m = max(0.5 - vec3(dot(x0,x0), dot(x12.xy,x12.xy),
          dot(x12.zw,x12.zw)), 0.0);
        m = m*m ;
        m = m*m ;
        vec3 x = 2.0 * fract(p * C.www) - 1.0;
        vec3 h = abs(x) - 0.5;
        vec3 ox = floor(x + 0.5);
        vec3 a0 = x - ox;
        m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
        vec3 g;
        g.x  = a0.x  * x0.x  + h.x  * x0.y;
        g.yz = a0.yz * x12.xz + h.yz * x12.yw;
        return 130.0 * dot(m, g);
      }

      void main() {
        vec2 uv = vUv;
        float ratio = u_resolution.x / u_resolution.y;
        vec2 p = uv - 0.5;
        p.x *= ratio;

        float t = u_time * 0.1;

        float n1 = snoise(p * 0.4 + vec2(t * 0.2, -t * 0.3));
        float n2 = snoise(p * 0.55 + vec2(-t * 0.15, t * 0.25) + n1 * 0.25);
        float n3 = snoise(p * 0.75 + vec2(t * 0.1, -t * 0.2) + n2 * 0.2);

        vec3 col = u_bg;

        /* The source ends its vignette at 1.2. A footer is far wider than it
           is tall, so p.x is scaled by the aspect ratio and the corners land
           past 1.5 — off the end of the ramp, fully darkened. Pushing the
           outer stop to 2.0 keeps the whole box on the curve. */
        float dist = length(p) * 1.5;
        float vignette = 1.0 - smoothstep(0.4, 2.0, dist);

        col = mix(col, u_colors[0], smoothstep(-0.2, 0.5, n1) * 0.85);
        col = mix(col, u_colors[1], smoothstep(-0.1, 0.6, n2) * 0.7);
        col = mix(col, u_colors[2], smoothstep(-0.3, 0.4, n3) * 0.6);
        col = mix(col, u_colors[3], smoothstep(0.0, 0.7, n1 * n2) * 0.5);

        float glow = smoothstep(0.8, 0.0, dist) * 0.3;
        col += u_colors[1] * glow;

        // Was a hard-coded 0.2 — an 80% crush at the edges. See u_floor.
        col = mix(col * u_floor, col, vignette);

        float grain = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453 + u_time);
        col += (grain - 0.5) * u_grain * 0.1;

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    /* Was ["#86efac", "#4ade80", "#059669", "#000000"] on #000000. Every
       value here is now a literal hero token — the --m-* set on .hero__bg in
       global.css — so the footer resolves to the same field the page opened
       with rather than merely to the same family:

         bg        --m-g2    the hero's mid ground
         colors[0] --m-hi    its light highlights
         colors[1] --m-g3    its brightest ground, and also the centre glow
         colors[2] --m-glow  the violet cast the hero carries top-right
         colors[3] --m-deep  the fold it darkens into

       --m-g1 (#01113a) is the one hero token left out: it is the deepest
       thing in that palette, and the point of the last pass was to stop the
       footer bottoming out in near-black. */
    const BG = '#012a86';
    const COLORS = ['#74a5ff', '#0146c9', '#392ffa', '#003dae'];
    const SPEED = 2.0;
    const GRAIN = 0.3;
    /* How much light survives at the very edge of the vignette, 0 = black.
       This is the dial for how dark the corners go. */
    const VIGNETTE_FLOOR = 0.55;

    const hexToRgb = (hex: string): [number, number, number] => {
      const h = hex.replace('#', '');
      return [
        parseInt(h.slice(0, 2), 16) / 255,
        parseInt(h.slice(2, 4), 16) / 255,
        parseInt(h.slice(4, 6), 16) / 255,
      ];
    };

    const gl = canvas.getContext('webgl');

    if (gl) {
      const compile = (type: number, src: string) => {
        const sh = gl.createShader(type)!;
        gl.shaderSource(sh, src);
        gl.compileShader(sh);
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
          console.warn('footer shader:', gl.getShaderInfoLog(sh));
          return null;
        }
        return sh;
      };

      const vs = compile(gl.VERTEX_SHADER, vert);
      const fs = compile(gl.FRAGMENT_SHADER, frag);
      const program = vs && fs ? gl.createProgram()! : null;

      if (program && vs && fs) {
        gl.attachShader(program, vs);
        gl.attachShader(program, fs);
        gl.linkProgram(program);

        if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
          gl.useProgram(program);

          const buffer = gl.createBuffer();
          gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
          gl.bufferData(
            gl.ARRAY_BUFFER,
            new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
            gl.STATIC_DRAW,
          );
          const pos = gl.getAttribLocation(program, 'position');
          gl.enableVertexAttribArray(pos);
          gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

          const uRes = gl.getUniformLocation(program, 'u_resolution');
          const uTime = gl.getUniformLocation(program, 'u_time');

          // Set once — none of these change for the life of the page.
          gl.uniform1f(gl.getUniformLocation(program, 'u_grain'), GRAIN);
          gl.uniform1f(gl.getUniformLocation(program, 'u_floor'), VIGNETTE_FLOOR);
          gl.uniform3f(gl.getUniformLocation(program, 'u_bg'), ...hexToRgb(BG));
          gl.uniform3fv(
            gl.getUniformLocation(program, 'u_colors'),
            new Float32Array(COLORS.flatMap(hexToRgb)),
          );

          const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let raf = 0;
          let live = false;
          let inView = false;

          const resize = () => {
            /* Deliberately 1, not devicePixelRatio.

               This field is three folded layers of simplex noise evaluated per
               pixel, and it fills the footer. At dpr 2 on a 1440pt window that
               is 2880x1664 — 4.8 million pixels of noise every frame, for a
               soft blurred gradient with a vignette on it. There is nothing in
               the image above about 20px across, so the second sample per axis
               buys literally nothing visible and costs four times the work. */
            const dpr = 1;
            const w = Math.round(field.clientWidth * dpr);
            const h = Math.round(field.clientHeight * dpr);
            if (!w || !h || (canvas.width === w && canvas.height === h)) return;
            canvas.width = w;
            canvas.height = h;
            gl.viewport(0, 0, w, h);
          };

          const draw = (t: number) => {
            gl.uniform2f(uRes, canvas.width, canvas.height);
            gl.uniform1f(uTime, t * 0.001 * SPEED);
            gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
            if (!live) {
              live = true;
              canvas.setAttribute('data-live', '');
            }
          };

          const frame = (t: number) => {
            raf = requestAnimationFrame(frame);
            draw(t);
          };

          const start = () => {
            if (raf || still) return;
            raf = requestAnimationFrame(frame);
          };
          const stop = () => {
            if (!raf) return;
            cancelAnimationFrame(raf);
            raf = 0;
          };

          new ResizeObserver(() => {
            resize();
            // A resize while paused still needs the new size on screen.
            if (!raf) draw(performance.now());
          }).observe(field);

          resize();

          /* The footer is the last thing on a long page. Rendering it while
             someone is still at the top is work nobody sees. */
          new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                inView = e.isIntersecting;
                if (inView) start();
                else stop();
              }
            },
            { rootMargin: '200px' },
          ).observe(field);

          // Reduced motion: one frame, held.
          if (still) draw(0);

          /* Both directions: a backgrounded tab throttles rAF but does not
             stop it, and coming back to a footer that never restarted would
             leave a frozen gradient. */
          document.addEventListener('visibilitychange', () => {
            if (document.hidden) stop();
            else if (inView) start();
          });
        }
      }
    }
  }
</script>
