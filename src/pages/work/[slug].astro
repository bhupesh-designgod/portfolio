---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseHeroField from '../../components/CaseHeroField.astro';
import CaseBlocks from '../../components/CaseBlocks.astro';
import Walkthrough from '../../components/Walkthrough.astro';
import { existsSync } from 'node:fs';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

/* Only h2s make the contents rail — h3s are detail inside a section. */
const toc = headings.filter((h) => h.depth === 2);

/* 220 wpm is the usual figure for on-screen prose. */
const words = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 220));

/* The hook can be shorter and punchier than the card headline. A phrase
   wrapped in *asterisks* is the part that takes the accent — one per hook,
   so the colour marks the point of the sentence rather than decorating it. */
const hook = d.heroTitle ?? d.title;
const hookParts = hook.split(/\*(.+?)\*/);

/* What to read next. The projects in home-page order, minus this one; the
   first of them is the "next" and gets the banner, the rest go in the grid.
   Wrapping around means the last case study still has a next. */
const all = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const idx = all.findIndex((p) => p.id === entry.id);
const rest = [...all.slice(idx + 1), ...all.slice(0, idx)];
const next = rest[0];
const more = rest.slice(1);

const shotOf = (p: (typeof all)[number]) =>
  p.data.cover ?? p.data.folderArt ?? p.data.shots?.[0];

/* Walkthrough audio is generated locally by `npm run walkthrough` and committed,
   so whether this case study has one is a question about the filesystem at build
   time. Checked here rather than fetched in the browser: a case study without a
   script should not ship the player at all, let alone show a control that turns
   out to lead nowhere. */
const hasWalkthrough = existsSync(
  new URL(`../../../public/walkthrough/${entry.id}/manifest.json`, import.meta.url),
);
---

<Base title={`${d.client} — ${d.title}`} description={d.summary}>
  {/* Reading progress, as a hairline across the very top of the window. The
      contents rail has its own meter, but the rail is gone on phones and
      off screen while the hero fills it; this one is always there. */}
  <div class="cs-progress" aria-hidden="true"><span id="csBar"></span></div>

  <article class="cs" data-costume={d.costume} data-accent={d.accent}>
    <!-- ---------------- HERO: the hook ---------------- -->
    <header class="cs-hero" id="csHero">
      <div class="cs-hero__bg" aria-hidden="true">
        <div class="cs-hero__blobs"></div>
        <div class="cs-hero__orb cs-hero__orb--a"></div>
        <div class="cs-hero__orb cs-hero__orb--b"></div>
        <div class="cs-hero__glow"></div>
        <CaseHeroField />
        <div class="cs-hero__glass"></div>
        <div class="cs-hero__grain"></div>
      </div>

      <a class="cs-hero__close" href="/#work" aria-label="Back to all work">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </a>

      <div class:list={['cs-hero__inner', !d.cover && 'cs-hero__inner--solo']}>
        <div class="cs-hero__type">
          <p class="cs-hero__kicker">
            <span class="cs-hero__client">{d.client}</span>
            <span class="cs-hero__dot" aria-hidden="true"></span>
            <span>Case study</span>
          </p>
          <h1 class="cs-hero__title">
            {hookParts.map((part, i) =>
              i % 2 === 1 ? <em>{part}</em> : part,
            )}
          </h1>
          <p class="cs-hero__summary">{d.summary}</p>
        </div>

        {
          d.cover && (
            <div class="cs-hero__aside" data-tilt>
              <figure class:list={['cs-hero__shot', `cs-hero__shot--${d.coverKind}`]}>
                {d.coverKind === 'window' && (
                  <span class="cs-hero__bar" aria-hidden="true"><i /><i /><i /></span>
                )}
                <img src={d.cover} alt={d.coverAlt ?? ''} fetchpriority="high" />
              </figure>
            </div>
          )
        }
      </div>

      <div class="cs-hero__foot">
        <dl class="cs-hero__meta">
          <div><dt>Client</dt><dd>{d.client}</dd></div>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.timeline && <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>}
          {d.tags.length > 0 && <div><dt>Focus</dt><dd>{d.tags.join(', ')}</dd></div>}
          <div><dt>Read</dt><dd>{readingTime} min</dd></div>
        </dl>
        <a class="cs-hero__cue" href={toc[0] ? `#${toc[0].slug}` : '#csProse'} aria-label="Start reading">
          <span>Scroll</span>
          <i aria-hidden="true"></i>
        </a>
      </div>
    </header>

    <!-- ---------------- BODY: the reading environment ---------------- -->
    <div class="cs-read">
      <div class="cs-read__inner">
        {
          toc.length > 0 && (
            <nav class="cs-toc" aria-label="On this page">
              <div class="cs-toc__sticky">
                <div class="cs-toc__head">
                  <p class="cs-toc__label">Contents</p>
                  <p class="cs-toc__pct" id="csPct">0%</p>
                </div>
                <div
                  class="cs-toc__meter"
                  id="csMeter"
                  role="progressbar"
                  aria-label="Reading progress"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                >
                  <span class="cs-toc__meterFill" id="csFill" />
                </div>
                <ol class="cs-toc__list">
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc={h.slug}>
                        <span class="cs-toc__n" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="cs-toc__t">{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )
        }

        <div class="prose cs-prose" id="csProse">
          <Content />
        </div>
      </div>

      {/* Phones: the rail has collapsed into a list above the article, so
          once you are reading there is no way to see where you are or jump.
          This pill sits at the bottom of the screen and opens the same list
          as a sheet. */}
      {toc.length > 0 && (
        <>
          <button class="cs-jump" id="csJump" type="button" aria-haspopup="dialog" aria-controls="csSheet">
            <span class="cs-jump__n" id="csJumpN">01</span>
            <span class="cs-jump__t" id="csJumpT">{toc[0].text}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
          <dialog class="cs-sheet" id="csSheet" aria-label="Jump to a section">
            <div class="cs-sheet__head">
              <p>On this page</p>
              <button type="button" class="cs-sheet__close" id="csSheetClose" aria-label="Close">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              </button>
            </div>
            <ol class="cs-sheet__list">
              {toc.map((h, i) => (
                <li><a href={`#${h.slug}`} data-sheet={h.slug}><span>{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
              ))}
            </ol>
          </dialog>
        </>
      )}

      {next && (
        <section class="cs-next" aria-labelledby="cs-next-head">
          <a class="cs-next__card" href={`/work/${next.id}`} data-accent={next.data.accent}>
            <div class="cs-next__bg" aria-hidden="true"></div>
            <div class="cs-next__txt">
              <p class="cs-next__label" id="cs-next-head">Next case study</p>
              <p class="cs-next__client">{next.data.client}</p>
              <h2 class="cs-next__title">{(next.data.heroTitle ?? next.data.title).replace(/\*/g, '')}</h2>
              <p class="cs-next__sum">{next.data.summary}</p>
              <span class="cs-next__go">
                Read it
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h13M12.5 6.5 19 12l-6.5 5.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
            <span class="cs-next__shot">
              {shotOf(next) && <img src={shotOf(next)} alt="" loading="lazy" decoding="async" />}
            </span>
          </a>
        </section>
      )}

      {more.length > 0 && (
        <section class="cs-more" aria-labelledby="cs-more-head">
          <h2 class="cs-more__head" id="cs-more-head">More work</h2>
          <ul class="cs-more__grid">
            {more.map((p) => {
              const shot = shotOf(p);
              return (
                <li>
                  <a class="cs-more__card" href={`/work/${p.id}`} data-accent={p.data.accent}>
                    <span class="cs-more__shot">
                      {shot && <img src={shot} alt="" loading="lazy" decoding="async" />}
                    </span>
                    <span class="cs-more__txt">
                      <span class="cs-more__client">{p.data.client}</span>
                      <b class="cs-more__title">{p.data.title}</b>
                      <span class="cs-more__sum">{p.data.summary}</span>
                      <span class="cs-more__go">
                        Read the case study
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M5 12h13M12.5 6.5 19 12l-6.5 5.5" fill="none"
                            stroke="currentColor" stroke-width="2.1"
                            stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <nav class="cs-foot">
        <a href="/#work">&larr; All work</a>
        <a href="#csHero" class="cs-foot__top">Back to top &uarr;</a>
      </nav>
    </div>
  </article>

  {hasWalkthrough && <Walkthrough slug={entry.id} title={`${d.client} — ${d.title}`} accent={d.accent} />}

  {/* Lightbox. One dialog for every image on the page; the script fills it
      from whichever figure was clicked and walks prev/next through the rest. */}
  <dialog class="cs-lb" id="csLb" aria-label="Image viewer">
    <button type="button" class="cs-lb__btn cs-lb__close" id="csLbClose" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <button type="button" class="cs-lb__btn cs-lb__prev" id="csLbPrev" aria-label="Previous image">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="cs-lb__btn cs-lb__next" id="csLbNext" aria-label="Next image">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <figure class="cs-lb__fig">
      <img id="csLbImg" alt="" />
      <figcaption id="csLbCap"></figcaption>
    </figure>
    <p class="cs-lb__count" id="csLbCount"></p>
  </dialog>
  <CaseBlocks />
</Base>

{/* Runs during parse so the nav starts light over the dark hero — no flash of
    dark labels before the module script below boots. */}
<script is:inline>document.documentElement.dataset.navTone = 'dark';</script>

<script>
  /* ---- scroll-driven state ----
     One rAF-throttled pass drives: nav ink, the top hairline, the rail meter,
     the current section (rail + phone pill), and the hero's parallax. */
  const root = document.documentElement;
  const hero = document.getElementById('csHero');
  const read = document.querySelector<HTMLElement>('.cs-read');
  const prose = document.getElementById('csProse');
  const fill = document.getElementById('csFill');
  const bar = document.getElementById('csBar');
  const meter = document.getElementById('csMeter');
  const pct = document.getElementById('csPct');
  const jumpN = document.getElementById('csJumpN');
  const jumpT = document.getElementById('csJumpT');
  const navPill = document.querySelector<HTMLElement>('.nav__pill');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const sheetLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-sheet]'));
  const targets = links
    .map((l) => document.getElementById(l.dataset.toc!))
    .filter((el): el is HTMLElement => Boolean(el));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  let ticking = false;
  let lastActive = -2;

  function update() {
    ticking = false;

    if (read) {
      const navBottom = navPill ? navPill.getBoundingClientRect().bottom : 70;
      root.dataset.navTone = read.getBoundingClientRect().top > navBottom ? 'dark' : 'light';
    }

    /* The hero's type drifts up at half scroll speed and fades, so the
       reading surface reads as rising over it rather than shoving it away. */
    if (hero && !reduce) {
      const y = window.scrollY;
      const h = hero.offsetHeight || 1;
      const p = clamp(y / h);
      hero.style.setProperty('--cs-scroll', String(p));
    }

    if (!prose) return;

    const line = 168;
    const r = prose.getBoundingClientRect();
    const span = r.height - window.innerHeight;
    const p = span > 0 ? clamp(-r.top / span) : r.top <= 0 ? 1 : 0;

    if (fill) fill.style.transform = `scaleX(${p})`;
    if (bar) bar.style.transform = `scaleX(${p})`;

    const shown = Math.round(p * 100);
    if (pct && pct.textContent !== `${shown}%`) pct.textContent = `${shown}%`;
    if (meter) meter.setAttribute('aria-valuenow', String(shown));

    if (targets.length) {
      let active = -1;
      for (let i = 0; i < targets.length; i++) {
        if (targets[i].getBoundingClientRect().top <= line) active = i;
      }
      if (active !== lastActive) {
        lastActive = active;
        links.forEach((l, i) => {
          const on = i === active;
          l.classList.toggle('is-active', on);
          l.classList.toggle('is-read', i < active);
          if (on) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        });
        sheetLinks.forEach((l, i) => l.classList.toggle('is-active', i === active));
        const shownIdx = Math.max(0, active);
        if (jumpN) jumpN.textContent = String(shownIdx + 1).padStart(2, '0');
        if (jumpT && links[shownIdx]) jumpT.textContent = links[shownIdx].querySelector('.cs-toc__t')?.textContent ?? '';
      }
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', update);
  update();

  /* ---- hero entrance ----
     Held for the display face, same as the home page: a headline that rises
     in a fallback font and then snaps is worse than a beat of stillness. */
  if (hero) {
    const reveal = () => hero.classList.add('is-in');
    const ready = (document as any).fonts?.ready;
    if (ready) {
      let done = false;
      const once = () => { if (!done) { done = true; reveal(); } };
      ready.then(once);
      setTimeout(once, 900);
    } else reveal();
  }

  /* ---- cover tilt ----
     The cover leans toward the pointer, a few degrees at most. Mouse only:
     on touch there is no pointer to lean toward and the float animation in
     CSS carries it. */
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt && hero && window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reduce) {
    let rx = 0, ry = 0, tx = 0, ty = 0, raf = 0;
    const ease = () => {
      raf = 0;
      rx += (tx - rx) * 0.08;
      ry += (ty - ry) * 0.08;
      tilt.style.setProperty('--rx', `${rx.toFixed(2)}deg`);
      tilt.style.setProperty('--ry', `${ry.toFixed(2)}deg`);
      if (Math.abs(tx - rx) > 0.01 || Math.abs(ty - ry) > 0.01) raf = requestAnimationFrame(ease);
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      tx = -ny * 9;
      ty = nx * 11;
      if (!raf) raf = requestAnimationFrame(ease);
    }, { passive: true });
    hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(ease); });
  }

  /* ---- counters ----
     Every number in a stat counts up from zero the first time its block is
     seen. Years are left alone: 2026 counting up from 0 reads as a bug.

     This is the only scroll-driven motion left in the article. The blanket
     fade-up that used to run on every block was watching eighty-odd elements
     and writing a stagger index onto every one of their children at load,
     which is a lot of style recalculation to buy an effect nobody asked the
     page for. */
  if (prose && !reduce && 'IntersectionObserver' in window) {
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const cio = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        cio.unobserve(en.target);
        const el = en.target as HTMLElement;
        const final = el.textContent || '';
        const parts = final.split(/(\d+)/);
        if (!parts.some((p, i) => i % 2 === 1 && Number(p) < 1900)) return;
        const t0 = performance.now();
        const dur = 1100;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          el.textContent = parts
            .map((seg, i) => {
              if (i % 2 === 0) return seg;
              const n = Number(seg);
              return n >= 1900 ? seg : String(Math.round(n * ease(p)));
            })
            .join('');
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = final;
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    prose.querySelectorAll<HTMLElement>('.k-stats b').forEach((c) => cio.observe(c));
  }

  /* ---- phone section sheet ---- */
  const jump = document.getElementById('csJump');
  const sheet = document.getElementById('csSheet') as HTMLDialogElement | null;
  const sheetClose = document.getElementById('csSheetClose');
  if (jump && sheet) {
    jump.addEventListener('click', () => sheet.showModal());
    sheetClose?.addEventListener('click', () => sheet.close());
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    sheetLinks.forEach((l) => l.addEventListener('click', () => sheet.close()));
  }

  /* ---- lightbox ----
     Every image inside the article, in document order. Clicking one opens
     it at full size; arrows and swipes walk the set. Tiny images (icons,
     swatches) are skipped by the size check. */
  const lb = document.getElementById('csLb') as HTMLDialogElement | null;
  const lbImg = document.getElementById('csLbImg') as HTMLImageElement | null;
  const lbCap = document.getElementById('csLbCap');
  const lbCount = document.getElementById('csLbCount');
  if (prose && lb && lbImg) {
    const imgs = Array.from(prose.querySelectorAll<HTMLImageElement>('img')).filter((im) => {
      const w = Number(im.getAttribute('width')) || im.naturalWidth || 0;
      return w >= 300;
    });
    let cur = 0;

    const captionFor = (im: HTMLImageElement) => {
      const fig = im.closest('figure');
      const cap = fig?.querySelector('figcaption');
      if (cap) return cap.textContent?.replace(/\s+/g, ' ').trim() ?? '';
      return im.alt;
    };

    const show = (n: number) => {
      cur = (n + imgs.length) % imgs.length;
      const im = imgs[cur];
      lbImg.src = im.currentSrc || im.src;
      lbImg.alt = im.alt;
      if (lbCap) lbCap.textContent = captionFor(im);
      if (lbCount) lbCount.textContent = `${cur + 1} / ${imgs.length}`;
    };

    imgs.forEach((im, i) => {
      im.classList.add('is-zoomable');
      im.setAttribute('tabindex', '0');
      im.setAttribute('role', 'button');
      const open = () => { show(i); lb.showModal(); };
      im.addEventListener('click', open);
      im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });

    document.getElementById('csLbClose')?.addEventListener('click', () => lb.close());
    document.getElementById('csLbPrev')?.addEventListener('click', () => show(cur - 1));
    document.getElementById('csLbNext')?.addEventListener('click', () => show(cur + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
    let sx = 0;
    lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 48) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }

</script>
