---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

/* Only h2s make the contents rail — h3s are detail inside a section. */
const toc = headings.filter((h) => h.depth === 2);

/* 220 wpm is the usual figure for on-screen prose. */
const words = (entry.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 220));

/* The hook can be shorter and punchier than the card headline. */
const hook = d.heroTitle ?? d.title;
---

<Base title={`${d.client} — ${d.title}`} description={d.summary}>
  <article class="cs" data-costume={d.costume} data-accent={d.accent}>
    <!-- ---------------- HERO: the hook ---------------- -->
    <header class="cs-hero">
      <div class="cs-hero__bg" aria-hidden="true">
        <div class="cs-hero__blobs"></div>
        <div class="cs-hero__orb cs-hero__orb--a"></div>
        <div class="cs-hero__orb cs-hero__orb--b"></div>
        <div class="cs-hero__glow"></div>
        <div class="cs-hero__glass"></div>
        <div class="cs-hero__grain"></div>
      </div>

      <a class="cs-hero__close" href="/#work" aria-label="Back to all work">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6L6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </a>

      {/* Without a cover the second column has nothing in it — the summary
          used to fill it. One column rather than a void. */}
      <div class:list={['cs-hero__inner', !d.cover && 'cs-hero__inner--solo']}>
        {/* The hook stands on its own — no kicker above it. The client is a
            fact about the work, so it belongs in the meta row with the rest
            of them, not stacked over the headline as a label. */}
        <div class="cs-hero__type">
          <h1 class="cs-hero__title">{hook}</h1>
          <p class="cs-hero__summary">{d.summary}</p>
        </div>

        <div class="cs-hero__aside">
          {
            d.cover && (
              <figure class="cs-hero__shot">
                <img src={d.cover} alt={d.coverAlt ?? ''} />
              </figure>
            )
          }
        </div>
      </div>

      <dl class="cs-hero__meta">
        <div><dt>Client</dt><dd>{d.client}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        {d.timeline && <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>}
        {d.tags.length > 0 && <div><dt>Focus</dt><dd>{d.tags.join(', ')}</dd></div>}
        <div><dt>Read</dt><dd>{readingTime} min</dd></div>
      </dl>
    </header>

    <!-- ---------------- BODY: the reading environment ---------------- -->
    <div class="cs-read">
      <div class="cs-read__inner">
        {
          toc.length > 0 && (
            <nav class="cs-toc" aria-label="On this page">
              <div class="cs-toc__sticky">
                <div class="cs-toc__head">
                  <p class="cs-toc__label">Contents</p>
                  <p class="cs-toc__pct" id="csPct">0%</p>
                </div>
                {/* The meter is the answer to "how much is left". It is a real
                    progressbar rather than a decorated div so a screen reader
                    gets the same answer the sighted reader does. */}
                <div
                  class="cs-toc__meter"
                  id="csMeter"
                  role="progressbar"
                  aria-label="Reading progress"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                >
                  <span class="cs-toc__meterFill" id="csFill" />
                </div>
                <ol class="cs-toc__list">
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`} data-toc={h.slug}>
                        <span class="cs-toc__n" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span class="cs-toc__t">{h.text}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )
        }

        <div class="prose cs-prose" id="csProse">
          <Content />
        </div>
      </div>

      <nav class="cs-foot">
        <a href="/#work">&larr; All work</a>
      </nav>
    </div>
  </article>
</Base>

{/* Runs during parse so the nav starts light over the blue hero — no flash of
    dark labels before the module script below boots. */}
<script is:inline>document.documentElement.dataset.navTone = 'dark';</script>

<script>
  /* Two jobs, both driven off one rAF-throttled scroll pass:
     1. nav ink flips when the white reading surface reaches the nav
     2. the contents rail tracks which section you're in, and how far you've read */
  const root = document.documentElement;
  const read = document.querySelector<HTMLElement>('.cs-read');
  const prose = document.getElementById('csProse');
  const fill = document.getElementById('csFill');
  const meter = document.getElementById('csMeter');
  const pct = document.getElementById('csPct');
  const navPill = document.querySelector<HTMLElement>('.nav__pill');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const targets = links
    .map((l) => document.getElementById(l.dataset.toc!))
    .filter((el): el is HTMLElement => Boolean(el));

  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  let ticking = false;

  function update() {
    ticking = false;

    if (read) {
      const navBottom = navPill ? navPill.getBoundingClientRect().bottom : 70;
      root.dataset.navTone = read.getBoundingClientRect().top > navBottom ? 'dark' : 'light';
    }

    if (!prose) return;

    /* The reading line: a little below the nav, where the eye actually sits. */
    const line = 168;
    const r = prose.getBoundingClientRect();

    /* Progress runs from "the article's first line has reached the top of the
       window" to "its last line has reached the bottom". The previous version
       divided by the article's full height, which counts one screenful the
       reader never has to scroll past — so it read ~90% at the end and never
       arrived. `span` subtracts that screenful. */
    const span = r.height - window.innerHeight;
    const p = span > 0 ? clamp(-r.top / span) : r.top <= 0 ? 1 : 0;

    if (fill) fill.style.transform = `scaleX(${p})`;

    const shown = Math.round(p * 100);
    if (pct && pct.textContent !== `${shown}%`) pct.textContent = `${shown}%`;
    if (meter) meter.setAttribute('aria-valuenow', String(shown));

    if (targets.length) {
      /* -1 until the first heading crosses the line, so nothing is marked
         current while the hero still fills the screen. */
      let active = -1;
      for (let i = 0; i < targets.length; i++) {
        if (targets[i].getBoundingClientRect().top <= line) active = i;
      }
      links.forEach((l, i) => {
        const on = i === active;
        l.classList.toggle('is-active', on);
        l.classList.toggle('is-read', i < active);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    }
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', update);
  update();

  /* ---- k-gal ----
     Upgrades a plain stack of figures into a thumbnail rail plus one large
     stage. Runs only if there are at least two figures — a gallery of one is
     just a picture with extra chrome. */
  document.querySelectorAll<HTMLElement>('.k-gal').forEach((gal, gi) => {
    const figs = Array.from(gal.querySelectorAll<HTMLElement>(':scope > figure'));
    if (figs.length < 2) return;

    const rail = document.createElement('div');
    rail.className = 'k-gal__rail';
    rail.setAttribute('role', 'tablist');
    rail.setAttribute('aria-label', 'Screens');

    const tabs: HTMLButtonElement[] = [];

    figs.forEach((fig, i) => {
      const img = fig.querySelector('img');
      const cap = fig.querySelector('figcaption');
      /* The bold lead of the caption is the screen's name; without one, fall
         back to the window chrome's title, then to a number. */
      const label =
        cap?.querySelector('b')?.textContent?.trim() ||
        fig.querySelector('.k-win__title')?.textContent?.trim() ||
        `Screen ${i + 1}`;

      const panelId = `gal-${gi}-p${i}`;
      const tabId = `gal-${gi}-t${i}`;
      fig.id = panelId;
      fig.setAttribute('role', 'tabpanel');
      fig.setAttribute('aria-labelledby', tabId);

      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'k-gal__thumb';
      b.id = tabId;
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-controls', panelId);

      const shot = document.createElement('span');
      shot.className = 'k-gal__shot';
      if (img) {
        /* Same src as the stage, so the thumbnail costs no extra request. */
        const t = document.createElement('img');
        t.src = img.getAttribute('src') || '';
        t.alt = '';
        t.loading = 'lazy';
        t.decoding = 'async';
        shot.appendChild(t);
      }

      const lab = document.createElement('span');
      lab.className = 'k-gal__lab';
      lab.textContent = label.replace(/[\u2014\u2013-]\s*$/, '').trim();

      b.append(shot, lab);
      tabs.push(b);
      rail.appendChild(b);
    });

    function select(n: number, focus = false) {
      figs.forEach((f, i) => (f.hidden = i !== n));
      tabs.forEach((t, i) => {
        const on = i === n;
        t.setAttribute('aria-selected', String(on));
        // Roving tabindex: the strip is one stop, arrows move within it.
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1
          : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select((i + d + tabs.length) % tabs.length, true);
      });
    });

    gal.prepend(rail);
    gal.classList.add('is-ready');
    select(0);
  });

  /* ---- k-compare, live ----
     The lean itself is pure CSS (see global.css) — :has() on the hovered
     figure redistributes the grid columns. All this does is pin each image to
     the height it occupies at rest, which is what makes leaning on hover safe
     to do at all: the row height otherwise tracks the image height, so
     widening a panel would grow the row and push everything below it down the
     page every time the cursor crossed the gap.

     Enhancement only. On touch, a narrow window, or with no JS, none of this
     is switched on and the 2-up behaves as it always has. */
  const canLean = window.matchMedia('(min-width: 821px) and (hover: hover) and (pointer: fine)');

  document.querySelectorAll<HTMLElement>('.k-compare').forEach((cmp) => {
    const figs = Array.from(cmp.querySelectorAll<HTMLElement>(':scope > figure'));
    // Written for a pair: the 72/28 split in CSS assumes two tracks.
    if (figs.length !== 2) return;

    const GAP = 20; // .k-compare's gap, in px

    /* Ratio comes from the img's own width/height attributes rather than a
       measurement, so it is right before the lazy image has loaded. `inset`
       is everything in the column that is not the image — mount padding,
       window border, title bar — measured once at rest, where hovering cannot
       have distorted it. */
    const specs = figs.map((fig) => {
      const img = fig.querySelector<HTMLImageElement>('img');
      if (!img) return null;
      const w = Number(img.getAttribute('width'));
      const h = Number(img.getAttribute('height'));
      return {
        img,
        ar: w && h ? w / h : 0,
        inset: fig.getBoundingClientRect().width - img.getBoundingClientRect().width,
      };
    });
    if (specs.some((s) => !s || !s.ar)) return;

    /* Leaning costs about a third of the image's height off the bottom, since
       the height is pinned and `cover` takes the overflow. On a dashboard
       that spends the crop on lower table rows. On a wide process strip the
       entire diagram lives inside that band and the crop would cut it in
       half, so those keep the plain 50/50 — the lean is worth less there than
       the diagram is. Raise this to lean on everything. */
    const MAX_AR = 2.4;
    if (specs.some((s) => s!.ar > MAX_AR)) return;

    const pin = () => {
      const col = (cmp.getBoundingClientRect().width - GAP) / 2;
      specs.forEach((s) => {
        s!.img.style.height = `${Math.round((col - s!.inset) / s!.ar)}px`;
      });
    };
    const unpin = () => specs.forEach((s) => s!.img.style.removeProperty('height'));

    /* Below the breakpoint the pair has already wrapped to one column, where
       each screen is full width and there is nothing left to redistribute. */
    const sync = () => {
      if (canLean.matches) {
        cmp.classList.add('is-live');
        pin();
      } else {
        cmp.classList.remove('is-live');
        unpin();
      }
    };

    sync();
    canLean.addEventListener('change', sync);

    /* Re-pin on resize, but never mid-hover: the pin is measured from the
       container, which hovering does not move, yet re-running it while a
       panel is leaning would fight the transition. */
    let pinTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(pinTimer);
      pinTimer = window.setTimeout(() => {
        if (canLean.matches && !cmp.matches(':hover')) pin();
      }, 150);
    });
  });
</script>
