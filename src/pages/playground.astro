---
/* The playground.
 *
 * A holding page. Each piece sits in its own white container so it can be
 * judged at real size against the rest of the site; the page layout gets
 * decided once there are actual concepts to arrange.
 */
import Base from '../layouts/Base.astro';
import ReflectiveCard from '../components/ReflectiveCard.astro';
import ReflectiveButton from '../components/ReflectiveButton.astro';
---

<Base title="Playground — Bhupesh Parmar" description="Experiments, explorations and side work.">
  <section class="pgp">
    <div class="pgp__inner">
      <header class="pgp__head">
        <h1 class="pgp__title">Playground</h1>
        <p class="pgp__lead">
          Side projects, motion studies and interface experiments. Nothing here
          needs a case study.
        </p>
      </header>

      <p class="pgp__note">Two pieces, waiting for something to hold</p>

      <div class="pgp__stages">
        <figure class="pgp__stage">
          {/* The card is a surface, not a control, so the button is the wrapper
              rather than the card itself. */}
          <button class="pgp__open" type="button" data-open-card aria-haspopup="dialog">
            <ReflectiveCard index="01" title="Reflective card" meta="Metal · camera" id="rc-tile">
              <span class="pgp__ph">Click to open it</span>
            </ReflectiveCard>
          </button>
          <figcaption class="pgp__cap">
            Brushed steel at rest. Open it and the surface reflects whoever is
            in front of the screen.
          </figcaption>
        </figure>

        <figure class="pgp__stage">
          <div class="pgp__btnwrap">
            <ReflectiveButton id="rb-main" />
          </div>
          <figcaption class="pgp__cap">
            The same metal, and the switch. Clicking asks for the camera; every
            reflective surface on the page comes on together.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <dialog class="rcm" data-card-modal aria-label="Reflective card">
    <div class="rcm__inner">
      <div class="rcm__stage">
        {/* The size lives on a wrapper, not on the card. A scoped style here
            cannot reach another component's root element — it renders without
            this page's cid, so the rule matches nothing and fails silently. */}
        <div class="rcm__cardwrap">
          <ReflectiveCard
            index="01"
            title="Reflective card"
            meta="Metal · camera"
            id="rc-modal"
            aspect="0.82 / 1"
          >
            <span class="rcm__slot" data-modal-slot>Waiting for the camera</span>
          </ReflectiveCard>
        </div>
      </div>

      <div class="rcm__panel">
        <p class="rcm__kicker">Reflective card</p>
        <p class="rcm__blurb">
          A camera frame, blurred, rippled through a noise field and screened
          over brushed metal. Drag the sliders to change the surface.
        </p>

        <label class="rcm__ctl">
          <span>Ripple</span>
          <input type="range" min="0" max="40" value="14" data-ctl="ripple" />
        </label>

        <label class="rcm__ctl">
          <span>Softness</span>
          <input type="range" min="0" max="24" value="10" data-ctl="soft" />
        </label>

        <label class="rcm__ctl">
          <span>Reflection</span>
          <input type="range" min="0" max="100" value="62" data-ctl="mix" />
        </label>

        <label class="rcm__check">
          <input type="checkbox" checked data-ctl="mirror" />
          <span>Mirror it</span>
        </label>

        {/* Said plainly, because the honest version of this is short. */}
        <p class="rcm__privacy">
          The video stays in this tab. Nothing is recorded, saved or sent
          anywhere, and closing this turns the camera off.
        </p>

        <button class="rcm__close" type="button" data-close-modal>Close</button>
      </div>
    </div>
  </dialog>
</Base>

<script>
  import { attach, detach, onState, request } from '../lib/reflective';

  const dlg = document.querySelector<HTMLDialogElement>('[data-card-modal]');
  const open = document.querySelector<HTMLButtonElement>('[data-open-card]');

  if (dlg && open) {
    const card = dlg.querySelector<HTMLElement>('[data-rc]')!;
    const cam = card.querySelector<HTMLVideoElement>('[data-rc-cam]')!;
    const disp = card.querySelector<SVGElement>('[data-rc-disp]')!;
    const slot = dlg.querySelector<HTMLElement>('[data-modal-slot]')!;

    const ctl = (name: string) => dlg.querySelector<HTMLInputElement>(`[data-ctl="${name}"]`)!;

    open.addEventListener('click', () => {
      dlg.showModal();
      /* Attached before the ask, so frames land the moment permission is
         granted rather than a repaint later. */
      attach(cam);
      request();
    });

    const close = () => dlg.close();
    dlg.querySelector('[data-close-modal]')?.addEventListener('click', close);
    /* Click the backdrop to dismiss. The dialog itself fills the whole viewport,
       so the target is the dialog only when the click missed the inner panel. */
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    /* Covers Escape too — the browser fires close for that itself. */
    dlg.addEventListener('close', () => detach(cam));

    /* Filter primitives are not stylable, so ripple has to be an attribute
       write. The other two are custom properties. */
    ctl('ripple').addEventListener('input', (e) => {
      disp.setAttribute('scale', (e.target as HTMLInputElement).value);
    });
    ctl('soft').addEventListener('input', (e) => {
      card.style.setProperty('--rc-soft', `${(e.target as HTMLInputElement).value}px`);
    });
    ctl('mix').addEventListener('input', (e) => {
      card.style.setProperty('--rc-cam-opacity', String(+(e.target as HTMLInputElement).value / 100));
    });
    ctl('mirror').addEventListener('change', (e) => {
      card.dataset.mirror = (e.target as HTMLInputElement).checked ? '1' : '0';
    });

    const SLOT: Record<string, string> = {
      idle: 'Camera off',
      asking: 'Waiting for the camera',
      live: '',
      denied: 'Camera blocked. Allow it in the address bar, then reopen this.',
      unavailable: 'No camera available on this device.',
    };
    onState((s) => {
      slot.textContent = SLOT[s] ?? '';
      dlg.dataset.state = s;
    });
  }
</script>

<style>
  .pgp {
    background: #fff;
    padding: 132px 8% 140px;
  }
  .pgp__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .pgp__title {
    margin: 0;
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: 1px;
    color: #0b0d12;
  }
  .pgp__lead {
    max-width: 52ch;
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.62;
    color: #4a4f5c;
  }

  .pgp__note {
    margin: 52px 0 20px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: #9aa0ad;
  }

  .pgp__stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
    align-items: start;
  }

  /* The white container each piece sits in. Metal needs a ground to sit on or
     it reads as a hole in the page. */
  .pgp__stage {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 34px;
    border: 1px solid #ecedf1;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 2px 20px rgba(16, 20, 30, 0.05);
  }

  .pgp__open {
    display: block;
    width: 100%;
    max-width: 288px;
    margin: 0 auto;
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: none;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pgp__open:hover {
    transform: translateY(-4px);
  }
  .pgp__open:focus-visible {
    outline: 2px solid var(--blue-500);
    outline-offset: 6px;
  }

  .pgp__btnwrap {
    display: grid;
    place-items: center;
    min-height: 176px;
  }

  .pgp__ph {
    font-family: 'Inter', 'Nunito', system-ui, sans-serif;
    font-size: 13px;
    color: rgba(238, 242, 248, 0.78);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .pgp__cap {
    max-width: 40ch;
    font-size: 14px;
    line-height: 1.6;
    color: #6b7180;
  }

  /* ---------------------------------------------------------------- modal */

  .rcm {
    width: min(980px, 92vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 40px 120px rgba(8, 12, 24, 0.4);
  }
  .rcm::backdrop {
    background: rgba(10, 13, 20, 0.66);
    backdrop-filter: blur(3px);
  }

  .rcm__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 0;
  }
  .rcm__stage {
    display: grid;
    place-items: center;
    padding: 40px;
    background: #f6f7f9;
    border-radius: 24px 0 0 24px;
  }
  .rcm__cardwrap {
    width: 100%;
    max-width: 360px;
  }
  .rcm__slot {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
    color: rgba(238, 242, 248, 0.72);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .rcm__panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 40px 34px;
  }
  .rcm__kicker {
    margin: 0;
    font-family: 'Bebas Neue', 'Nunito', sans-serif;
    font-size: 28px;
    line-height: 1;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #0b0d12;
  }
  .rcm__blurb {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #6b7180;
  }

  .rcm__ctl {
    display: grid;
    gap: 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10.5px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    color: #9aa0ad;
  }
  .rcm__ctl input {
    width: 100%;
    accent-color: var(--blue-500, #2563eb);
  }

  .rcm__check {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    color: #4a4f5c;
  }
  .rcm__check input {
    accent-color: var(--blue-500, #2563eb);
  }

  .rcm__privacy {
    margin: 4px 0 0;
    font-size: 12px;
    line-height: 1.55;
    color: #8b909d;
  }

  .rcm__close {
    margin-top: auto;
    padding: 12px 20px;
    border: 1px solid #e2e4ea;
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    color: #0b0d12;
    cursor: pointer;
  }
  .rcm__close:hover {
    background: #f6f7f9;
  }

  @media (max-width: 820px) {
    .rcm__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .rcm__stage {
      border-radius: 24px 24px 0 0;
      padding: 26px;
    }
    .rcm__panel {
      padding: 26px;
    }
  }

  @media (max-width: 780px) {
    .pgp {
      padding: 104px 6% 100px;
    }
    .pgp__title {
      font-size: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pgp__open {
      transition: none;
    }
    .pgp__open:hover {
      transform: none;
    }
  }
</style>
