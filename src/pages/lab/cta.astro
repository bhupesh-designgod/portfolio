---
/* Two CTA candidates for the hero, side by side in the context they'd live in.
   Nothing here is wired to the site — the live hero still uses `.hero__cta`
   from global.css. Pick one and I'll move it across. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const count = (await getCollection('work', ({ data }) => !data.draft)).length;
---

<Base title="Lab — hero CTA" description="Two hero button candidates.">
  <main class="lab">
    <h1 class="lab__h1">Hero CTA &mdash; two candidates</h1>
    <p class="lab__sub">Same panel, same copy. Only the button changes.</p>

    <div class="lab__grid">
      <!-- ────────────────── 04 ────────────────── -->
      <section class="lab__col">
        <p class="lab__tag"><b>04</b> Micro-Glass</p>

        <div class="panel">
          <div class="panel__top">
            <div class="panel__avatar"><img src="/assets/avatar.webp" alt="" /></div>
            <p class="panel__title">
              HEY! I&rsquo;M<br /><span class="grad">BHUPESH PARMAR</span><br />
              <span class="muted">PRODUCT DESIGNER</span>
            </p>
          </div>
          <p class="panel__desc">
            Product designer with around 1 year of professional experience and two
            design degrees
          </p>

          <a class="glass" href="#work">
            <span class="glass__label">Explore Work</span>
            <span class="glass__arrow">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M12.5 6.5 19 12l-6.5 5.5" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </div>

        <p class="lab__note">
          A pale, barely-there pill carrying a large soft halo. The glow is the
          design; the pill is almost nothing. Reads light and expensive, and gives
          up some contrast to do it.
        </p>
      </section>

      <!-- ────────────────── 09 ────────────────── -->
      <section class="lab__col">
        <p class="lab__tag"><b>09</b> Hover Card</p>

        <div class="panel">
          <div class="panel__top">
            <div class="panel__avatar"><img src="/assets/avatar.webp" alt="" /></div>
            <p class="panel__title">
              HEY! I&rsquo;M<br /><span class="grad">BHUPESH PARMAR</span><br />
              <span class="muted">PRODUCT DESIGNER</span>
            </p>
          </div>
          <p class="panel__desc">
            Product designer with around 1 year of professional experience and two
            design degrees
          </p>

          <a class="hcard" href="#work">
            <span class="hcard__tile" aria-hidden="true">
              <svg viewBox="0 0 44 44">
                <defs>
                  <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#8fb0ff" /><stop offset="1" stop-color="#3f74f4" />
                  </linearGradient>
                  <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#5f8bfa" /><stop offset="1" stop-color="#1f4fd8" />
                  </linearGradient>
                </defs>
                <path d="M6 32 16 17l7 10 4-5 11 10z" fill="url(#g1)" />
                <path d="M17 32 27 18l11 14z" fill="url(#g2)" />
                <ellipse cx="22" cy="35" rx="16" ry="2.4" fill="#2b57d6" opacity=".16" />
              </svg>
            </span>
            <span class="hcard__txt">
              <b>View Projects</b>
              <span>{count} case studies</span>
            </span>
            <span class="hcard__arrow">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13M12.5 6.5 19 12l-6.5 5.5" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </div>

        <p class="lab__note">
          A row, not a pill. It says how much work there is before the click, which
          a label alone can't. Heavier, and it competes with the headline more.
        </p>
      </section>
    </div>

    <p class="lab__foot">Hover both &mdash; the difference is mostly in the motion.</p>
  </main>
</Base>

<script is:inline>document.documentElement.dataset.navTone = 'light';</script>

<style>
  .lab {
    min-height: 100vh;
    padding: 130px 5vw 80px;
    background: #eef1f8;
  }
  .lab__h1 {
    margin: 0 0 6px;
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: clamp(34px, 4vw, 54px);
    letter-spacing: 1px;
    color: #0b0d12;
  }
  .lab__sub { margin: 0 0 40px; font-size: 15px; color: #6b7280; }
  .lab__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 34px;
    max-width: 1180px;
  }
  .lab__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #3a4152;
  }
  .lab__tag b {
    display: grid;
    place-items: center;
    width: 30px;
    height: 24px;
    border-radius: 7px;
    background: #0059ff;
    font-size: 12px;
    color: #fff;
  }
  .lab__note {
    margin: 16px 2px 0;
    font-size: 14px;
    line-height: 1.6;
    color: #6b7280;
  }
  .lab__foot {
    margin: 46px 0 0;
    font-family: 'Caveat', cursive;
    font-size: 20px;
    color: #6b7280;
  }

  /* ---- the panel, standing in for the hero card ---- */
  .panel {
    padding: 34px 34px 38px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 24px 60px -34px rgba(12, 20, 45, 0.4);
  }
  .panel__top { display: flex; align-items: center; gap: 20px; margin-bottom: 20px; }
  .panel__avatar {
    flex: 0 0 auto;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    background: #2f6bff;
  }
  .panel__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .panel__title {
    margin: 0;
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: 30px;
    line-height: 1.02;
    color: #0b0d12;
  }
  .panel__title .grad { color: #1f5cff; }
  .panel__title .muted { color: #b6bcc7; }
  .panel__desc { margin: 0 0 26px; font-size: 16px; line-height: 1.45; color: #000; }

  /* ═══════════ 04 · Micro-Glass ═══════════
     The pill is almost nothing: a pale translucent fill and a bright rim. The
     work is done by the halo behind it — a big, soft, blue bloom that makes
     the button look lit rather than filled. `backdrop-filter` is included for
     the case where this ever sits over the blue gradient instead of the white
     panel; over white it costs a layer and shows nothing. */
  .glass {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 13px 13px 13px 32px;
    border-radius: 999px;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(226, 232, 255, 0.86));
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 0 0 1px rgba(96, 128, 255, 0.16),
      0 10px 26px -12px rgba(47, 88, 235, 0.45);
    transition:
      transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1),
      box-shadow 0.32s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  /* The halo. A blurred copy of the pill's footprint sitting behind it. */
  .glass::before {
    content: '';
    position: absolute;
    inset: -18px -14px -22px;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(
      60% 120% at 50% 55%,
      rgba(86, 122, 255, 0.55) 0%,
      rgba(120, 96, 255, 0.28) 45%,
      rgba(120, 96, 255, 0) 78%
    );
    filter: blur(14px);
    transition: opacity 0.32s ease, transform 0.32s ease;
    pointer-events: none;
  }
  .glass__label {
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: #16204a;
  }
  .glass__arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(180deg, #4f7dff, #1f4fd8);
    color: #fff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.45) inset,
      0 6px 14px -6px rgba(31, 79, 216, 0.8);
    transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  .glass__arrow svg { width: 19px; height: 19px; }
  .glass:hover { transform: translateY(-2px); }
  .glass:hover::before { opacity: 1; transform: scale(1.08); }
  .glass:hover .glass__arrow { transform: translateX(4px); }
  .glass:active { transform: translateY(0); }
  .glass:focus-visible { outline: 2px solid #1f4fd8; outline-offset: 4px; }

  /* ═══════════ 09 · Hover Card ═══════════
     A row rather than a pill. The count is the point: it tells you the size of
     what you are clicking into before you click it, which no label can. */
  .hcard {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    min-width: 320px;
    padding: 12px 18px 12px 12px;
    border-radius: 15px;
    border: 1px solid #e4e7f1;
    background: #fff;
    text-decoration: none;
    box-shadow: 0 2px 4px rgba(12, 20, 45, 0.04);
    transition:
      transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1),
      box-shadow 0.32s cubic-bezier(0.2, 0.9, 0.25, 1),
      border-color 0.32s ease;
  }
  .hcard__tile {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(160deg, #f2f5ff, #dfe7ff);
    transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  .hcard__tile svg { width: 36px; height: 36px; }
  .hcard__txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .hcard__txt b {
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: #0b0d12;
  }
  .hcard__txt span { font-size: 13.5px; color: #7a8194; }
  .hcard__arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: #1f4fd8;
    transition: transform 0.32s cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  .hcard__arrow svg { width: 21px; height: 21px; }
  .hcard:hover {
    transform: translateY(-3px);
    border-color: #b9c9ff;
    box-shadow: 0 18px 34px -18px rgba(31, 79, 216, 0.5);
  }
  .hcard:hover .hcard__tile { transform: scale(1.06) rotate(-4deg); }
  .hcard:hover .hcard__arrow { transform: translateX(5px); }
  .hcard:active { transform: translateY(-1px); }
  .hcard:focus-visible { outline: 2px solid #1f4fd8; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .glass, .glass::before, .glass__arrow,
    .hcard, .hcard__tile, .hcard__arrow { transition: none; }
  }
</style>
