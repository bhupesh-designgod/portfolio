# The chat assistant's model provider. Not committed — set locally in .env and
# in the Vercel project's environment variables.
#
# The provider is not yet decided; /src/pages/api/chat.ts currently targets the
# Anthropic SDK and reads this name. Swapping providers changes only the client
# call inside that file — the guards, streaming shape, and the whole front end
# stay as they are.
ANTHROPIC_API_KEY=
